v2ray_delete_by_proto() {
  FILTER_PROTO="$1"
  touch "$XRAY_DB"
  while true; do
    clear
    ui_head "DELETE ${FILTER_PROTO^^} USER"

    VACCS=()
    IDX=1
    NOW_S=$(date +%s)

    while IFS= read -r line; do
      [ -z "$line" ] && break
      vuser=$(echo "$line" | awk '{print $1}')
      vuuid=$(echo "$line" | awk '{print $2}')
      NCOLS=$(echo "$line" | awk '{print NF}')
      if [ "$NCOLS" -ge 5 ]; then
        vexpiry=$(echo "$line" | awk '{print $3" "$4}')
        vproto=$(echo "$line" | awk '{print $5}')
      else
        vexpiry=$(echo "$line" | awk '{print $3}')
        vproto=$(echo "$line" | awk '{print $4}')
      fi
      if [ "$vproto" == "$FILTER_PROTO" ]; then
        EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null || echo 0)
        SECS_LEFT=$(( EXP_S - NOW_S ))
        if [ "$SECS_LEFT" -le 0 ]; then
          TIME_LEFT="${R}EXPIRED${N}"
        else
          D=$(( SECS_LEFT/86400 ))
          H=$(( (SECS_LEFT%86400)/3600 ))
          M=$(( (SECS_LEFT%3600)/60 ))
          TIME_LEFT="${G}${D}d ${H}h ${M}m${N}"
        fi
        if [ "$FILTER_PROTO" == "trojan" ]; then
          DISPLAY_NAME="$vuuid"
        else
          DISPLAY_NAME="$vuser"
        fi
        VP_NAME=$(get_account_package "$FILTER_PROTO" "$vuuid")
        ui_row "  ${Y}[$IDX]${N} ${W}$DISPLAY_NAME${N}  ${Y}|${N} $TIME_LEFT"
        VACCS+=("$vuser:$vuuid:$vexpiry:$vproto")
        IDX=$((IDX + 1))
      fi
    done < "$XRAY_DB"

    if [ ${#VACCS[@]} -eq 0 ]; then
      ui_row "  ${Y}No ${FILTER_PROTO^^} accounts found.${N}"
      ui_bot
      press_enter; return
    fi

    ui_mid
    ui_item e "Remove all expired ${FILTER_PROTO^^} users"
    ui_item A "Remove all ${FILTER_PROTO^^} users (force)"
    ui_back "Back"
    ui_bot
    read -r -p "$(ui_ask 'Select option')" DOPT
    [ -z "$DOPT" ] && break

    if [ "$DOPT" == "0" ]; then
      break
    elif [ "$DOPT" == "e" ]; then
      COUNT=0
      NOW_S=$(date +%s)
      TMP=$(mktemp)
      while IFS= read -r line; do
        [ -z "$line" ] && break
        vuser=$(echo "$line" | awk '{print $1}')
        vuuid=$(echo "$line" | awk '{print $2}')
        NCOLS=$(echo "$line" | awk '{print NF}')
        if [ "$NCOLS" -ge 5 ]; then
          vexpiry=$(echo "$line" | awk '{print $3" "$4}')
          vproto=$(echo "$line" | awk '{print $5}')
        else
          vexpiry=$(echo "$line" | awk '{print $3}')
          vproto=$(echo "$line" | awk '{print $4}')
        fi
        EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null || echo 0)
        if [ "$vproto" == "$FILTER_PROTO" ] && [ "$EXP_S" -le "$NOW_S" ]; then
          remove_account_package "$FILTER_PROTO" "$vuuid"
          COUNT=$((COUNT + 1))
        else
          echo "$line" >> "$TMP"
        fi
      done < "$XRAY_DB"
      mv "$TMP" "$XRAY_DB"
      systemctl restart xray > /dev/null 2>&1
      ui_msg "Removed $COUNT expired ${FILTER_PROTO^^} users!"
      sleep 2
    elif [ "$DOPT" == "A" ]; then
      TMP=$(mktemp)
      grep -v " ${FILTER_PROTO}$" "$XRAY_DB" > "$TMP" 2>/dev/null || true
      mv "$TMP" "$XRAY_DB"
      sed -i "/^${FILTER_PROTO}|/d" "$ACCOUNT_PKG_DB" 2>/dev/null || true
      python3 - << PYEOF
import json
path = "$XRAY_CONF"
try:
    with open(path) as f:
        cfg = json.load(f)
    for inb in cfg.get("inbounds", []):
        if "$FILTER_PROTO" == "xhttp" and inb.get("streamSettings", {}).get("network") == "xhttp":
            inb["settings"]["clients"] = []
        elif inb.get("protocol") == "$FILTER_PROTO":
            inb["settings"]["clients"] = []
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
except Exception:
    pass
PYEOF
      systemctl restart xray > /dev/null 2>&1
      ui_msg "All ${FILTER_PROTO^^} users removed!"
      sleep 2
    elif [[ "$DOPT" =~ ^[0-9]+$ ]] && [ "$DOPT" -ge 1 ] && [ "$DOPT" -lt "$IDX" ]; then
      TARGET="${VACCS[$((DOPT - 1))]}"
      DEL_USER=$(echo "$TARGET" | cut -d: -f1)
      DEL_UUID=$(echo "$TARGET" | cut -d: -f2)
      DEL_PROTO=$(echo "$TARGET" | cut -d: -f4)

      sed -i "/^${DEL_USER} /d" "$XRAY_DB"
      remove_account_package "$DEL_PROTO" "$DEL_UUID"

      python3 - << PYEOF
import json
path = "$XRAY_CONF"
proto = "$DEL_PROTO"
uuid_val = "$DEL_UUID"
try:
    with open(path) as f:
        cfg = json.load(f)
    for inb in cfg.get("inbounds", []):
        if proto == "xhttp" and inb.get("streamSettings", {}).get("network") == "xhttp":
            clients = inb["settings"].get("clients", [])
            inb["settings"]["clients"] = [c for c in clients if c.get("id") != uuid_val]
        elif inb.get("protocol") == proto:
            clients = inb["settings"].get("clients", [])
            if proto in ["vless", "vmess"]:
                inb["settings"]["clients"] = [c for c in clients if c.get("id") != uuid_val]
            else:
                inb["settings"]["clients"] = [c for c in clients if c.get("password") != uuid_val]
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
except Exception:
    pass
PYEOF
      systemctl restart xray > /dev/null 2>&1
      ui_msg "User '$DEL_USER' deleted!"
      sleep 2
    else
      echo -e "\n${R} [!] Invalid option!${N}"
      sleep 1
    fi
  done
}

v2ray_check_user() {
  while true; do
    clear
    ui_head "CHECK XRAY USERS & QR"
    ui_item 1 "VLESS"
    ui_item 2 "VMess"
    ui_item 3 "Trojan"
    ui_item 4 "XHTTP"
    ui_back "Back"
    ui_bot
    read -r -p "$(ui_ask 'Select option')" PROTO_CHK
    [ -z "$PROTO_CHK" ] && break
    case $PROTO_CHK in
      1) v2ray_check_by_proto "vless"  ;;
      2) v2ray_check_by_proto "vmess"  ;;
      3) v2ray_check_by_proto "trojan" ;;
      4) v2ray_check_by_proto "xhttp"  ;;
      0) break ;;
      *) echo -e "${R} Invalid option!${N}"; sleep 1 ;;
    esac
  done
}

v2ray_check_by_proto() {
  FILTER_PROTO="$1"
  sync_host_config
  touch "$XRAY_DB"
  clear
  ui_top
  ui_center "${Y}◆${N} ${W}${FILTER_PROTO^^} USERS${N} ${Y}◆${N}"
  ui_bot
  echo ""

  FOUND=0
  TODAY_S=$(date +%s)
  ACTIVE_HOST="${HOST}"

  while IFS= read -r line; do
    [ -z "$line" ] && break
    vuser=$(echo "$line" | awk '{print $1}')
    vuuid=$(echo "$line" | awk '{print $2}')
    NCOLS=$(echo "$line" | awk '{print NF}')
    if [ "$NCOLS" -ge 5 ]; then
      vexpiry=$(echo "$line" | awk '{print $3" "$4}')
      vproto=$(echo "$line" | awk '{print $5}')
    else
      vexpiry=$(echo "$line" | awk '{print $3}')
      vproto=$(echo "$line" | awk '{print $4}')
    fi

    if [ "$vproto" == "$FILTER_PROTO" ]; then
      FOUND=1
      ui_top
      EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null || echo 0)
      SECS_LEFT=$(( EXP_S - TODAY_S ))
      if [ "$SECS_LEFT" -le 0 ]; then
        TIME_LEFT="EXPIRED"
      else
        D=$(( SECS_LEFT/86400 ))
        H=$(( (SECS_LEFT%86400)/3600 ))
        M=$(( (SECS_LEFT%3600)/60 ))
        S=$(( SECS_LEFT%60 ))
        TIME_LEFT="${D}d ${H}h ${M}m ${S}s"
      fi

      if [ "$FILTER_PROTO" == "trojan" ]; then
        LINK_TLS="trojan://${vuuid}@${ACTIVE_HOST}:443?type=ws&security=tls&host=${ACTIVE_HOST}&path=/trojan&sni=${ACTIVE_HOST}#${vuuid}"
        LINK_NTLS="trojan://${vuuid}@${ACTIVE_HOST}:80?type=ws&host=${ACTIVE_HOST}&path=/trojan#${vuuid}"
        ui_row "  Password   : ${G}$vuuid${N}"
      elif [ "$FILTER_PROTO" == "xhttp" ]; then
        LINK_TLS="vless://${vuuid}@${ACTIVE_HOST}:443?encryption=none&type=xhttp&security=tls&host=${ACTIVE_HOST}&path=/xhttp&sni=${ACTIVE_HOST}&mode=auto#${vuser}"
        LINK_NTLS="vless://${vuuid}@${ACTIVE_HOST}:80?encryption=none&type=xhttp&host=${ACTIVE_HOST}&path=/xhttp&mode=auto#${vuser}"
        ui_row "  Username    : ${G}$vuser${N}"
      elif [ "$FILTER_PROTO" == "vless" ]; then
        LINK_TLS="vless://${vuuid}@${ACTIVE_HOST}:443?encryption=none&type=ws&security=tls&host=${ACTIVE_HOST}&path=/vless&sni=${ACTIVE_HOST}#${vuser}"
        LINK_NTLS="vless://${vuuid}@${ACTIVE_HOST}:80?encryption=none&type=ws&host=${ACTIVE_HOST}&path=/vless#${vuser}"
        ui_row "  Username    : ${G}$vuser${N}"
      else
        VMESS_TLS="{\"v\":\"2\",\"ps\":\"${vuser}\",\"add\":\"${ACTIVE_HOST}\",\"port\":\"443\",\"id\":\"${vuuid}\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"${ACTIVE_HOST}\",\"path\":\"/vmess\",\"tls\":\"tls\",\"sni\":\"${ACTIVE_HOST}\"}"
        VMESS_NTLS="{\"v\":\"2\",\"ps\":\"${vuser}\",\"add\":\"${ACTIVE_HOST}\",\"port\":\"80\",\"id\":\"${vuuid}\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"${ACTIVE_HOST}\",\"path\":\"/vmess\",\"tls\":\"\"}"
        LINK_TLS="vmess://$(echo -n "$VMESS_TLS" | base64 -w 0)"
        LINK_NTLS="vmess://$(echo -n "$VMESS_NTLS" | base64 -w 0)"
        ui_row "  Username    : ${G}$vuser${N}"
      fi

      ui_row "  Expiration  : ${G}$TIME_LEFT${N}"
      ui_mid
      ui_section "TLS (443)"
      ui_bot
      echo -e " ${G}${LINK_TLS}${N}"
      print_qr_link "TLS (443)" "$LINK_TLS"
      echo ""
      ui_top
      ui_section "NON-TLS (80)"
      ui_bot
      echo -e " ${G}${LINK_NTLS}${N}"
      print_qr_link "Non-TLS (80)" "$LINK_NTLS"
      echo ""
    fi
  done < "$XRAY_DB"

  if [ "$FOUND" -eq 0 ]; then
    ui_top
    ui_row "  ${Y}No ${FILTER_PROTO^^} accounts found.${N}"
    ui_bot
  fi

  press_enter
}

