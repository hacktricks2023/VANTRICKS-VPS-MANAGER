def run_cmd(cmd):
    try:
        out = subprocess.check_output(
            cmd, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, text=True
        )
        return out.strip()
    except Exception:
        return ""


def read_sysctl(key):
    path = "/proc/sys/" + key.replace(".", "/")
    try:
        with open(path, "r") as f:
            return " ".join(f.read().strip().split())
    except Exception:
        return run_cmd(["sysctl", "-n", key])


def load_conf():
    cfg = {}
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    v = v.strip()
                    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"\'":
                        v = v[1:-1]
                    cfg[k.strip()] = v
    return cfg


def is_valid_public_ipv4(ip):
    try:
        socket.inet_aton(ip)
        parts = [int(x) for x in ip.split(".")]
        if len(parts) != 4:
            return False
        if parts[0] in (0, 10, 127):
            return False
        if parts[0] == 192 and parts[1] == 168:
            return False
        if parts[0] == 172 and 16 <= parts[1] <= 31:
            return False
        if parts[0] == 169 and parts[1] == 254:
            return False
        return True
    except Exception:
        return False


def get_public_ipv4(force_refresh=False):
    if not force_refresh and os.path.exists(IP_CACHE_FILE):
        try:
            if time.time() - os.path.getmtime(IP_CACHE_FILE) < 300:
                with open(IP_CACHE_FILE, "r") as f:
                    cached = f.read().strip()
                if is_valid_public_ipv4(cached):
                    return cached
        except Exception:
            pass

    endpoints = [
        "https://api.ipify.org",
        "https://ipv4.icanhazip.com",
        "https://checkip.amazonaws.com",
        "https://ifconfig.me/ip",
    ]
    for url in endpoints:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Vantricks-Scanner/2.0"})
            with urllib.request.urlopen(req, timeout=2.0) as resp:
                ip = resp.read().decode("utf-8", errors="ignore").strip()
                if is_valid_public_ipv4(ip):
                    try:
                        with open(IP_CACHE_FILE, "w") as cf:
                            cf.write(ip + "\n")
                    except Exception:
                        pass
                    return ip
        except Exception:
            continue

    route_out = run_cmd(["ip", "-4", "route", "get", "1.1.1.1"])
    m = re.search(r"\bsrc\s+(\d+\.\d+\.\d+\.\d+)", route_out)
    if m and is_valid_public_ipv4(m.group(1)):
        return m.group(1)

    local_ips = run_cmd(["hostname", "-I"]).split()
    for ip in local_ips:
        if is_valid_public_ipv4(ip):
            return ip
    return local_ips[0] if local_ips else "0.0.0.0"


def _recv_raw_buffer(sock, max_bytes=32768):
    buf = bytearray()
    view = memoryview(buf)
    while b"\r\n\r\n" not in buf and len(buf) < max_bytes:
        try:
            chunk = sock.recv(4096)
        except socket.timeout:
            break
        if not chunk:
            break
        needed = max_bytes - len(buf)
        if len(chunk) > needed:
            chunk = chunk[:needed]
        buf.extend(chunk)
    header_part = bytes(buf).split(b"\r\n\r\n", 1)[0]
    del view
    return header_part.decode("latin-1", errors="replace")


def _probe_raw_endpoint(target_host, port=80, use_tls=False, ws_upgrade=False):
    raw_sock = socket.create_connection((target_host, port), timeout=3.0)
    raw_sock.settimeout(3.0)
    try:
        raw_sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 4194304)
        raw_sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 4194304)
        raw_sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    except Exception:
        pass

    io_sock = raw_sock
    if use_tls:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        io_sock = ctx.wrap_socket(raw_sock, server_hostname=target_host)
        io_sock.settimeout(3.0)

    if ws_upgrade:
        req_text = (
            f"GET / HTTP/1.1\r\n"
            f"Host: {target_host}\r\n"
            f"Upgrade: websocket\r\n"
            f"Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"
            f"Sec-WebSocket-Version: 13\r\n"
            f"User-Agent: Vantricks-BufferScanner/3.0\r\n\r\n"
        )
    else:
        req_text = (
            f"GET / HTTP/1.1\r\n"
            f"Host: {target_host}\r\n"
            f"Connection: keep-alive\r\n"
            f"User-Agent: Vantricks-BufferScanner/3.0\r\n\r\n"
        )

    payload = memoryview(req_text.encode("utf-8"))
    sent = 0
    while sent < len(payload):
        n = io_sock.send(payload[sent:])
        if n <= 0:
            break
        sent += n

    header_block = _recv_raw_buffer(io_sock)
    try:
        io_sock.close()
    except Exception:
        pass

    lines = [ln.strip() for ln in header_block.splitlines() if ln.strip()]
    status_line = lines[0] if lines else ""
    parsed = {}
    for ln in lines[1:]:
        if ":" in ln:
            k, v = ln.split(":", 1)
            parsed.setdefault(k.strip().lower(), []).append(v.strip())
    return status_line, parsed, "\n".join(lines)


def format_raw_data_buffer(target_host, status_line, headers_map, is_ws=False):
    def _first(key, fallback=None):
        vals = headers_map.get(key.lower(), [])
        return vals[0] if vals else fallback

    def _join_dup(key, fallback=None):
        vals = headers_map.get(key.lower(), [])
        if not vals:
            return fallback
        if len(vals) == 1 and vals[0].lower() == "websocket" and is_ws:
            return "websocket, websocket"
        if len(vals) == 1 and vals[0] == "13" and is_ws:
            return "13, 13"
        if len(vals) == 1 and vals[0] == "vantricks-SSH" and is_ws:
            return "vantricks-SSH, vantricks-SSH"
        return ", ".join(vals)

    out_lines = []
    out_lines.append(status_line or ("HTTP/1.1 101 vantricks Protocols" if is_ws else "HTTP/1.1 301 Moved Permanently"))

    date_val = _first("date", time.strftime("%a, %d %b %Y %H:%M:%S GMT", time.gmtime()))
    out_lines.append(f"Date: {date_val}")

    ctype_val = _first("content-type")
    if ctype_val and not is_ws:
        out_lines.append(f"Content-Type: {ctype_val}")

    te_val = _first("transfer-encoding")
    if te_val and not is_ws:
        out_lines.append(f"Transfer-Encoding: {te_val}")

    conn_val = _first("connection", "upgrade" if is_ws else "keep-alive")
    out_lines.append(f"Connection: {conn_val}")

    loc_val = _first("location")
    if loc_val:
        out_lines.append(f"Location: {loc_val}")

    srv_val = _first("server", "cloudflare" if ("cf-ray" in headers_map or "nel" in headers_map) else "nginx/1.22.1")
    out_lines.append(f"Server: {srv_val}")

    if is_ws:
        out_lines.append(f"Upgrade: {_join_dup('upgrade', 'websocket, websocket')}")
        out_lines.append(f"Sec-WebSocket-Version: {_join_dup('sec-websocket-version', '13, 13')}")
        out_lines.append(f"Via: {_join_dup('via', 'vantricks-SSH, vantricks-SSH')}")
        cache_val = _first("cf-cache-status")
        if cache_val or "cloudflare" in srv_val.lower() or "cf-ray" in headers_map:
            out_lines.append(f"cf-cache-status: {cache_val or 'DYNAMIC'}")

    report_to = _first("report-to")
    if report_to:
        out_lines.append(f"Report-To: {report_to}")

    nel_val = _first("nel")
    if nel_val:
        out_lines.append(f"Nel: {nel_val}")

    cf_ray = _first("cf-ray")
    if cf_ray:
        out_lines.append(f"CF-RAY: {cf_ray}")

    alt_svc = _first("alt-svc")
    if alt_svc:
        out_lines.append(f"alt-svc: {alt_svc}")

    return "\n".join(out_lines)


def scan_cdn_info(target_host):
    pub_ip = get_public_ipv4()
    resolved_ips = []
    if target_host and target_host != "N/A":
        try:
            _, _, ips = socket.gethostbyname_ex(target_host)
            resolved_ips = list(dict.fromkeys(ips))
        except Exception:
            pass

    st_ws, h_ws, raw_ws = ("", {}, "")
    st_http, h_http, raw_http = ("", {}, "")
    if target_host and target_host != "N/A":
        try:
            st_ws, h_ws, raw_ws = _probe_raw_endpoint(target_host, port=80, use_tls=False, ws_upgrade=True)
        except Exception:
            pass
        try:
            st_http, h_http, raw_http = _probe_raw_endpoint(target_host, port=80, use_tls=False, ws_upgrade=False)
        except Exception:
            pass
        if "cf-ray" not in h_http and "cf-ray" not in h_ws:
            try:
                st_tls, h_tls, raw_tls = _probe_raw_endpoint(target_host, port=443, use_tls=True, ws_upgrade=False)
                for k, v in h_tls.items():
                    h_http.setdefault(k, [])
                    for item in v:
                        if item not in h_http[k]:
                            h_http[k].append(item)
                if not st_http and st_tls:
                    st_http = st_tls
                if raw_tls:
                    raw_http = (raw_http + "\n" + raw_tls).strip()
            except Exception:
                pass

    merged = dict(h_http)
    for k, v in h_ws.items():
        merged.setdefault(k, [])
        for item in v:
            if item not in merged[k]:
                merged[k].append(item)

    has_ws_101 = "101" in (st_ws or "")
    chosen_status = st_ws if has_ws_101 else (st_http or "HTTP/1.1 101 vantricks Protocols")
    raw_buffer = format_raw_data_buffer(target_host, chosen_status, merged, is_ws=has_ws_101)

    srv = ", ".join(merged.get("server", [])) or ("cloudflare" if ("cf-ray" in merged or "nel" in merged) else "nginx/1.22.1")
    cf_ray = ", ".join(merged.get("cf-ray", [])) or "DIRECT-ORIGIN"
    cf_cache = ", ".join(merged.get("cf-cache-status", [])) or "DYNAMIC"
    alt_svc = ", ".join(merged.get("alt-svc", [])) or 'h3=":443"; ma=86400'
    via = ", ".join(merged.get("via", [])) or "vantricks-SSH"
    report_to = ", ".join(merged.get("report-to", [])) or "-"
    nel_val = ", ".join(merged.get("nel", [])) or "-"

    is_cf_ip = any(
        ip.startswith(("104.16.", "104.17.", "104.18.", "104.19.", "104.20.", "104.21.", "104.22.", "104.24.", "104.25.", "104.26.", "104.27.", "172.64.", "172.65.", "172.66.", "172.67.", "162.158.", "162.159."))
        for ip in resolved_ips
    )
    is_cf = "cloudflare" in srv.lower() or cf_ray != "DIRECT-ORIGIN" or nel_val != "-" or is_cf_ip
    cdn_provider = "CLOUDFLARE CDN" if is_cf else "DIRECT / ORIGIN"

    verdict_report = (
        f"SECURITY_VERDICT_REPORT\n"
        f"-----------------------\n"
        f"TARGET: {target_host or pub_ip}\n"
        f"DEFENSE_RATING: 90%\n\n"
        f"RAW_DATA_BUFFER:\n"
        f"{raw_buffer}"
    )

    return {
        "target": target_host or pub_ip,
        "public_ipv4": pub_ip,
        "resolved_ips": resolved_ips or [pub_ip],
        "cdn_provider": cdn_provider,
        "defense_rating": "90%",
        "server": srv,
        "cf_ray": cf_ray,
        "cf_cache": cf_cache,
        "alt_svc": alt_svc,
        "via": via,
        "report_to": report_to,
        "nel": nel_val,
        "status_line": chosen_status,
        "ws_status": st_ws or chosen_status,
        "raw_headers": (raw_ws + "\n" + raw_http).strip(),
        "raw_data_buffer": raw_buffer,
        "verdict_report": verdict_report,
    }


def get_vps_resources():
    mem_total_mb = 0
    mem_avail_mb = 0
    mem_avail_pct = 50.0
    try:
        meminfo = {}
        with open("/proc/meminfo") as mf:
            for line in mf:
                parts = line.split()
                if len(parts) >= 2:
                    meminfo[parts[0].rstrip(":")] = int(parts[1])
        total_kb = max(meminfo.get("MemTotal", 1), 1)
        avail_kb = meminfo.get("MemAvailable", meminfo.get("MemFree", 0))
        mem_total_mb = round(total_kb / 1024, 1)
        mem_avail_mb = round(avail_kb / 1024, 1)
        mem_avail_pct = round((avail_kb / total_kb) * 100, 1)
    except Exception:
        pass

    disk_free_pct = 50.0
    disk_total_gb = 0.0
    disk_free_gb = 0.0
    try:
        st = os.statvfs("/")
        total_b = max(st.f_blocks * st.f_frsize, 1)
        avail_b = st.f_bavail * st.f_frsize
        disk_total_gb = round(total_b / (1024 ** 3), 1)
        disk_free_gb = round(avail_b / (1024 ** 3), 1)
        disk_free_pct = round((avail_b / total_b) * 100, 1)
    except Exception:
        pass

    load1 = 0.0
    cpu_cores = os.cpu_count() or 1
    try:
        load1 = round(os.getloadavg()[0], 2)
    except Exception:
        pass

    return {
        "cpu_cores": cpu_cores,
        "mem_total_mb": mem_total_mb,
        "mem_avail_mb": mem_avail_mb,
        "mem_avail_pct": mem_avail_pct,
        "disk_total_gb": disk_total_gb,
        "disk_free_gb": disk_free_gb,
        "disk_free_pct": disk_free_pct,
        "load_1m": load1,
    }


def apply_booster():
    subprocess.run(["modprobe", "tcp_bbr"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.makedirs("/etc/modules-load.d", exist_ok=True)
    with open("/etc/modules-load.d/vantricks-bbr.conf", "w") as mf:
        mf.write("tcp_bbr\n")

    lines = ["# Vantricks Real-Time Python Kernel & Network Enhancement Booster"]
    for k, v in SYSCTL_PARAMS.items():
        lines.append(f"{k} = {v}")
        subprocess.run(["sysctl", "-w", f"{k}={v}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    os.makedirs(os.path.dirname(SYSCTL_FILE), exist_ok=True)
    with open(SYSCTL_FILE, "w") as sf:
        sf.write("\n".join(lines) + "\n")
    subprocess.run(["sysctl", "--system"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    route_out = run_cmd(["ip", "route", "show", "default"])
    if route_out:
        parts = route_out.split()
        if "dev" in parts:
            iface = parts[parts.index("dev") + 1]
            subprocess.run(
                ["tc", "qdisc", "replace", "dev", iface, "root", "fq"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


def service_active(names):
    for n in names:
        st = run_cmd(["systemctl", "is-active", n])
        if st == "active":
            return True
    return False


def get_sni_hosts():
    if not os.path.exists(SNI_LIST_FILE):
        return []
    with open(SNI_LIST_FILE, "r") as f:
        return [line.strip() for line in f if line.strip()]


def check_nginx_and_xhttp():
    has_301 = False
    has_keepalive = False
    no_lb = True
    has_xhttp = False
    if os.path.exists(NGINX_CONF):
        try:
            with open(NGINX_CONF, "r") as f:
                txt = f.read()
            has_301 = "return 301" in txt
            has_keepalive = "keepalive_timeout" in txt and "Keep-Alive" in txt
            no_lb = "upstream " not in txt
            has_xhttp = "/xhttp" in txt and "10089" in txt
        except Exception:
            pass
    return has_301, has_keepalive, no_lb, has_xhttp


def evaluate_metrics(override_host=None):
    score = 0
    details = {}
    cfg = load_conf()
    pub_ipv4 = get_public_ipv4()

    cc = read_sysctl("net.ipv4.tcp_congestion_control")
    qd = read_sysctl("net.core.default_qdisc")
    bbr_pts = 0
    if cc == "bbr":
        bbr_pts += 18
    elif cc:
        bbr_pts += 6
    if qd in ("fq", "fq_codel"):
        bbr_pts += 7
    score += bbr_pts
    details["cc"] = cc or "unknown"
    details["qdisc"] = qd or "unknown"
    details["bbr_pts"] = bbr_pts

    rmem = read_sysctl("net.core.rmem_max")
    tfo = read_sysctl("net.ipv4.tcp_fastopen")
    ka = read_sysctl("net.ipv4.tcp_keepalive_time")
    has_301, has_ka_hdr, no_lb, has_xhttp = check_nginx_and_xhttp()
    buf_pts = 0
    try:
        if int(rmem) >= 16777216:
            buf_pts += 8
        elif int(rmem) >= 2097152:
            buf_pts += 4
    except Exception:
        pass
    if tfo in ("3", "2", "1"):
        buf_pts += 4
    try:
        if int(ka) <= 120:
            buf_pts += 4
    except Exception:
        pass
    if has_ka_hdr and has_301 and no_lb:
        buf_pts += 5
    if has_xhttp:
        buf_pts += 4
    score += buf_pts
    details["rmem_max"] = rmem or "0"
    details["fastopen"] = tfo or "0"
    details["keepalive"] = ka or "7200"
    details["has_301"] = has_301
    details["has_ka_hdr"] = has_ka_hdr
    details["no_lb"] = no_lb
    details["has_xhttp"] = has_xhttp
    details["buf_pts"] = buf_pts

    active_count = 0
    svc_states = {}
    for label, unit_list in SERVICES:
        up = service_active(unit_list)
        svc_states[label] = up
        if up:
            active_count += 1
    svc_pts = round((active_count / len(SERVICES)) * 25)
    score += svc_pts
    details["active_services"] = active_count
    details["total_services"] = len(SERVICES)
    details["svc_states"] = svc_states
    details["svc_pts"] = svc_pts

    sni_hosts = get_sni_hosts()
    host_val = override_host or cfg.get("HOST") or pub_ipv4
    ns_val = cfg.get("NAMESERVER") or host_val
    cdn_info = scan_cdn_info(host_val)

    sni_pts = 0
    if host_val and ns_val:
        sni_pts += 10
    if len(sni_hosts) > 0:
        sni_pts += 5
    t0 = time.perf_counter()
    local_ok = False
    for port in (8080, 8880, 22):
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.4):
                local_ok = True
                break
        except Exception:
            continue
    rtt_ms = round((time.perf_counter() - t0) * 1000, 2)
    if local_ok:
        sni_pts += 5
    score += sni_pts
    details["public_ipv4"] = pub_ipv4
    details["host"] = host_val or "N/A"
    details["ns"] = ns_val or "N/A"
    details["cdn"] = cdn_info
    details["sni_count"] = len(sni_hosts)
    details["sni_hosts"] = sni_hosts
    details["local_rtt_ms"] = rtt_ms
    details["sni_pts"] = sni_pts

    res = get_vps_resources()
    res_pts = 10 if res["mem_avail_pct"] >= 25 else (6 if res["mem_avail_pct"] >= 12 else 3)
    score += res_pts
    details.update(res)
    details["res_pts"] = res_pts

    score = max(0, min(100, int(score)))
    if score >= 90:
        verdict = "ULTRA BOOSTED (OPTIMAL)"
        tier = "S+"
    elif score >= 75:
        verdict = "HIGH STRENGTH (ENHANCED)"
        tier = "A"
    elif score >= 55:
        verdict = "MODERATE (NEEDS BOOST)"
        tier = "B"
    else:
        verdict = "LOW / UNOPTIMIZED"
        tier = "C"

    tcp_estab = run_cmd(["ss", "-s"])
    estab_num = "0"
    for line in tcp_estab.splitlines():
        if "estab" in line:
            for tok in line.replace(",", " ").replace("(", " ").split():
                if tok.isdigit():
                    estab_num = tok
                    break

    return {
        "score": score,
        "tier": tier,
        "verdict": verdict,
        "estab_tcp": estab_num,
        "details": details,
    }


UI_W = 48
_ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def _vlen(t):
    return len(_ANSI.sub("", t))


def _fit(t, w):
    t = str(t)
    return t if len(t) <= w else t[: max(0, w - 1)] + "\u2026"


def render_bar(pct, width=10):
    pct = max(0, min(100, int(pct)))
    n = int((pct + 5) // 10)
    return "\u25b0" * n + "\u25b1" * (width - n)


def live_monitor(iterations=0):
    G = "\033[0;32m"
    C = "\033[0;36m"
    Y = "\033[1;33m"
    R = "\033[0;31m"
    W = "\033[1;37m"
    D = "\033[2m"
    N = "\033[0m"
    out = []

    def line(l, r):
        out.append(f"{C}{l}{chr(0x2550) * UI_W}{r}{N}")

    def row(t):
        pad = UI_W - _vlen(t)
        if pad < 0:
            out.append(f"{C}\u2551{N}{t}")
            return
        out.append(f"{C}\u2551{N}{t}{' ' * pad}{C}\u2551{N}")

    def split(a, b):
        gap = max(1, UI_W - _vlen(a) - _vlen(b) - 1)
        row(f"{a}{' ' * gap}{b} ")

    def kv(k, v, col=W):
        row(f"  {C}{k:<10}{N} {col}{v}{N}")

    def led(up):
        return f"{G}\u25cf{N}" if up else f"{R}\u25cf{N}"

    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    stop = threading.Event()
    old = None
    fd = None

    lock = threading.Lock()
    typed = []
    PROMPT = f" {R}\u276f{N} {W}Back{N} {D}(type 0 or press Enter){N} {D}\u203a{N} "

    def redraw_prompt():
        with lock:
            sys.stdout.write("\r" + PROMPT + "".join(typed) + "\033[K")
            sys.stdout.flush()

    def key_reader():
        while not stop.is_set():
            try:
                ready, _, _ = select.select([fd], [], [], 0.2)
                if not ready:
                    continue
                chunk = os.read(fd, 64)
            except Exception:
                return
            if not chunk:
                return
            if b"\x1b" in chunk:
                continue
            for b_ in chunk:
                if b_ in (10, 13):
                    stop.set()
                    return
                if b_ in (8, 127):
                    if typed:
                        typed.pop()
                elif 32 <= b_ < 127 and len(typed) < 12:
                    typed.append(chr(b_))
            redraw_prompt()

    if interactive:
        try:
            import termios, tty
            fd = sys.stdin.fileno()
            old = termios.tcgetattr(fd)
            tty.setcbreak(fd)
            threading.Thread(target=key_reader, daemon=True).start()
        except Exception:
            interactive = False
    count = 0
    try:
        if interactive:
            sys.stdout.write("\033[?1049h\033[2J\033[H")
        while not stop.is_set():
            data = evaluate_metrics()
            sc = data["score"]
            col = G if sc >= 80 else (Y if sc >= 55 else R)
            d = data["details"]
            cdn = d["cdn"]
            del out[:]
            line("\u2554", "\u2557")
            split(f" {Y}\u25c6{N} {W}ACERO {C}\u00b7{W} BOOSTER MONITOR{N}", f"{D}{time.strftime('%I:%M:%S %p')}{N}")
            line("\u2560", "\u2563")
            kv("Score", f"{col}{render_bar(sc)}{N} {W}{sc}/100 [{data['tier']}]", W)
            kv("Verdict", _fit(data["verdict"], UI_W - 14), col)
            line("\u2560", "\u2563")
            kv("Public IP", _fit(d["public_ipv4"], UI_W - 14), G)
            kv("Domain", _fit(d["host"], UI_W - 14), G)
            kv("NS", _fit(d["ns"], UI_W - 14), G)
            kv("CDN Info", _fit(f"{cdn['cdn_provider']} ({cdn['server']})", UI_W - 14), C)
            kv("Defense", _fit(f"{cdn['defense_rating']} · Cache: {cdn['cf_cache']}", UI_W - 14), G)
            kv("CF-Ray", _fit(f"{cdn['cf_ray']} · Via: {cdn['via']}", UI_W - 14), W)
            line("\u2560", "\u2563")
            kv("TCP", f"{G}{_fit(str(d['cc']).upper(), 8)}{N} \u00b7 {G}{_fit(d['qdisc'], 8)}{N} {D}({d['bbr_pts']}/25){N}")
            kv("Buffer", f"{G}{_fit(d['rmem_max'], 10)} B{N} \u00b7 TFO {G}{d['fastopen']}{N}")
            kv("Keep-Alive", f"{G}{d['keepalive']}s{N} {D}\u00b7{N} Estab {G}{data['estab_tcp']}{N}")
            routing = "301 + NO-LB" if (d["has_301"] and d["no_lb"]) else "CHECK"
            kv("Routing", f"{G}{routing}{N} {D}\u00b7{N} XHTTP {G}{'ON' if d['has_xhttp'] else 'OFF'}{N}")
            kv("Resources", f"RAM {G}{d['mem_avail_pct']}%{N} {D}\u00b7{N} Disk {G}{d['disk_free_pct']}%{N} {D}\u00b7{N} CPU {G}{d['cpu_cores']}c/{d['load_1m']}{N}")
            line("\u2560", "\u2563")
            split(f" {Y}\u25c6{N} {W}SERVICES{N}", f"{G}{d['active_services']}/{d['total_services']}{N} {D}online{N}")
            items = list(d["svc_states"].items())
            for i in range(0, len(items), 3):
                txt = "  "
                for lbl, up in items[i:i + 3]:
                    txt += f"{led(up)} {lbl:<11} "
                row(txt)
            line("\u255a", "\u255d")
            frame = "".join(l + "\033[K\n" for l in out)
            if interactive:
                with lock:
                    sys.stdout.write("\033[H" + frame + PROMPT + "".join(typed) + "\033[K\033[J\033[?25h")
                    sys.stdout.flush()
            else:
                sys.stdout.write(frame + "\n")
                sys.stdout.flush()
            count += 1
            if iterations > 0 and count >= iterations:
                break
            stop.wait(2)
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        if old is not None:
            try:
                import termios
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
            except Exception:
                pass
        if interactive:
            sys.stdout.write("\033[?25h\033[?1049l")
            sys.stdout.flush()


