          continue
        fi
        [ -z "$NEW_NS" ] && NEW_NS="$NEW_HOST"

        echo ""
        ui_top
        ui_center "${Y}◆${N} ${W}CONFIRM DOMAIN & NS${N} ${Y}◆${N}"
        ui_mid
        ui_row "  New Domain : ${G}${NEW_HOST}${N}"
