v2ray_delete_user() {
  while true; do
    clear
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${W}           Delete Xray User                    ${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e " ${W}[1]${N} VLESS"
    echo -e " ${W}[2]${N} VMess"
    echo -e " ${W}[3]${N} Trojan"
    echo -e " ${W}[4]${N} XHTTP"
    echo -e " ${W}[0]${N} Return"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    read -p " Option: " PROTO_DEL
    case $PROTO_DEL in
      1) v2ray_delete_by_proto "vless"  ;;
      2) v2ray_delete_by_proto "vmess"  ;;
      3) v2ray_delete_by_proto "trojan" ;;
      4) v2ray_delete_by_proto "xhttp"  ;;
      0) break ;;
      *) echo -e "${R} Invalid option!${N}"; sleep 1 ;;
