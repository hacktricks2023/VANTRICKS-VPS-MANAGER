      fi
    done < /etc/passwd

    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${C}║${N}  ${W}[0]${N} Back to Menu                         ${C}║${N}"
    echo -e "${C}╚══════════════════════════════════════════════╝${N}"
