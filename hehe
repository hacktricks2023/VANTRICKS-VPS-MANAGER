
#!/bin/bash
# ==================================================================
# All-In-One VPS Multi-Protocol Setup & Manager Script
# OS Support: Debian, Ubuntu, CentOS, AlmaLinux, Rocky, Fedora
# Protocols: DNSTT + WA + SSH + XHTTP + VMess + VLess + Trojan + OVPN
# ==================================================================

# Directory & Base Setup
cd /root
mkdir -p /etc/xray /etc/v2ray /var/lib/
touch /etc/xray/domain /etc/v2ray/domain /etc/xray/scdomain /etc/v2ray/scdomain /root/scdomain /root/domain
touch /var/log/vps_expired.log

# Colors
R='\033[0;31m'
G='\033[1;32m'
Y='\033[1;33m'
C='\033[1;36m'
W='\033[1;37m'
BRed='\e[1;31m'
BGreen='\e[1;32m'
BYellow='\e[1;33m'
BBlue='\e[1;34m'
NC='\033[0m'

CONFIG_FILE="/etc/vps_script.conf"
START_TIME=$(date +%s)

# ══════════════════════════════════════════════
# PRE-FLIGHT & OS COMPATIBILITY CHECKS
# ══════════════════════════════════════════════

if [ "${EUID}" -ne 0 ]; then
  echo -e "${R}Error: You must run this script as root.${NC}"
  exit 1
fi

if [ "$(systemd-detect-virt 2>/dev/null)" == "openvz" ]; then
  echo -e "${R}OpenVZ is not supported. VPS with KVM/VMWare virtualization ONLY.${NC}"
  exit 1
fi

detect_os() {
  if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS_FAMILY=$ID
    OS_LIKE=${ID_LIKE:-$ID}
  else
    echo -e "${R}[ERROR] Unable to detect Operating System.${NC}"
    exit 1
  fi

  if command -v apt-get &>/dev/null; then
    PKG_TYPE="apt"
  elif command -v dnf &>/dev/null; then
    PKG_TYPE="dnf"
  elif command -v yum &>/dev/null; then
    PKG_TYPE="yum"
  else
    echo -e "${R}[ERROR] Unsupported package manager! Only APT and YUM/DNF are supported.${NC}"
    exit 1
  fi
}
detect_os

pkg_install() {
  if [ "$PKG_TYPE" = "apt" ]; then
    DEBIAN_FRONTEND=noninteractive apt-get update -y >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" >/dev/null 2>&1
  else
    $PKG_TYPE update -y >/dev/null 2>&1
    $PKG_TYPE install -y "$@" >/dev/null 2>&1
  fi
}

# Local IP & Hostname Setup
localip=$(hostname -I | awk '{print $1}')
hst=$(hostname)
dart=$(grep -w "$hst" /etc/hosts 2>/dev/null | awk '{print $2}')
if [[ "$hst" != "$dart" ]]; then
  echo "$localip $(hostname)" >> /etc/hosts
fi

# Timezone Setup
ln -fs /usr/share/zoneinfo/Asia/Jakarta /etc/localtime 2>/dev/null || timedatectl set-timezone Asia/Jakarta >/dev/null 2>&1

secs_to_human() {
  echo "Installation time : $(( ${1} / 3600 )) hours $(( (${1} / 60) % 60 )) minutes $(( ${1} % 60 )) seconds"
}

press_enter() {
  echo ""
  read -p " Press Enter to continue... "
}

post_creation_menu() {
  echo -e ""
  echo -e " [1] Back to Main Menu"
  echo -e " [0] Exit"
  read -p " Choose : " pc_ch
  case $pc_ch in
    1) main_menu ;;
    0) exit 0 ;;
    *) main_menu ;;
  esac
}

load_config() {
  if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
  else
    first_run_setup
  fi
}

get_info() {
  OS=$(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')
  RAM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
  RAM_USED=$(free -m | awk '/Mem:/ {print $3}')
  RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')
  RAM_PERCENT=$(awk "BEGIN {printf \"%.2f\", ($RAM_USED/$RAM_TOTAL)*100}")
  DATETIME=$(TZ="Asia/Jakarta" date "+%m-%d-%Y %I:%M:%S %p")
  SSH_ONLINE=$(ss -tnp 2>/dev/null | grep -c "sshd") || SSH_ONLINE=0
  SSH_ACCOUNTS=$(awk -F: '$3>=1000 && $1!="nobody"' /etc/passwd | wc -l | tr -d '[:space:]')
  V2RAY_ACCOUNTS=0
  if [ -f /etc/xray/accounts.db ]; then
    V2RAY_ACCOUNTS=$(grep -c '[^[:space:]]' /etc/xray/accounts.db 2>/dev/null | tr -d '[:space:]')
  fi
  TOTAL_ACCOUNTS=$(( ${SSH_ACCOUNTS} + ${V2RAY_ACCOUNTS} ))
  CPU_LOAD=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1 || echo "0")
  SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
}

auto_remove_expired() {
  local NOW_S=$(date +%s)
  local LOG_FILE="/var/log/vps_expired.log"
  
  # Check SSH Expirations (Lock account instead of deleting)
  while IFS=: read -r user _ uid _ _ _ _; do
    if [ "$uid" -ge 1000 ] && [ "$user" != "nobody" ]; then
      EXP=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
      if [ "$EXP" != "never" ] && [ -n "$EXP" ] && [ "$EXP" != "password must be changed" ]; then
        EXP_S=$(date -d "$EXP" +%s 2>/dev/null)
        if [ -n "$EXP_S" ] && [ "$EXP_S" -lt "$NOW_S" ]; then
          # Lock user and log reminder
          usermod -L "$user" > /dev/null 2>&1
          if ! grep -q "SSH User $user expired" "$LOG_FILE" 2>/dev/null; then
            echo "$(date): SSH User $user expired. Contact vantricks to renew your account." >> "$LOG_FILE"
          fi
        fi
      fi
    fi
  done < /etc/passwd

  # Check Xray Expirations (Remove from active config, keep in DB for records)
  if [ -f /etc/xray/accounts.db ]; then
    python3 -c "
import json, time, datetime
with open('/usr/local/etc/xray/config.json', 'r') as f: data = json.load(f)
valid_users = []
try:
    with open('/etc/xray/accounts.db', 'r') as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) >= 3:
                user, exp = parts[1], parts[2]
                try:
                    exp_s = int(datetime.datetime.strptime(exp, '%Y-%m-%d').timestamp())
                    if exp_s > time.time():
                        valid_users.append(user)
                    else:
                        with open('/var/log/vps_expired.log', 'a') as log:
                            log.write(f'{datetime.datetime.now()}: Xray User {user} expired. Contact vantricks to renew your account.\n')
                except: pass
except: pass
for ib in data['inbounds']:
    if 'settings' in ib and 'clients' in ib['settings']:
        ib['settings']['clients'] = [c for c in ib['settings']['clients'] if c.get('email') in valid_users]
with open('/usr/local/etc/xray/config.json', 'w') as f: json.dump(data, f, indent=2)
"
    systemctl restart xray > /dev/null 2>&1
  fi
}

# ══════════════════════════════════════════════
# DOMAIN & INITIAL SETUP
# ══════════════════════════════════════════════

first_run_setup() {
  clear
  echo -e "$BBlue SETUP DOMAIN VPS $NC"
  echo -e "$BYellow----------------------------------------------------------$NC"
  echo -e "$BGreen 1. Use Domain Random / Gunakan Domain Random $NC"
  echo -e "$BGreen 2. Choose Your Own Domain / Gunakan Domain Sendiri $NC"
  echo -e "$BYellow----------------------------------------------------------$NC"
  read -rp " Input 1 or 2 : " dns
  if [ "$dns" -eq 1 ]; then
    curl -sL https://autoscript.caliphdev.com/ssh/cf.sh | bash
    INPUT_HOST=$(cat /etc/xray/domain 2>/dev/null)
  elif [ "$dns" -eq 2 ]; then
    read -rp " Enter Your Domain : " dom
    INPUT_HOST="$dom"
    echo "IP=$dom" > /var/lib/ipvps.conf
    echo "$dom" > /root/scdomain
    echo "$dom" > /etc/xray/scdomain
    echo "$dom" > /etc/xray/domain
    echo "$dom" > /etc/v2ray/domain
    echo "$dom" > /root/domain
  else 
    echo "Invalid Selection"
    exit 1
  fi

  read -p " Enter NS Domain for DNSTT (e.g. ns.domain.com): " INPUT_NS
  [ -z "$INPUT_NS" ] && INPUT_NS="ns.${INPUT_HOST}"

  INPUT_PUBKEY=$(head /dev/urandom | tr -dc 'a-f0-9' | head -c 64)
  
  echo "HOST=$INPUT_HOST" > "$CONFIG_FILE"
  echo "NAMESERVER=$INPUT_NS" >> "$CONFIG_FILE"
  echo "PUBKEY=$INPUT_PUBKEY" >> "$CONFIG_FILE"
  source "$CONFIG_FILE"
  
  install_all
}

