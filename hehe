create_user() {
  source "$CONFIG_FILE"
  clear
  DATETIME=$(TZ="Asia/Manila" date "+%m-%d-%Y %I:%M:%S %p")
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}           ${W}CREATE SSH ACCOUNT${N}               ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Time : ${G}$DATETIME${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  read -p "  Enter username: " NEW_USER
  read -p "  Enter password: " NEW_PASS
  read -p "  Expiration (days): " EXP_DAYS
  read -p "  Online Limit: " MAX_SESSION

  if [ -z "$NEW_USER" ] || [ -z "$NEW_PASS" ] || [ -z "$EXP_DAYS" ]; then
    echo -e " ${R}[!] All fields are required!${N}"
    sleep 2; return
  fi

  if id "$NEW_USER" &>/dev/null; then
    echo -e " ${R}[!] User '$NEW_USER' already exists!${N}"
    sleep 2; return
  fi

  MAX_SESSION=${MAX_SESSION:-2}
  EXP_DATE_DISPLAY=$(TZ="Asia/Manila" date -d "+${EXP_DAYS} days" "+%m-%d-%Y %I:%M:%S %p")
  EXP_DATE_SYSTEM=$(date -d "+${EXP_DAYS} days" "+%Y-%m-%d")

  useradd -m -s /bin/bash "$NEW_USER" > /dev/null 2>&1
  echo "${NEW_USER}:${NEW_PASS}" | chpasswd > /dev/null 2>&1
  chage -E "$EXP_DATE_SYSTEM" "$NEW_USER" > /dev/null 2>&1

  if ! grep -q "Match User $NEW_USER" /etc/ssh/sshd_config; then
    echo "" >> /etc/ssh/sshd_config
    echo "Match User $NEW_USER" >> /etc/ssh/sshd_config
    echo "    MaxSessions $MAX_SESSION" >> /etc/ssh/sshd_config
  fi
  systemctl restart ssh > /dev/null 2>&1

  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}         ${G}✔ ACCOUNT CREATED!${N}                 ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Username        : ${G}$NEW_USER${N}"
  echo -e "${C}║${N}  Password        : ${G}$NEW_PASS${N}"
  echo -e "${C}║${N}  Expiration      : ${G}${EXP_DAYS} Day/s${N}"
  echo -e "${C}║${N}  Online Limit    : ${G}$MAX_SESSION${N}"
  echo -e "${C}║${N}  Expire Date     : ${G}$EXP_DATE_DISPLAY${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Host            : ${G}$HOST${N}"
  echo -e "${C}║${N}  Nameserver      : ${G}$NAMESERVER${N}"
  echo -e "${C}║${N}  Public Key      : ${G}${DNSTT_PUBKEY}${N}"
  echo -e "${C}╚══════════════════════════════════════════════╝${N}"
  press_enter
}

# ══════════════════════════════════════════════
#   REMOVE USER
# ══════════════════════════════════════════════

remove_user() {
  while true; do
    clear
    echo -e "${C}╔══════════════════════════════════════════════╗${N}"
    echo -e "${C}║${N}          ${W}DELETE SSH ACCOUNT${N}                ${C}║${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"

    USERS=()
    INDEX=1
    while IFS=: read -r user _ uid _ _ _ _; do
      if [ "$uid" -ge 1000 ] && [ "$user" != "nobody" ]; then
        EXP=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
        EXP_S=$(date -d "$EXP" +%s 2>/dev/null || echo 0)
        NOW_S=$(date +%s)
        # Only show active (non-expired) accounts
        if [ "$EXP" == "never" ] || [ "$EXP_S" -gt "$NOW_S" ] 2>/dev/null; then
          SESS=$(ps aux | grep -c "sshd: $user@" 2>/dev/null || echo 0)
          echo -e "${C}║${N}  ${W}[$INDEX]${N} $user  ${Y}|${N} Exp: ${G}$EXP${N}  ${Y}|${N} Online: ${G}$SESS${N}"
          USERS+=("$user")
          INDEX=$((INDEX + 1))
        fi
      fi
    done < /etc/passwd

    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${C}║${N}  ${W}[e]${N} Delete All Expired Accounts          ${C}║${N}"
    echo -e "${C}║${N}  ${W}[A]${N} Delete All Accounts (Force)          ${C}║${N}"
    echo -e "${C}║${N}  ${W}[0]${N} Back to Menu                         ${C}║${N}"
    echo -e "${C}╚══════════════════════════════════════════════╝${N}"
    read -p " Option >>> " DEL_OPT

    if [ "$DEL_OPT" == "0" ]; then
      break

    elif [ "$DEL_OPT" == "e" ]; then
      COUNT=0
      for u in "${USERS[@]}"; do
        EXP=$(chage -l "$u" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
        if [ "$EXP" == "never" ] || [[ $(date -d "$EXP" +%s 2>/dev/null) -lt $(date +%s) ]]; then
          sed -i "/Match User $u/,/MaxSessions/d" /etc/ssh/sshd_config
          userdel -r "$u" > /dev/null 2>&1
          COUNT=$((COUNT + 1))
        fi
      done
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] Deleted $COUNT expired/no-expiration users!${N}"
      sleep 2

    elif [ "$DEL_OPT" == "A" ]; then
      for u in "${USERS[@]}"; do
        sed -i "/Match User $u/,/MaxSessions/d" /etc/ssh/sshd_config
        userdel -r "$u" > /dev/null 2>&1
      done
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] All users deleted!${N}"
      sleep 2

    elif [[ "$DEL_OPT" =~ ^[0-9]+$ ]] && [ "$DEL_OPT" -ge 1 ] && [ "$DEL_OPT" -lt "$INDEX" ]; then
      TARGET="${USERS[$((DEL_OPT - 1))]}"
      sed -i "/Match User $TARGET/,/MaxSessions/d" /etc/ssh/sshd_config
      userdel -r "$TARGET" > /dev/null 2>&1
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] User '$TARGET' deleted!${N}"
      sleep 2

    else
      echo -e "\n${R} [!] Invalid option!${N}"
      sleep 1
    fi
  done
}

