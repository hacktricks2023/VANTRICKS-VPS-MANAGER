install_dnstt() {
  echo -e " ${Y}[*] Installing DNSTT...${N}"

  # Install latest Go
  GO_VER="1.22.5"
  wget -q "https://go.dev/dl/go${GO_VER}.linux-amd64.tar.gz" -O /tmp/go.tar.gz 2>/dev/null
  rm -rf /usr/local/go
  tar -C /usr/local -xzf /tmp/go.tar.gz > /dev/null 2>&1
  export PATH=$PATH:/usr/local/go/bin

  # Download and build dnstt
  apt-get install -y unzip > /dev/null 2>&1
  wget -q "https://www.bamsoftware.com/software/dnstt/dnstt-20220208.zip" -O /tmp/dnstt.zip 2>/dev/null
  cd /tmp && unzip -o dnstt.zip > /dev/null 2>&1
  cd /tmp/dnstt-20220208/dnstt-server
  /usr/local/go/bin/go build . > /dev/null 2>&1
  cp dnstt-server /usr/local/bin/dnstt-server
  chmod +x /usr/local/bin/dnstt-server

  # Generate keypair
  /usr/local/bin/dnstt-server -gen-key -privkey-file /etc/dnstt-priv.key -pubkey-file /etc/dnstt-pub.key > /dev/null 2>&1

  # Save pubkey to config
  DNSTT_PUBKEY=$(cat /etc/dnstt-pub.key 2>/dev/null | tr -d '\n' || echo "N/A")
  sed -i '/^DNSTT_PUBKEY/d' "$CONFIG_FILE"
  echo "DNSTT_PUBKEY=$DNSTT_PUBKEY" >> "$CONFIG_FILE"

  # Create startup script — DNSTT on port 53 (Routed to SSLH port 80 for WS/SSL/V2Ray/SSH multiplexing)
  cat > /usr/local/bin/dnstt-start.sh << EOF
#!/bin/bash
exec /usr/local/bin/dnstt-server -udp :53 -privkey-file /etc/dnstt-priv.key ${NAMESERVER} 127.0.0.1:80
EOF
  chmod +x /usr/local/bin/dnstt-start.sh

  # Create systemd service
  cat > /etc/systemd/system/dnstt.service << 'EOF'
[Unit]
Description=DNSTT DNS Tunnel Server
After=network.target

[Service]
ExecStart=/usr/local/bin/dnstt-start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

  # Free port 53 from systemd-resolved
  systemctl stop systemd-resolved > /dev/null 2>&1
  systemctl disable systemd-resolved > /dev/null 2>&1

  # Make DNS persistent across reboots
  rm -f /etc/resolv.conf
  echo "nameserver 8.8.8.8" > /etc/resolv.conf
  echo "nameserver 8.8.4.4" >> /etc/resolv.conf
  # Lock the file so systemd-resolved can't overwrite it
  chattr +i /etc/resolv.conf 2>/dev/null || true

  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable dnstt > /dev/null 2>&1
  systemctl start dnstt > /dev/null 2>&1

  # Check if started
  sleep 2
  if systemctl is-active --quiet dnstt; then
    echo -e " ${G}[✓] DNSTT running on port 53${N}"
  else
    echo -e " ${Y}[!] DNSTT installed but may need DNS record setup${N}"
  fi
}

