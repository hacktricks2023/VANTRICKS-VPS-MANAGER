# ══════════════════════════════════════════════
#   WEBSOCKET PROXY INSTALL (PYTHON 3 + KEEP-ALIVE + 301)
# ══════════════════════════════════════════════

write_ws_proxy() {
  cat > /usr/local/bin/ws-proxy.py << 'PYEOF'
#!/usr/bin/env python3
# Vantricks WS proxy v2 - tolerant payload handling
#  * decoy requests in front of the websocket upgrade (NetMod / HTTP Injector payloads) are swallowed silently
#  * only the real "Upgrade: websocket" request gets the 101 reply, so the app's FIRST reply is always 101
#  * a lone plain HTTP request (browser/probe) still gets the 301 + keep-alive
import os
import re
import socket
import threading
import select
import sys
import time

LISTEN_PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
SSH_HOST = '127.0.0.1'
SSH_PORT = int(os.environ.get('WS_SSH_PORT', '22'))
NGINX_PORT = int(os.environ.get('WS_NGINX_PORT', '8880'))
BUFFER = 65535
TIMEOUT = 120
GRACE = float(os.environ.get('WS_GRACE', '1.5'))
CONFIG_FILE = os.environ.get('WS_CONFIG', '/etc/vantricks_script.conf')
MAX_HEAD = 32768

V2RAY_PATHS = (b'/vmess', b'/vless', b'/trojan', b'/xhttp')
HTTP_START = (b'GET ', b'POST', b'HEAD', b'CONN', b'PUT ', b'OPTI', b'X / ', b'DELE', b'PATC', b'TRAC')
HEAD_END = re.compile(rb'\r?\n\r?\n')

RESPONSE_COLOR = (
    b"HTTP/1.1 101 vantricks Protocols\r\n"
    b"Upgrade: websocket\r\n"
    b"Connection: keep-alive, Upgrade\r\n"
    b"Keep-Alive: timeout=86400, max=100000\r\n"
    b"Sec-WebSocket-Version: 13\r\n"
    b"Via: vantricks-SSH\r\n"
    b"\r\n"
)

def log(msg):
    try:
        print("[ws-proxy %s] %s" % (time.strftime('%H:%M:%S'), msg), flush=True)
    except Exception:
        pass

def get_default_domain():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, 'r') as f:
                for line in f:
                    if line.startswith('HOST='):
                        val = line.split('=', 1)[1].strip().strip('"').strip("'")
                        if val:
                            return val
        except Exception:
            pass
    return 'vantricks.local'

def build_301_response(raw_req):
    target_host = get_default_domain()
    path = '/'
    lines = raw_req.replace(b'\r\n', b'\n').split(b'\n')
    if lines and b' ' in lines[0]:
        parts = lines[0].split(b' ')
        if len(parts) >= 2:
            path = parts[1].decode('utf-8', errors='ignore') or '/'
    for ln in lines[1:]:
        if ln.lower().startswith(b'host:'):
            h = ln.split(b':', 1)[1].strip().decode('utf-8', errors='ignore')
            if h:
                target_host = h
            break
    location = "https://%s%s" % (target_host, path)
    resp = (
        "HTTP/1.1 301 Moved Permanently\r\n"
        "Location: %s\r\n"
        "Connection: keep-alive\r\n"
        "Keep-Alive: timeout=86400, max=100000\r\n"
        "Content-Length: 0\r\n"
        "Via: vantricks-301\r\n"
        "\r\n" % location
    )
    return resp.encode('utf-8')

def enable_keepalive(sock):
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        if hasattr(socket, 'TCP_KEEPIDLE'):
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, 60)
        if hasattr(socket, 'TCP_KEEPINTVL'):
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, 15)
        if hasattr(socket, 'TCP_KEEPCNT'):
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, 4)
    except Exception:
        pass

def forward(src, dst, label=None):
    enable_keepalive(src)
    enable_keepalive(dst)
    seen = False
    try:
        while True:
            r, _, _ = select.select([src], [], [], TIMEOUT)
            if r:
                d = src.recv(BUFFER)
                if not d:
                    if label:
                        log("%s closed" % label)
                    break
                if label and not seen:
                    seen = True
                    log("%s first data: %r" % (label, d[:40]))
                dst.sendall(d)
    except Exception:
        pass
    finally:
        for sock in (src, dst):
            try:
                sock.close()
            except Exception:
                pass

def tunnel(client, port, first=b'', greeting=b''):
    target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    enable_keepalive(target)
    target.connect((SSH_HOST, port))
    log("tunnel open -> port %d%s" % (port, " (101 sent)" if greeting else ""))
    if greeting:
        client.sendall(greeting)
    if first:
        target.sendall(first)
    threading.Thread(target=forward, args=(client, target, "client->port%d" % port), daemon=True).start()
    threading.Thread(target=forward, args=(target, client, "port%d->client" % port), daemon=True).start()

def recv_more(client, wait):
    """returns bytes, b'' on close, None on timeout"""
    r, _, _ = select.select([client], [], [], wait)
    if not r:
        return None
    return client.recv(BUFFER)

def looks_http(buf):
    return buf[:4] in HTTP_START or b'host:' in buf.lower()

def handle(client):
    enable_keepalive(client)
    try:
        buf = b''
        first_round = True
        while True:
            # wait for data (long wait when idle)
            if not buf.strip(b'\r\n \t\x00'):
                d = recv_more(client, TIMEOUT)
                if not d:
                    client.close()
                    return
                buf += d
            lead = buf.lstrip(b'\r\n \t\x00')
            if first_round:
                log("new connection, first bytes: %r" % lead[:60])
            if first_round and not looks_http(lead):
                # not HTTP at all (plain SSH, DNSTT forwarder...): straight to SSH like before
                tunnel(client, SSH_PORT, first=buf)
                return
            if not looks_http(lead) and lead[:4] == b'SSH-':
                tunnel(client, SSH_PORT, first=lead)
                return
            first_round = False
            buf = lead
            m = HEAD_END.search(buf)
            while not m and len(buf) < MAX_HEAD:
                d = recv_more(client, 5)
                if not d:
                    break
                buf += d
                m = HEAD_END.search(buf)
            if m:
                block, rest = buf[:m.end()], buf[m.end():]
            else:
                block, rest = buf, b''
            low = block.lower()
            first_line = block.split(b'\n', 1)[0]
            is_v2ray = any(p in first_line for p in V2RAY_PATHS)
            is_ws = b'upgrade: websocket' in low

            if is_v2ray:
                tunnel(client, NGINX_PORT, first=block + rest)
                return
            if is_ws:
                tunnel(client, SSH_PORT, first=rest, greeting=RESPONSE_COLOR)
                return

            # plain / decoy request: stay silent if more data follows, 301 only when it was alone
            log("plain/decoy request: %r" % first_line[:60])
            buf = rest
            if not buf.strip(b'\r\n \t\x00'):
                d = recv_more(client, GRACE)
                if d is None:
                    log("nothing followed -> 301")
                    client.sendall(build_301_response(block))
                    buf = b''
                elif d == b'':
                    client.close()
                    return
                else:
                    buf = d
    except Exception as e:
        log("handler error: %r" % (e,))
        try:
            client.close()
        except Exception:
            pass

def start(port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    enable_keepalive(srv)
    srv.bind(('0.0.0.0', port))
    srv.listen(512)
    while True:
        try:
            c, _ = srv.accept()
            enable_keepalive(c)
            threading.Thread(target=handle, args=(c,), daemon=True).start()
        except Exception:
            pass

if __name__ == '__main__':
    start(LISTEN_PORT)
PYEOF
  chmod +x /usr/local/bin/ws-proxy.py
}

# sslh must hand plain HTTP (port 80) to the tolerant python proxy (8080), not to nginx which rejects payload decoys
patch_sslh_http_target() {
  [ -f /etc/sslh/sslh.cfg ] && sed -i '/name: "http"/ s/port: "8880"/port: "8080"/' /etc/sslh/sslh.cfg
  [ -f /etc/systemd/system/sslh.service ] && sed -i 's#--http 127.0.0.1:8880#--http 127.0.0.1:8080#' /etc/systemd/system/sslh.service
  systemctl daemon-reload > /dev/null 2>&1
}

# live test of the exact path NetMod / HTTP Injector use: port 80 -> decoy requests + websocket upgrade -> must get 101 then SSH banner
ws_selftest() {
  command -v python3 > /dev/null 2>&1 || return 2
  python3 - "${1:-80}" << 'PYT'
import socket, sys, time
port = int(sys.argv[1])
req = (b"GET / HTTP/1.1\r\nHost: test.local\r\n\r\n\r\n\r\n"
       b"X / HTTP/1.2\r\nHost: test.local\r\n\n\r\n"
       b"GET / HTTP/1.1\r\nHost: test.local\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
got = b''
try:
    s = socket.create_connection(('127.0.0.1', port), timeout=6)
    s.sendall(req)
    end = time.time() + 8
    while time.time() < end and b'SSH-' not in got:
        s.settimeout(max(0.5, end - time.time()))
        d = s.recv(4096)
        if not d:
            break
        got += d
except Exception:
    pass
ok101 = got.startswith(b'HTTP/1.1 101')
oksh = b'SSH-' in got
print("%s port %d: 101=%s ssh-banner=%s first=%r" % ("PASS" if (ok101 and oksh) else "FAIL", port, ok101, oksh, got[:30]))
sys.exit(0 if (ok101 and oksh) else 1)
PYT
}

# Self-healing: every server ends up with the SAME working path (80/443 -> sslh -> ws-proxy 8080 -> ssh),
# no matter which script version installed it. Cheap when nothing is wrong, restarts only what changed.
# Network-layer self-heal: things outside the proxy chain that silently kill the tunnel
#  * ssh.socket (Ubuntu 22.10+/24.04) fights the custom sshd for port 22
#  * ufw / default-drop iptables block 22,80,443,8080 so the phone never gets the SSH banner (i/o timeout)
NET_CHANGED=0
# iptables -I rules live in RAM only. iptables-persistent (installed above) restores /etc/iptables/rules.v4 on every boot,
# and that file was saved BEFORE 22/80/443/8080 were opened -> after the installer's final reboot the ports close again
# (typical on Oracle/GCP/"default REJECT" images). Save the live rules so they survive reboot.
persist_iptables() {
  command -v iptables > /dev/null 2>&1 || return 0
  if command -v netfilter-persistent > /dev/null 2>&1; then
    netfilter-persistent save > /dev/null 2>&1
  else
    mkdir -p /etc/iptables
    iptables-save > /etc/iptables/rules.v4 2>/dev/null
  fi
  return 0
}

heal_network_layer() {
  NET_CHANGED=0
  if systemctl is-active ssh.socket > /dev/null 2>&1 || systemctl is-enabled ssh.socket > /dev/null 2>&1; then
    systemctl disable --now ssh.socket > /dev/null 2>&1
    systemctl restart ssh > /dev/null 2>&1
    NET_CHANGED=1
  fi
  if command -v ufw > /dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    for P in 22 80 443 8080; do
      ufw status 2>/dev/null | grep -qE "^${P}(/tcp)? +ALLOW" || { ufw allow ${P}/tcp > /dev/null 2>&1; NET_CHANGED=1; }
    done
  fi
  if command -v iptables > /dev/null 2>&1; then
    for P in 22 80 443 8080; do
      iptables -C INPUT -p tcp --dport $P -j ACCEPT > /dev/null 2>&1 || { iptables -I INPUT -p tcp --dport $P -j ACCEPT > /dev/null 2>&1; NET_CHANGED=1; }
    done
    # persist when we changed something, or when the saved file on disk is missing our ports
    if [ "$NET_CHANGED" = "1" ] || { [ -f /etc/iptables/rules.v4 ] && ! grep -q -- '--dport 8080 -j ACCEPT' /etc/iptables/rules.v4; }; then
      persist_iptables
    fi
  fi
  return 0
}

WS_PATCH_STAMP=/etc/acero_ws_v5
heal_ws_stack() {
  local FORCE="$1" CHANGED=0 BEFORE AFTER
  heal_network_layer
  [ "$NET_CHANGED" = "1" ] && CHANGED=1
  if [ ! -f /usr/local/bin/ws-proxy.py ] || [ ! -f /etc/systemd/system/ws-proxy-8080.service ]; then
    [ -f "$CONFIG_FILE" ] || [ "$FORCE" = "force" ] || return 0
    install_websocket > /dev/null 2>&1
    CHANGED=1
  fi

  # 1) ws-proxy.py must be the tolerant v2 build
  cp -f /usr/local/bin/ws-proxy.py /tmp/ws-proxy.old 2>/dev/null
  write_ws_proxy
  cmp -s /tmp/ws-proxy.old /usr/local/bin/ws-proxy.py || CHANGED=1
  rm -f /tmp/ws-proxy.old

  # 2) sslh must hand plain HTTP to 8080 (python proxy), never to nginx 8880
  BEFORE=$(cat /etc/sslh/sslh.cfg /etc/systemd/system/sslh.service 2>/dev/null | md5sum)
  patch_sslh_http_target
  AFTER=$(cat /etc/sslh/sslh.cfg /etc/systemd/system/sslh.service 2>/dev/null | md5sum)
  [ "$BEFORE" = "$AFTER" ] || CHANGED=1

  # 3) services must be up
  if [ "$(systemctl is-active ws-proxy-8080 2>/dev/null)" != "active" ]; then
    systemctl enable ws-proxy-8080 > /dev/null 2>&1
    CHANGED=1
  fi
  if [ "$(systemctl is-active sslh 2>/dev/null)" != "active" ] && [ "$(systemctl is-active sslh-select 2>/dev/null)" != "active" ]; then
    systemctl enable sslh > /dev/null 2>&1
    CHANGED=1
  fi

  # 4) port 80 must belong to sslh (apache/nginx/other listeners break the payload path)
  if ss -ltnp 2>/dev/null | awk '$4 ~ /:80$/' | grep -qv 'sslh'; then
    systemctl stop apache2 > /dev/null 2>&1
    systemctl disable apache2 > /dev/null 2>&1
    systemctl mask apache2 > /dev/null 2>&1
    fuser -k 80/tcp > /dev/null 2>&1
    CHANGED=1
  fi

  if [ "$CHANGED" = "1" ] || [ "$FORCE" = "force" ]; then
    systemctl daemon-reload > /dev/null 2>&1
    systemctl restart ws-proxy-8080 ssh-dnstt > /dev/null 2>&1
    systemctl restart sslh > /dev/null 2>&1 || systemctl restart sslh-select > /dev/null 2>&1
    sleep 3
  fi
  touch "$WS_PATCH_STAMP"
  return 0
}

# kept so old call sites still work
apply_ws_patch() { heal_ws_stack "$1"; }

install_websocket() {
  echo -e " ${Y}[*] Installing Python WebSocket proxy (port 8080, Keep-Alive + 301)...${N}"

  write_ws_proxy

  chmod +x /usr/local/bin/ws-proxy.py

  for PORT in 8080; do
    cat > /etc/systemd/system/ws-proxy-${PORT}.service << EOF
[Unit]
Description=WebSocket Proxy Port ${PORT}
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/ws-proxy.py ${PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
    systemctl enable ws-proxy-${PORT} > /dev/null 2>&1
    systemctl start ws-proxy-${PORT} > /dev/null 2>&1
  done

  echo -e " ${G}[✓] WebSocket proxy running on port 8080${N}"
}

