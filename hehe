# ══════════════════════════════════════════════
#   V2RAY CREATE ACCOUNT (per protocol)
# ══════════════════════════════════════════════

v2ray_create_account() {
  PROTO="$1"
  source "$CONFIG_FILE"
  clear
  DATETIME=$(date "+%b %d, %Y %I:%M:%S %p")
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}        ${W}Create ${PROTO^^} Account${N}               ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Time : ${G}$DATETIME${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"

  if [ "$PROTO" == "trojan" ]; then
    read -p "  Enter password: " V2_PASSWORD
    read -p "  Expiration (days): " V2_DAYS
    V2_USER="trojan_$(date +%s | tail -c 11 | tr -d '\n')"
    V2_UUID="$V2_PASSWORD"
    if [ -z "$V2_PASSWORD" ] || [ -z "$V2_DAYS" ]; then
      echo -e "\n${R} [!] All fields are required!${N}"
      sleep 2; return
    fi
  else
    read -p "  Enter username: " V2_USER
    read -p "  Expiration (days): " V2_DAYS
    V2_UUID="$V2_USER"
    if [ -z "$V2_USER" ] || [ -z "$V2_DAYS" ]; then
      echo -e "\n${R} [!] All fields are required!${N}"
      sleep 2; return
    fi
    if grep -q "^$V2_USER " /etc/xray/accounts.db 2>/dev/null; then
      echo -e "\n${R} [!] User '$V2_USER' already exists!${N}"
      sleep 2; return
    fi
  fi

  V2_EXPIRY=$(date -d "+${V2_DAYS} days" +"%Y-%m-%d %H:%M:%S")
  V2_EXPIRY_FULL=$(date -d "+${V2_DAYS} days" "+%Y-%m-%d %H:%M:%S")
  SERVER_IP=$(hostname -I | awk '{print $1}')

  # Determine internal port and path based on protocol
  case $PROTO in
    vless)  V2_PORT=10087; V2_PATH="/vless"  ;;
    vmess)  V2_PORT=10086; V2_PATH="/vmess"  ;;
    trojan) V2_PORT=10088; V2_PATH="/trojan" ;;
  esac
  V2_PUBLIC_PORTS="80, 443"

  # Save to accounts db
  echo "$V2_USER $V2_UUID $V2_EXPIRY $PROTO" >> /etc/xray/accounts.db

  # Inject client into the matching inbound in config.json
  python3 - << PYEOF
import json, sys
path = '/usr/local/etc/xray/config.json'
try:
    with open(path) as f:
        cfg = json.load(f)
except:
    cfg = {"log":{"loglevel":"warning"},"inbounds":[],"outbounds":[{"protocol":"freedom"}]}

proto = "$PROTO"
uuid  = "$V2_UUID"
user  = "$V2_USER"
port  = int("$V2_PORT")
path_ws = "$V2_PATH"

# Check if matching inbound exists
found = False
for inb in cfg.get('inbounds', []):
    if inb.get('protocol') == proto:
        clients = inb['settings'].get('clients', [])
        if proto == 'trojan':
            clients.append({"password": uuid, "email": user})
        else:
            clients.append({"id": uuid, "alterId": 0, "email": user})
        inb['settings']['clients'] = clients
        found = True
        break

if not found:
    if proto == 'trojan':
        new_inb = {
            "port": port, "listen": "127.0.0.1", "protocol": proto,
            "settings": {"clients": [{"password": uuid, "email": user}]},
            "streamSettings": {"network": "ws", "wsSettings": {"path": path_ws}}
        }
    else:
        new_inb = {
            "port": port, "listen": "127.0.0.1", "protocol": proto,
            "settings": {"clients": [{"id": uuid, "alterId": 0, "email": user}]},
            "streamSettings": {"network": "ws", "wsSettings": {"path": path_ws}}
        }
    cfg.setdefault('inbounds', []).append(new_inb)

with open(path, 'w') as f:
    json.dump(cfg, f, indent=2)
print("OK")
PYEOF

  systemctl restart xray > /dev/null 2>&1

  # Accurate expiry countdown
  NOW_S=$(date +%s)
  EXP_S=$(date -d "$V2_EXPIRY_FULL" +%s 2>/dev/null || date -d "$V2_EXPIRY" +%s)
  SECS_TOTAL=$(( EXP_S - NOW_S ))
  DAYS_LEFT=$(( SECS_TOTAL / 86400 ))
  HRS_LEFT=$(( (SECS_TOTAL % 86400) / 3600 ))
  MINS_LEFT=$(( (SECS_TOTAL % 3600) / 60 ))
  SECS_LEFT=$(( SECS_TOTAL % 60 ))

  # Build connection links based on protocol
  if [ "$PROTO" == "trojan" ]; then
    LINK_TLS="trojan://${V2_UUID}@${HOST}:443?type=ws&security=tls&host=${HOST}&path=${V2_PATH}&sni=${HOST}#${V2_UUID}"
    LINK_NTLS="trojan://${V2_UUID}@${HOST}:80?type=ws&host=${HOST}&path=${V2_PATH}#${V2_UUID}"
  elif [ "$PROTO" == "vless" ]; then
    LINK_TLS="vless://${V2_UUID}@${HOST}:443?encryption=none&type=ws&security=tls&host=${HOST}&path=${V2_PATH}&sni=${HOST}#${V2_USER}"
    LINK_NTLS="vless://${V2_UUID}@${HOST}:80?encryption=none&type=ws&host=${HOST}&path=${V2_PATH}#${V2_USER}"
  else
    VMESS_JSON="{\"v\":\"2\",\"ps\":\"${V2_USER}\",\"add\":\"${HOST}\",\"port\":\"443\",\"id\":\"${V2_UUID}\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"${HOST}\",\"path\":\"${V2_PATH}\",\"tls\":\"tls\",\"sni\":\"${HOST}\"}"
    VMESS_JSON2="{\"v\":\"2\",\"ps\":\"${V2_USER}\",\"add\":\"${HOST}\",\"port\":\"80\",\"id\":\"${V2_UUID}\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"${HOST}\",\"path\":\"${V2_PATH}\",\"tls\":\"\"}"
    LINK_TLS="vmess://$(echo -n "$VMESS_JSON" | base64 -w 0)"
    LINK_NTLS="vmess://$(echo -n "$VMESS_JSON2" | base64 -w 0)"
  fi

  clear
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${W}        ${PROTO^^} USER CREATED                 ${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  if [ "$PROTO" == "trojan" ]; then
  echo -e " Password    : ${G}$V2_UUID${N}"
  else
  echo -e " Username    : ${G}$V2_USER${N}"
  fi
  echo -e " Expiration  : ${G}${DAYS_LEFT} days${N}"
  echo -e " Expire Date : ${G}$V2_EXPIRY_FULL${N}"
  echo -e " Expires in  : ${G}${DAYS_LEFT}d ${HRS_LEFT}h ${MINS_LEFT}m ${SECS_LEFT}s${N}"
  echo -e " Domain      : ${G}$HOST${N}"
  echo -e " SNI         : ${G}$HOST${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e " TLS (443):"
  echo -e " ${G}${LINK_TLS}${N}"
  echo ""
  echo -e " Non-TLS (80):"
  echo -e " ${G}${LINK_NTLS}${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  press_enter
}

# ══════════════════════════════════════════════
#   V2RAY DELETE USER
# ══════════════════════════════════════════════

v2ray_delete_user() {
  while true; do
    clear
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${W}           Delete V2Ray User                 ${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e " ${W}[1]${N} VLESS"
    echo -e " ${W}[2]${N} VMess"
    echo -e " ${W}[3]${N} Trojan"
    echo -e " ${W}[0]${N} Return"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    read -p " Option: " PROTO_DEL
    case $PROTO_DEL in
      1) v2ray_delete_by_proto "vless"  ;;
      2) v2ray_delete_by_proto "vmess"  ;;
      3) v2ray_delete_by_proto "trojan" ;;
      0) break ;;
      *) echo -e "${R} Invalid option!${N}"; sleep 1 ;;
    esac
  done
}

v2ray_delete_by_proto() {
  FILTER_PROTO="$1"
  while true; do
    clear
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${W}        DELETE ${FILTER_PROTO^^} USER                  ${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"

    VACCS=()
    IDX=1

    while IFS= read -r line; do
      [ -z "$line" ] && continue
      vuser=$(echo "$line" | awk '{print $1}')
      vuuid=$(echo "$line" | awk '{print $2}')
      NCOLS=$(echo "$line" | awk '{print NF}')
      if [ "$NCOLS" -ge 5 ]; then
        vexpiry=$(echo "$line" | awk '{print $3" "$4}')
        vproto=$(echo "$line" | awk '{print $5}')
      else
        vexpiry=$(echo "$line" | awk '{print $3}')
        vproto=$(echo "$line" | awk '{print $4}')
      fi
      if [ "$vproto" == "$FILTER_PROTO" ]; then
        SECS_LEFT=$(( $(date -d "$vexpiry" +%s 2>/dev/null || echo 0) - $(date +%s) ))
        if [ $SECS_LEFT -le 0 ]; then
          TIME_LEFT="${R}EXPIRED${N}"
        else
          D=$(( SECS_LEFT/86400 ))
          H=$(( (SECS_LEFT%86400)/3600 ))
          M=$(( (SECS_LEFT%3600)/60 ))
          TIME_LEFT="${G}${D}d ${H}h ${M}m${N}"
        fi
        # Show password for trojan, username for others
        if [ "$FILTER_PROTO" == "trojan" ]; then
          DISPLAY_NAME="$vuuid"
        else
          DISPLAY_NAME="$vuser"
        fi
        echo -e " ${W}[$IDX]${N} $DISPLAY_NAME  ($TIME_LEFT)"
        VACCS+=("$vuser:$vuuid:$vexpiry:$vproto")
        IDX=$((IDX + 1))
      fi
    done < /etc/xray/accounts.db

    if [ ${#VACCS[@]} -eq 0 ]; then
      echo -e " ${Y} No ${FILTER_PROTO^^} accounts found.${N}"
      press_enter; return
    fi

    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e " ${W}[e]${N} Remove all expired ${FILTER_PROTO^^} users"
    echo -e " ${W}[A]${N} Remove all ${FILTER_PROTO^^} users (force)"
    echo -e " ${W}[0]${N} Return"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    read -p " Option: " DOPT

    if [ "$DOPT" == "0" ]; then
      break
    elif [ "$DOPT" == "e" ]; then
      COUNT=0
      TODAY=$(date +%Y-%m-%d)
      while read -r vuser vuuid vexpiry vproto; do
        if [ "$vproto" == "$FILTER_PROTO" ] && [[ "$vexpiry" < "$TODAY" ]]; then
          sed -i "/^$vuser /d" /etc/xray/accounts.db
          COUNT=$((COUNT+1))
        fi
      done < /etc/xray/accounts.db
      systemctl restart xray > /dev/null 2>&1
      echo -e "\n ${G}[✓] Removed $COUNT expired ${FILTER_PROTO^^} users!${N}"
      sleep 2
    elif [ "$DOPT" == "A" ]; then
      while read -r vuser vuuid vexpiry vproto; do
        if [ "$vproto" == "$FILTER_PROTO" ]; then
          sed -i "/^$vuser /d" /etc/xray/accounts.db
        fi
      done < /etc/xray/accounts.db
      # Remove all clients from this inbound in config
      python3 - << PYEOF
import json
path = '/usr/local/etc/xray/config.json'
with open(path) as f:
    cfg = json.load(f)
for inb in cfg.get('inbounds', []):
    if inb.get('protocol') == '$FILTER_PROTO':
        inb['settings']['clients'] = []
with open(path, 'w') as f:
    json.dump(cfg, f, indent=2)
PYEOF
      systemctl restart xray > /dev/null 2>&1
      echo -e "\n ${G}[✓] All ${FILTER_PROTO^^} users removed!${N}"
      sleep 2
    elif [[ "$DOPT" =~ ^[0-9]+$ ]] && [ "$DOPT" -ge 1 ] && [ "$DOPT" -lt "$IDX" ]; then
      TARGET="${VACCS[$((DOPT - 1))]}"
      DEL_USER=$(echo "$TARGET" | cut -d: -f1)
      DEL_UUID=$(echo "$TARGET" | cut -d: -f2)
      DEL_PROTO=$(echo "$TARGET" | cut -d: -f4)

      sed -i "/^$DEL_USER /d" /etc/xray/accounts.db

      python3 - << PYEOF
import json
path = '/usr/local/etc/xray/config.json'
with open(path) as f:
    cfg = json.load(f)
proto = "$DEL_PROTO"
uuid  = "$DEL_UUID"
for inb in cfg.get('inbounds', []):
    if inb.get('protocol') == proto:
        clients = inb['settings'].get('clients', [])
        if proto in ['vless', 'vmess']:
            inb['settings']['clients'] = [c for c in clients if c.get('id') != uuid]
        else:
            inb['settings']['clients'] = [c for c in clients if c.get('password') != uuid]
with open(path, 'w') as f:
    json.dump(cfg, f, indent=2)
PYEOF
      systemctl restart xray > /dev/null 2>&1
      echo -e "\n ${G}[✓] User '$DEL_USER' deleted!${N}"
      sleep 2
    else
      echo -e "\n${R} [!] Invalid option!${N}"
      sleep 1
    fi
  done
}

