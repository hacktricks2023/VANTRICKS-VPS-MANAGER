toggle_single_protocol() {
  local VAR_NAME="$1"
  local LABEL="$2"
  local SVC_LIST="$3"
  ensure_default_toggles
  local CUR="${!VAR_NAME}"
  if [ "$CUR" == "ON" ]; then
    set_config_kv "$VAR_NAME" "OFF"
    for s in $SVC_LIST; do
      systemctl stop "$s" > /dev/null 2>&1 || true
      systemctl disable "$s" > /dev/null 2>&1 || true
    done
    echo -e "\n ${Y}[✓] ${LABEL} toggled OFF${N}"
  else
    set_config_kv "$VAR_NAME" "ON"
    for s in $SVC_LIST; do
      systemctl enable "$s" > /dev/null 2>&1 || true
      systemctl restart "$s" > /dev/null 2>&1 || true
    done
    echo -e "\n ${G}[✓] ${LABEL} toggled ON${N}"
  fi
  sleep 1
}

