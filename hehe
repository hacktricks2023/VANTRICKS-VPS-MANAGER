  echo -e " Domain      : ${G}$HOST${N}"
  echo -e " CDN / SNI   : ${G}$ACTIVE_CDN${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e " TLS (443):"
  echo -e " ${G}${LINK_TLS}${N}"
