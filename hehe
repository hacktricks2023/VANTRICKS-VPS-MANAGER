first_run_setup() {
  clear
  ui_top
  ui_center "${Y}◆${N} ${W}Vantricks VPS Manager - Setup${N} ${Y}◆${N}"
  ui_mid
  read -p "  Host Domain (e.g. vps.yourdomain.sbs)     : " INPUT_HOST
  read -p "  NS Domain   (e.g. ns.yourdomain.sbs)      : " INPUT_NS
  ui_mid
  ui_row "  Public Key Type: 1 (Default) or 2 (Random)"
  ui_bot
  read -p "  Select [1/2]: " PK_CHOICE
  case $PK_CHOICE in
    1|2)
      INPUT_PUBKEY=$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 64 | head -n 1)
      [ "$PK_CHOICE" == "1" ] && PUBKEY_TYPE="default" || PUBKEY_TYPE="random"
      ;;
    *)
      INPUT_PUBKEY=$(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 64 | head -n 1)
      PUBKEY_TYPE="default"
      ;;
  esac
  [ -z "$INPUT_NS" ] && INPUT_NS="$INPUT_HOST"
  cat > "$CONFIG_FILE" << CFGINIT
HOST=$INPUT_HOST
NAMESERVER=$INPUT_NS
INIT_HOST=$INPUT_HOST
INIT_NAMESERVER=$INPUT_NS
PUBKEY=$INPUT_PUBKEY
PUBKEY_TYPE=$PUBKEY_TYPE
BANNER_TEXT="$DEFAULT_BANNER_TEXT"
AUTO_REBOOT_ON_SAVE=ON
PROTO_SSH=ON
PROTO_OVPN=ON
PROTO_SSL=ON
PROTO_MUX=ON
PROTO_WS=ON
PROTO_NGINX=ON
PROTO_XRAY=ON
PROTO_XHTTP=ON
PROTO_DNSTT=ON
PROTO_SSH_DNSTT=ON
PROTO_SLIPSTREAM=ON
BOOSTER_ENABLED=ON
REDIRECT_301=ON
CFGINIT
  source "$CONFIG_FILE"
  echo -e " ${G}[✓] Configuration saved! All protocols, Domain & NS defaulted to ON.${N}"
  sleep 1
  install_all
}

