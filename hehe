sni_proxy_host_menu() {
  init_packages_store
  local STAGED_FILE
  STAGED_FILE=$(mktemp)
  cp "$SNI_PROXY_HOST_FILE" "$STAGED_FILE" 2>/dev/null || true
  local UNSAVED_CHANGES=0

  while true; do
    clear
    get_booster_verdict_and_score
    ui_top
    ui_center "${Y}◆${N} ${W}SNI | PROXY | HOST MANAGER${N} ${Y}◆${N}"
    ui_mid
    ui_row "  Domain   : ${G}${HOST:-N/A}${N}"
    ui_row "  CDN Info : ${C}${CDN_PROVIDER} (${CDN_SERVER})${N}"
    ui_row "  CF-Ray   : ${W}${CDN_CF_RAY:-DIRECT-ORIGIN}${N}"
    ui_row "  Strength : ${G}${BOOSTER_SCORE}/100 [${BOOSTER_TIER}]${N}"
    ui_row "  Verdict  : ${G}${BOOSTER_VERDICT}${N}"
    if [ "$UNSAVED_CHANGES" -eq 1 ]; then
      ui_row "  Status   : ${Y}UNSAVED CHANGES (Click [s] Save)${N}"
    else
      ui_row "  Status   : ${G}SYNCED (301 + Keep-Alive + No-LB)${N}"
    fi
    ui_mid

    mapfile -t SPH_LIST < "$STAGED_FILE"
    if [ ${#SPH_LIST[@]} -eq 0 ]; then
      ui_row "  ${Y}No SNI / Proxy Host entries configured.${N}"
    else
      local idx=1
      for entry in "${SPH_LIST[@]}"; do
        ui_row "  ${Y}[$idx]${N} ${W}${G}${entry}${N}${N}"
        idx=$((idx + 1))
      done
    fi

    ui_mid
    ui_row "  ${Y}[a]${N} ${W}Add SNI / bug host${N}"
    ui_row "  ${Y}[d]${N} ${W}Delete Entry${N}"
    ui_row "  ${Y}[c]${N} ${W}Scan CDN Info on Host Domain${N}"
    ui_row "  ${Y}[s]${N} ${W}Save (Apply Booster + Auto Reboot)${N}"
    ui_row "  ${R}[0]${N} ${W}Back${N} ${DIM}(or Enter)${N}"
    ui_bot
    read -r -p "$(ui_ask 'Action')" SPH_OPT
    if [ -z "$SPH_OPT" ]; then
      if [ "$UNSAVED_CHANGES" -eq 1 ]; then
        echo -e "\n ${Y}[!] Unsaved changes - press [s] to save, or 0 to discard & go back.${N}"; sleep 2; continue
      fi
      rm -f "$STAGED_FILE"; break
    fi

    case "$SPH_OPT" in
      c|C)
        echo ""
        read -p "  Enter Host Domain to Scan (Enter = ${HOST:-$SERVER_IP}): " SCAN_T
        SCAN_T=$(echo "$SCAN_T" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -z "$SCAN_T" ] && SCAN_T="${HOST:-$SERVER_IP}"
        echo -e "\n ${Y}[*] Scanning CDN & Defense Headers for ${SCAN_T}...${N}\n"
        python3 "$BOOSTER_SCRIPT" cdn "$SCAN_T"
        press_enter
        ;;
      a|A)
        echo ""
        read -p "  Enter SNI | Proxy Host: " NEW_SPH
        NEW_SPH=$(echo "$NEW_SPH" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -z "$NEW_SPH" ]; then
          echo -e " ${R}[!] Input cannot be empty!${N}"
          sleep 1
        else
          echo "$NEW_SPH" >> "$STAGED_FILE"
          sed -i '/^[[:space:]]*$/d' "$STAGED_FILE"
          UNSAVED_CHANGES=1
          echo -e " ${G}[✓] Added '${NEW_SPH}' to list (Click [s] Save to apply).${N}"
          sleep 1
        fi
        ;;
      d|D)
        mapfile -t SPH_LIST < "$STAGED_FILE"
        if [ ${#SPH_LIST[@]} -eq 0 ]; then
          echo -e "\n ${R}[!] List is empty!${N}"
          sleep 1
        else
          read -p "  Enter entry # to delete : " DEL_SPH_IDX
          if ! [[ "$DEL_SPH_IDX" =~ ^[0-9]+$ ]] || [ "$DEL_SPH_IDX" -lt 1 ] || [ "$DEL_SPH_IDX" -gt "${#SPH_LIST[@]}" ]; then
            echo -e "\n ${R}[!] Invalid entry number!${N}"
            sleep 1
          else
            local POS=$((DEL_SPH_IDX - 1))
            local REM_ITEM="${SPH_LIST[$POS]}"
            unset 'SPH_LIST[$POS]'
            if [ ${#SPH_LIST[@]} -gt 0 ]; then
              printf "%s\n" "${SPH_LIST[@]}" > "$STAGED_FILE"
            else
              : > "$STAGED_FILE"
            fi
            sed -i '/^[[:space:]]*$/d' "$STAGED_FILE"
            UNSAVED_CHANGES=1
            echo -e "\n ${Y}[✓] Deleted '${REM_ITEM}' (Save to apply).${N}"
            sleep 1
          fi
        fi
        ;;
      s|S)
        sed -i '/^[[:space:]]*$/d' "$STAGED_FILE"
        cp "$STAGED_FILE" "$SNI_PROXY_HOST_FILE"
        rm -f "$STAGED_FILE"
        echo ""
        echo -e " ${Y}[*] Applying Real-Time Python Enhancement Booster...${N}"
        apply_enhancement_booster
        sync_host_config
        get_booster_verdict_and_score
        echo -e " ${G}[✓] Booster Verdict : ${BOOSTER_VERDICT} (${BOOSTER_SCORE}/100 [${BOOSTER_TIER}])${N}"
        trigger_auto_reboot "SNI | Proxy saved & Enhancement Booster applied!"
        ;;
      0)
        rm -f "$STAGED_FILE"
        break
        ;;
      *)
        echo -e "\n ${R}[!] Invalid option!${N}"
        sleep 1
        ;;
    esac
  done
}

count_packages() {
  init_packages_store
  num "$(grep -c '[^[:space:]]' "$PACKAGES_FILE" 2>/dev/null)"
}

is_package_in_list() {
  local TARGET_PKG="$1"
  init_packages_store
  [ -z "$TARGET_PKG" ] && return 1
  grep -Fxq "$TARGET_PKG" "$PACKAGES_FILE" 2>/dev/null
}

get_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  init_packages_store
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '$1==p && $2==u {print $3; exit}' "$ACCOUNT_PKG_DB"
}

set_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  local PKG_NAME="$3"
  init_packages_store
  local TMP
  TMP=$(mktemp)
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '!($1==p && $2==u)' "$ACCOUNT_PKG_DB" > "$TMP" 2>/dev/null || true
  echo "${PROTO_KEY}|${ACCT_ID}|${PKG_NAME}" >> "$TMP"
  mv "$TMP" "$ACCOUNT_PKG_DB"
}

remove_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  init_packages_store
  local TMP
  TMP=$(mktemp)
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '!($1==p && $2==u)' "$ACCOUNT_PKG_DB" > "$TMP" 2>/dev/null || true
  mv "$TMP" "$ACCOUNT_PKG_DB"
}

select_package_for_account() {
  init_packages_store
  grep -Fxq "DEFAULT" "$PACKAGES_FILE" 2>/dev/null || echo "DEFAULT" >> "$PACKAGES_FILE"
  SELECTED_PACKAGE="DEFAULT"
  return 0
}

verify_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  local ASSIGNED_PKG
  ASSIGNED_PKG=$(get_account_package "$PROTO_KEY" "$ACCT_ID")
  if [ -z "$ASSIGNED_PKG" ] || ! is_package_in_list "$ASSIGNED_PKG"; then
    init_packages_store
    is_package_in_list "DEFAULT" || echo "DEFAULT" >> "$PACKAGES_FILE"
    set_account_package "$PROTO_KEY" "$ACCT_ID" "DEFAULT"
  fi
  return 0
}

trigger_auto_reboot() {
  local REASON="${1:-Applying configuration...}"
  echo ""
  echo -e " ${G}[✓] ${REASON}${N}"
  echo -e " ${G} Rebooting automatically in...${N}"
  for i in 3 2 1; do
    echo -e " ${R}   $i...${N}"
    sleep 1
  done
  echo -e " ${G} Reconnect and type: menu${N}"
  sleep 1
  reboot
}

apply_save_action() {
  local REASON="${1:-Configuration saved.}"
  local STATE
  STATE=$(get_auto_reboot_state)
  if [ "$STATE" == "ON" ]; then
    trigger_auto_reboot "$REASON"
  else
    echo -e "\n ${G}[✓] ${REASON} (Auto Reboot is OFF)${N}"
    sleep 1
  fi
}

sync_host_config() {
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  init_packages_store
  SERVER_IP=$(get_public_ipv4)
  [ -z "$HOST" ] && HOST="$SERVER_IP"
  [ -z "$NAMESERVER" ] && NAMESERVER="$HOST"

  [ -z "$INIT_HOST" ] && set_config_kv "INIT_HOST" "$HOST"
  [ -z "$INIT_NAMESERVER" ] && set_config_kv "INIT_NAMESERVER" "$NAMESERVER"

  local EXTRA_HOSTS=""
  if [ -s "$SNI_PROXY_HOST_FILE" ]; then
    EXTRA_HOSTS=$(tr '\n' ' ' < "$SNI_PROXY_HOST_FILE")
  fi

  if [ -f /usr/local/bin/dnstt-start.sh ]; then
    cat > /usr/local/bin/dnstt-start.sh << DNSTTEOF
#!/bin/bash
exec /usr/local/bin/dnstt-server -udp :53 -privkey-file /etc/dnstt-priv.key ${NAMESERVER} 127.0.0.1:22
DNSTTEOF
    chmod +x /usr/local/bin/dnstt-start.sh
  fi

  cat > /usr/local/bin/ssh-dnstt-start.sh << SSHDNSTTEOF
#!/bin/bash
exec /usr/local/bin/ws-proxy.py 5301
SSHDNSTTEOF
  chmod +x /usr/local/bin/ssh-dnstt-start.sh

  if [ -x "$SLIPSTREAM_BIN" ]; then
    cat > /usr/local/bin/slipstream-start.sh << SLIPSEOF
#!/bin/bash
exec ${SLIPSTREAM_BIN} --domain ${NAMESERVER} --listen 127.0.0.1:5302 --target 127.0.0.1:22
SLIPSEOF
    chmod +x /usr/local/bin/slipstream-start.sh
  fi

  sysctl -w net.ipv4.tcp_keepalive_time=60 net.ipv4.tcp_keepalive_intvl=15 net.ipv4.tcp_keepalive_probes=4 > /dev/null 2>&1 || true

