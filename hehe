remove_ssh_ovpn_user() {
  while true; do
    clear
    echo -e "${C}╔══════════════════════════════════════════════╗${N}"
    echo -e "${C}║${N}       ${W}DELETE SSH + OPENVPN ACCOUNT${N}             ${C}║${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"

    USERS=()
    INDEX=1
    NOW_S=$(date +%s)
    while IFS=: read -r user _ uid _ _ _ _; do
      if [ "$uid" -ge 1000 ] && [ "$user" != "nobody" ]; then
        EXP=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
        EXP_S=$(date -d "$EXP" +%s 2>/dev/null || echo 0)
        if [ "$EXP" == "never" ] || [ "$EXP_S" -gt "$NOW_S" ] 2>/dev/null; then
          SESS=$(ps aux | grep -c "sshd: $user@" 2>/dev/null || echo 0)
          UPKG=$(get_account_package "ssh_ovpn" "$user")
          echo -e "${C}║${N}  ${W}[$INDEX]${N} $user  ${Y}|${N} Pkg: ${G}${UPKG:-NONE}${N}  ${Y}|${N} Online: ${G}$SESS${N}"
          USERS+=("$user")
          INDEX=$((INDEX + 1))
        fi
      fi
    done < /etc/passwd

    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${C}║${N}  ${W}[e]${N} Delete All Expired Accounts          ${C}║${N}"
    echo -e "${C}║${N}  ${W}[A]${N} Delete All Accounts (Force)          ${C}║${N}"
    echo -e "${C}║${N}  ${W}[0]${N} Back to Menu                         ${C}║${N}"
    echo -e "${C}╚══════════════════════════════════════════════╝${N}"
    read -p " Option >>> " DEL_OPT

    if [ "$DEL_OPT" == "0" ]; then
      break
    elif [ "$DEL_OPT" == "e" ]; then
      COUNT=0
      NOW_S=$(date +%s)
      while IFS=: read -r u _ uid _ _ _ _; do
        if [ "$uid" -ge 1000 ] && [ "$u" != "nobody" ]; then
          EXP=$(chage -l "$u" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
          if [ "$EXP" != "never" ] && [ -n "$EXP" ]; then
            EXP_S=$(date -d "$EXP" +%s 2>/dev/null || echo 0)
            if [ "$EXP_S" -lt "$NOW_S" ]; then
              sed -i "/Match User $u/,/MaxSessions/d" /etc/ssh/sshd_config
              rm -f "${OVPN_CLIENT_DIR}/${u}-tcp443.ovpn" "${OVPN_CLIENT_DIR}/${u}-udp1194.ovpn" "${OVPN_CLIENT_DIR}/${u}.ovpn" 2>/dev/null
              remove_account_package "ssh_ovpn" "$u"
              userdel -r "$u" > /dev/null 2>&1
              COUNT=$((COUNT + 1))
            fi
          fi
        fi
      done < /etc/passwd
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] Deleted $COUNT expired SSH+OVPN users!${N}"
      sleep 2
    elif [ "$DEL_OPT" == "A" ]; then
      for u in "${USERS[@]}"; do
        sed -i "/Match User $u/,/MaxSessions/d" /etc/ssh/sshd_config
        rm -f "${OVPN_CLIENT_DIR}/${u}-tcp443.ovpn" "${OVPN_CLIENT_DIR}/${u}-udp1194.ovpn" "${OVPN_CLIENT_DIR}/${u}.ovpn" 2>/dev/null
        remove_account_package "ssh_ovpn" "$u"
        userdel -r "$u" > /dev/null 2>&1
      done
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] All SSH+OVPN users deleted!${N}"
      sleep 2
    elif [[ "$DEL_OPT" =~ ^[0-9]+$ ]] && [ "$DEL_OPT" -ge 1 ] && [ "$DEL_OPT" -lt "$INDEX" ]; then
      TARGET="${USERS[$((DEL_OPT - 1))]}"
      sed -i "/Match User $TARGET/,/MaxSessions/d" /etc/ssh/sshd_config
      rm -f "${OVPN_CLIENT_DIR}/${TARGET}-tcp443.ovpn" "${OVPN_CLIENT_DIR}/${TARGET}-udp1194.ovpn" "${OVPN_CLIENT_DIR}/${TARGET}.ovpn" 2>/dev/null
      remove_account_package "ssh_ovpn" "$TARGET"
      userdel -r "$TARGET" > /dev/null 2>&1
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] User '$TARGET' (SSH + OVPN) deleted!${N}"
      sleep 2
    else
      echo -e "\n${R} [!] Invalid option!${N}"
      sleep 1
    fi
  done
}

check_ssh_ovpn_user() {
