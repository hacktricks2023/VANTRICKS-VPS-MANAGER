# ══════════════════════════════════════════════
#   SSL INSTALL (STUNNEL + SSLH)
# ══════════════════════════════════════════════

install_ssl() {
  echo -e " ${Y}[*] Installing SSL + Multiplexer on ports 80, 443...${N}"

  # Install stunnel — package name same across versions
  DEBIAN_FRONTEND=noninteractive apt-get install -y stunnel4 > /dev/null 2>&1

  # Install sslh
  echo "sslh sslh/inetd_or_standalone select standalone" | debconf-set-selections
  DEBIAN_FRONTEND=noninteractive apt-get install -y sslh > /dev/null 2>&1

  # Generate SSL cert — try Let's Encrypt first, fallback to self-signed
  mkdir -p /etc/stunnel
  CERT_OBTAINED=false

  # Try Let's Encrypt using the HOST domain
  if [ -n "$HOST" ]; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y certbot > /dev/null 2>&1
    # Temporarily free port 80 for certbot standalone
    fuser -k 80/tcp > /dev/null 2>&1
    sleep 1
    if certbot certonly --standalone -d "$HOST" \
      --non-interactive --agree-tos -m "admin@${HOST}" \
      --http-01-port 80 > /dev/null 2>&1; then
      # Use Let's Encrypt cert in stunnel
      cat > /etc/stunnel/stunnel.conf << EOF
cert = /etc/letsencrypt/live/${HOST}/fullchain.pem
key = /etc/letsencrypt/live/${HOST}/privkey.pem
socket = a:SO_REUSEADDR=1
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1
foreground = yes

[ssl-all]
accept = 127.0.0.1:7443
connect = 127.0.0.1:8080
EOF
      CERT_OBTAINED=true
      echo -e " ${G}[✓] Let's Encrypt SSL certificate obtained for $HOST${N}"
    fi
  fi

  # Fallback to self-signed if Let's Encrypt failed
  if [ "$CERT_OBTAINED" = false ]; then
    openssl req -new -x509 -days 3650 -nodes \
      -out /etc/stunnel/stunnel.pem \
      -keyout /etc/stunnel/stunnel.pem \
      -subj "/CN=Blu-2026" > /dev/null 2>&1
    chmod 600 /etc/stunnel/stunnel.pem
    echo -e " ${Y}[!] Using self-signed cert (Let's Encrypt failed)${N}"

    # Write stunnel config with self-signed cert
    cat > /etc/stunnel/stunnel.conf << 'EOF'
cert = /etc/stunnel/stunnel.pem
socket = a:SO_REUSEADDR=1
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1
foreground = yes

[ssl-all]
accept = 127.0.0.1:7443
connect = 127.0.0.1:8080
EOF
  fi

  # Stunnel systemd service
  rm -rf /etc/systemd/system/stunnel4.service.d/ 2>/dev/null
  cat > /etc/systemd/system/stunnel4.service << 'SEOF'
[Unit]
Description=SSL tunnel
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/stunnel4 /etc/stunnel/stunnel.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SEOF

  # Enable stunnel
  sed -i '/^ENABLED/d' /etc/default/stunnel4 2>/dev/null
  echo "ENABLED=1" >> /etc/default/stunnel4
  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable stunnel4 > /dev/null 2>&1
  systemctl restart stunnel4 > /dev/null 2>&1
  sleep 2

  # SSLH: multiplexer on 80 and 443
  # Detect sslh version — 1.x uses CLI args, 2.x uses config file
  SSLH_VER=$(sslh -V 2>&1 | grep -oP '\d+' | head -1)
  mkdir -p /var/run/sslh /etc/sslh
  chown sslh:sslh /var/run/sslh 2>/dev/null || true

  if [ "${SSLH_VER}" -ge 2 ] 2>/dev/null; then
    # sslh 2.x — use config file
    cat > /etc/sslh/sslh.cfg << 'EOF'
foreground: true;
inetd: false;
numeric: false;
transparent: false;
timeout: 5;
user: "sslh";
pidfile: "/var/run/sslh/sslh.pid";

listen:
(
  { host: "0.0.0.0"; port: "80"; },
  { host: "0.0.0.0"; port: "443"; }
);

protocols:
(
  { name: "ssh";     host: "127.0.0.1"; port: "22";   log_level: 0; },
  { name: "tls";     host: "127.0.0.1"; port: "7443"; log_level: 0; },
  { name: "http";    host: "127.0.0.1"; port: "8880"; log_level: 0; },
  { name: "anyprot"; host: "127.0.0.1"; port: "8080"; log_level: 0; }
);
EOF
    cat > /etc/systemd/system/sslh.service << 'SSLHEOF'
[Unit]
Description=SSL/SSH Multiplexer
After=network.target ssh.service stunnel4.service nginx.service
Wants=ssh.service stunnel4.service nginx.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 5
ExecStart=/usr/sbin/sslh-select -F /etc/sslh/sslh.cfg
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SSLHEOF
  else
    # sslh 1.x — use command line args
    cat > /etc/systemd/system/sslh.service << 'SSLHEOF'
[Unit]
Description=SSL/SSH Multiplexer
After=network.target ssh.service stunnel4.service nginx.service
Wants=ssh.service stunnel4.service nginx.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 5
ExecStart=/usr/sbin/sslh -f \
  -p 0.0.0.0:80 \
  -p 0.0.0.0:443 \
  --ssh 127.0.0.1:22 \
  --tls 127.0.0.1:7443 \
  --http 127.0.0.1:8880 \
  --anyprot 127.0.0.1:8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SSLHEOF
  fi

  if [ -f /etc/default/sslh ]; then
    sed -i 's/^RUN=.*/RUN=yes/' /etc/default/sslh
  fi
  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable sslh > /dev/null 2>&1
  # Make sure ports are free before starting sslh
  fuser -k 80/tcp > /dev/null 2>&1
  fuser -k 443/tcp > /dev/null 2>&1
  sleep 2
  systemctl restart sslh > /dev/null 2>&1
  sleep 3

  echo -e " ${G}[✓] Stunnel: port 7443(SSH-SSL) port 444(WS-SSL)${N}"
  echo -e " ${G}[✓] SSLH multiplexer on ports 80, 443${N}"
}

