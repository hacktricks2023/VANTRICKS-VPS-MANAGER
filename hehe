v2ray_check_user() {
  while true; do
    clear
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${W}           Check V2Ray Users                 ${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e " ${W}[1]${N} VLESS"
    echo -e " ${W}[2]${N} VMess"
