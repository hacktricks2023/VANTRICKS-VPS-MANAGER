  [ -z "$INIT_HOST" ] && set_config_kv "INIT_HOST" "$HOST"
  [ -z "$INIT_CDN_DOMAIN" ] && set_config_kv "INIT_CDN_DOMAIN" "$CDN_DOMAIN"
  [ -z "$INIT_NAMESERVER" ] && set_config_kv "INIT_NAMESERVER" "$NAMESERVER"

