  echo "$NEW_H" >> "$SNI_PROXY_HOST_FILE"
  sed -i '/^[[:space:]]*$/d' "$SNI_PROXY_HOST_FILE" 2>/dev/null || true

  if [ -d "$OVPN_CLIENT_DIR" ]; then
