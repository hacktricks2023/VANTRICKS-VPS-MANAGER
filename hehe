      done
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] All SSH+OVPN users deleted!${N}"
      sleep 2
    elif [[ "$DEL_OPT" =~ ^[0-9]+$ ]] && [ "$DEL_OPT" -ge 1 ] && [ "$DEL_OPT" -lt "$INDEX" ]; then
      TARGET="${USERS[$((DEL_OPT - 1))]}"
      sed -i "/Match User $TARGET/,/MaxSessions/d" /etc/ssh/sshd_config
      rm -f "${OVPN_CLIENT_DIR}/${TARGET}-tcp443.ovpn" "${OVPN_CLIENT_DIR}/${TARGET}-udp1194.ovpn" "${OVPN_CLIENT_DIR}/${TARGET}.ovpn" 2>/dev/null
      remove_account_package "ssh_ovpn" "$TARGET"; mux_forget "$TARGET"
