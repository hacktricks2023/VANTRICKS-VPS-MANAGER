def cmd_snapshot():
    cfg, users, devs, limits = collect()
    online = sorted(devs)
    over = sum(1 for u in online if limits[u][0] > 0 and len(devs[u]) > limits[u][0])
    print("T|%d|%d|%d|%d" % (len(online), sum(len(v) for v in devs.values()), len(users), over))
    guard_age, kicks = -1, 0
    try:
        ts = int(read1(STATE).split("|")[0])
        guard_age = int(time.time()) - ts
    except Exception:
        pass
    today = time.strftime("%Y-%m-%d")
    try:
        with open(LOG) as f:
            kicks = sum(1 for ln in f if ln.startswith(today) and "|kick|" in ln)
    except OSError:
        pass
    print("H|%s|%s|%s|%d|%d" % (cfg.get("MUX_AUTO", "OFF"), cfg.get("MUX_POLICY", "NEWEST"),
                                cfg.get("MUX_DEFAULT_LIMIT", "2"), guard_age, kicks))
    for u in online:
        lim, src = limits[u]
        print("U|%s|%d|%d|%s" % (u, len(devs[u]), lim, src))
        for i, d in enumerate(devs[u], 1):
            print("D|%s|%d|%s|%s|%s" % (u, i, d["proto"], d["detail"], fmt_age(d["age"])))
    for u in sorted(users):
        if u not in devs:
            print("I|%s|%d|%s" % (u, limits[u][0], limits[u][1]))


def cmd_log(n):
    rows = []
    try:
        with open(LOG) as f:
            for ln in f:
                p = ln.rstrip("\n").split("|")
                if len(p) >= 6 and p[1] == "kick":
                    rows.append("G|%s|%s|%s|%s|%s" % (p[0][11:16], p[2], p[3], p[4], p[5]))
    except OSError:
        pass
    print("\n".join(rows[-n:]))


def main():
    a = sys.argv[1:]
    c = a[0] if a else "snapshot"
    if c == "guard":
