    ui_note "Time to the SSH banner, measured here."
    ui_note "Guard is out-of-band: 0 extra hops."
    ui_mid
    [ "$bad" -eq 1 ] && ui_item f "Fix what can be fixed"
    ui_item r "Test again"
    ui_back
    ui_bot
    read -r -p "$(ui_ask 'Action')" ans
    case "$ans" in
      f|F) mux_lowlat_fix ;;
      r|R) ;;
      ""|0) break ;;
    esac
  done
}

mux_conflicts_screen() {
  local OUT t a b c d bad=0 led tag
  OUT=$(python3 "$MUX_PY" conflicts 2>/dev/null)
  while IFS='|' read -r t a b c d; do [ "$d" = "conflict" ] && bad=$((bad + 1)); done <<< "$OUT"
  clear
  ui_head "PORT CONFLICT CHECK"
  if [ "$bad" -eq 0 ]; then ui_split " ${Y}◆${N} ${W}LISTENING PORTS${N}" "${G}✓ no conflict${N}"
  else ui_split " ${Y}◆${N} ${W}LISTENING PORTS${N}" "${R}✗ ${bad} conflict(s)${N}"; fi
  while IFS='|' read -r t a b c d; do
    [ "$t" = "C" ] || continue
    case "$d" in
      ok)       led="${G}●${N}"; tag="${G}✓${N}" ;;
      conflict) led="${R}●${N}"; tag="${R}✗ TAKEN${N}" ;;
      off)      led="${DIM}○${N}"; tag="${DIM}OFF${N}" ;;
      *)        led="${R}●${N}"; tag="${R}✗ DOWN${N}" ;;
    esac
    ui_row "  ${led} $(printf '%-11s %-9s %-11s' "$a" "$b" "${c:0:11}") ${tag}"
  done <<< "$OUT"
  ui_mid
  ui_note "Account Multiplexer opens no TCP/UDP port."
  ui_note "OVPN control = private unix socket."
  ui_note "TAKEN = another program holds that port."
  ui_bot
  press_enter
}

mux_menu() {
  local O SNAPH b pill gtxt dev acc kick cf pol
  install_mux_python
  while true; do
    ensure_default_toggles
    SNAPH=$(python3 "$MUX_PY" snapshot 2>/dev/null | grep -E '^(T|H)\|')
    IFS='|' read -r _ _ dev acc _ <<< "$(grep -m1 '^T|' <<< "$SNAPH")"
    IFS='|' read -r _ _ _ _ b kick <<< "$(grep -m1 '^H|' <<< "$SNAPH")"
    : "${dev:=0}" "${acc:=0}" "${b:=-1}" "${kick:=0}"
    cf=$(python3 "$MUX_PY" conflicts 2>/dev/null | grep -c '|conflict$')
    if [ "${MUX_AUTO:-OFF}" = "ON" ]; then
      pill="${G}● ON${N}"
      if [ "$b" -ge 0 ] && [ "$b" -le 20 ]; then gtxt="${G}● running${N} ${DIM}· checked ${b}s ago${N}"
      else gtxt="${R}● not running${N} ${DIM}· use Restart Services${N}"; fi
    else
      pill="${R}● OFF${N}"; gtxt="${DIM}○ stopped${N}"
    fi
    if [ "${MUX_POLICY:-NEWEST}" = "OLDEST" ]; then pol="Keep oldest"; else pol="Keep newest"; fi
    clear
    ui_head "ACCOUNT MULTIPLEXER"
    ui_center "${DIM}1 account · many protocols · no conflict${N}"
    ui_mid
    ui_section "STATUS"
    ui_kv "Auto mode" "$pill"
    ui_kv "Guard" "$gtxt"
    ui_kv "Devices" "${G}${dev}${N} online ${DIM}· ${acc} accounts${N}"
    ui_kv "Removed" "${kick} today ${DIM}(over the limit)${N}"
    if [ "$cf" -eq 0 ]; then ui_kv "Ports" "${G}✓ no conflict${N}"; else ui_kv "Ports" "${R}✗ ${cf} conflict(s)${N}"; fi
    ui_mid
    ui_section "MENU"
    ui_opt 1 "Auto for all accounts" "$pill"
    ui_item 2 "Live Dashboard"
    ui_item 3 "Low Latency Check"
    ui_item 4 "Port Conflict Check"
    ui_opt 5 "Default limit" "${G}${MUX_DEFAULT_LIMIT:-2} device(s)${N}"
    ui_opt 6 "When over the limit" "${G}${pol}${N}"
    ui_back
    ui_bot
    read -r -p "$(ui_ask 'Select option')" O
    [ -z "$O" ] && break
    case "$O" in
      1) mux_toggle ;;
      2) mux_live_dashboard ;;
      3) mux_latency_screen ;;
      4) mux_conflicts_screen ;;
      5) mux_set_default ;;
      6) mux_policy_toggle ;;
      0) break ;;
      *) echo -e "${R} Invalid option!${N}"; sleep 1 ;;
    esac
  done
}

