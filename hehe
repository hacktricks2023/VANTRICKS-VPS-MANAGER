    b"Connection: Upgrade\r\n"
    b"Sec-WebSocket-Version: 13\r\n"
    b"Via: vantricks-SSH\r\n"
    b"\r\n"
)

RESPONSE_PLAIN = (
    b"HTTP/1.1 101 vantricks Protocols\r\n"
    b"Upgrade: websocket\r\n"
    b"Connection: Upgrade\r\n"
    b"Sec-WebSocket-Version: 13\r\n"
    b"Via: vantricks-SSH\r\n"
    b"\r\n"
)

def enable_keepalive(sock):
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    except Exception:
        pass

def forward(src, dst):
    enable_keepalive(src)
    enable_keepalive(dst)
    try:
        while True:
            r, _, _ = select.select([src], [], [], TIMEOUT)
            if r:
                d = src.recv(BUFFER)
                if not d:
                    break
                dst.sendall(d)
    except Exception:
        pass
    finally:
        for sock in (src, dst):
            try:
                sock.close()
            except Exception:
                pass

def handle(client):
    enable_keepalive(client)
    try:
        data = client.recv(BUFFER)
        if not data:
            client.close()
            return

        lower_data = data.lower()
        is_http = data[:4] in (b'GET ', b'POST', b'HEAD', b'CONN', b'PUT ', b'OPTI') or b'host:' in lower_data
        is_websocket = b'upgrade: websocket' in lower_data
        is_v2ray = is_http and any(path in data for path in V2RAY_PATHS)

        if is_v2ray:
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            enable_keepalive(target)
            target.connect((SSH_HOST, NGINX_PORT))
            target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
        elif is_http and not is_websocket:
            client.send(RESPONSE_PLAIN)
            client.close()
            return
        else:
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            enable_keepalive(target)
            target.connect((SSH_HOST, SSH_PORT))
            if is_http:
                client.send(RESPONSE_COLOR)
            else:
                target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
    except Exception:
        try:
            client.close()
        except Exception:
            pass

def start(port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    enable_keepalive(srv)
    srv.bind(('0.0.0.0', port))
    srv.listen(200)
    while True:
        try:
            c, _ = srv.accept()
            enable_keepalive(c)
            threading.Thread(target=handle, args=(c,), daemon=True).start()
        except Exception:
            pass

if __name__ == '__main__':
    start(LISTEN_PORT)
PYEOF

  chmod +x /usr/local/bin/ws-proxy.py

  for PORT in 8080; do
    cat > /etc/systemd/system/ws-proxy-${PORT}.service << EOF
[Unit]
Description=WebSocket Proxy Port ${PORT}
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/ws-proxy.py ${PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
    systemctl enable ws-proxy-${PORT} > /dev/null 2>&1
    systemctl start ws-proxy-${PORT} > /dev/null 2>&1
  done

  echo -e " ${G}[✓] WebSocket proxy running on port 8080${N}"
}

