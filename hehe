install_dnstt() {
  echo -e " ${Y}[*] Installing DNSTT...${N}"

  # Install latest Go
  GO_VER="1.22.5"
  wget -q "https://go.dev/dl/go${GO_VER}.linux-amd64.tar.gz" -O /tmp/go.tar.gz 2>/dev/null
  rm -rf /usr/local/go
  tar -C /usr/local -xzf /tmp/go.tar.gz > /dev/null 2>&1
  export PATH=$PATH:/usr/local/go/bin

  # Download and build dnstt
  apt-get install -y unzip > /dev/null 2>&1
  wget -q "https://www.bamsoftware.com/software/dnstt/dnstt-20220208.zip" -O /tmp/dnstt.zip 2>/dev/null
  cd /tmp && unzip -o dnstt.zip > /dev/null 2>&1
  cd /tmp/dnstt-20220208/dnstt-server
  /usr/local/go/bin/go build . > /dev/null 2>&1
  cp dnstt-server /usr/local/bin/dnstt-server
  chmod +x /usr/local/bin/dnstt-server

  # Generate keypair
  /usr/local/bin/dnstt-server -gen-key -privkey-file /etc/dnstt-priv.key -pubkey-file /etc/dnstt-pub.key > /dev/null 2>&1

  # Save pubkey to config
  DNSTT_PUBKEY=$(cat /etc/dnstt-pub.key 2>/dev/null | tr -d '\n' || echo "N/A")
  sed -i '/^DNSTT_PUBKEY/d' "$CONFIG_FILE"
  echo "DNSTT_PUBKEY=$DNSTT_PUBKEY" >> "$CONFIG_FILE"

  # Create startup script — DNSTT on port 53
  cat > /usr/local/bin/dnstt-start.sh << EOF
#!/bin/bash
exec /usr/local/bin/dnstt-server -udp :53 -privkey-file /etc/dnstt-priv.key ${NAMESERVER} 127.0.0.1:22
EOF
  chmod +x /usr/local/bin/dnstt-start.sh

  # Create systemd service
  cat > /etc/systemd/system/dnstt.service << 'EOF'
[Unit]
Description=DNSTT DNS Tunnel Server
After=network.target

[Service]
ExecStart=/usr/local/bin/dnstt-start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

  # Free port 53 from systemd-resolved
  systemctl stop systemd-resolved > /dev/null 2>&1
  systemctl disable systemd-resolved > /dev/null 2>&1

  # Make DNS persistent across reboots
  rm -f /etc/resolv.conf
  echo "nameserver 8.8.8.8" > /etc/resolv.conf
  echo "nameserver 8.8.4.4" >> /etc/resolv.conf
  # Lock the file so systemd-resolved can't overwrite it
  chattr +i /etc/resolv.conf 2>/dev/null || true

  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable dnstt > /dev/null 2>&1
  systemctl start dnstt > /dev/null 2>&1

  # Check if started
  sleep 2
  if systemctl is-active --quiet dnstt; then
    echo -e " ${G}[✓] DNSTT running on port 53${N}"
  else
    echo -e " ${Y}[!] DNSTT installed but may need DNS record setup${N}"
  fi
}

install_custom_openssh() {
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential zlib1g-dev libssl-dev libpam0g-dev \
    libselinux1-dev libedit-dev autoconf > /dev/null 2>&1

  OPENSSH_VER="9.2p1"
  cd /tmp
  wget -q "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${OPENSSH_VER}.tar.gz" -O openssh-src.tar.gz 2>/dev/null
  tar -xzf openssh-src.tar.gz > /dev/null 2>&1
  cd openssh-${OPENSSH_VER}

  # Patch version string
  sed -i 's/#define SSH_VERSION.*/#define SSH_VERSION "Blu-2026-SSH"/' version.h
  sed -i 's/#define SSH_PORTABLE.*/#define SSH_PORTABLE ""/' version.h

  ./configure --prefix=/usr --sysconfdir=/etc/ssh --with-pam > /dev/null 2>&1
  make -j$(nproc) > /dev/null 2>&1

  # Stop ssh before replacing binary to avoid "Text file busy"
  systemctl stop ssh > /dev/null 2>&1
  systemctl stop sshd > /dev/null 2>&1
  install -m 755 sshd /usr/sbin/sshd

  # Create required dirs and sshd user for privilege separation
  mkdir -p /var/empty /run/sshd
  chown root:root /var/empty
  chmod 755 /var/empty
  useradd -r -s /sbin/nologin -d /var/empty sshd > /dev/null 2>&1 || true

  # Fix systemd service to use -D flag (foreground) with Type=simple
  cat > /etc/systemd/system/ssh.service << 'SVCEOF'
[Unit]
Description=Blu-2026-SSH Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/sshd -D
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
SVCEOF

  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable ssh > /dev/null 2>&1
  systemctl start ssh > /dev/null 2>&1

  cd /tmp && rm -rf openssh-${OPENSSH_VER} openssh-src.tar.gz
  echo -e " ${G}[✓] Blu-2026-SSH installed!${N}"
}

