sni_proxy_host_menu() {
  init_packages_store
  local STAGED_FILE
  STAGED_FILE=$(mktemp)
  cp "$SNI_PROXY_HOST_FILE" "$STAGED_FILE" 2>/dev/null || true
  local UNSAVED_CHANGES=0

  while true; do
    clear
    get_booster_verdict_and_score
    echo -e "${C}╔══════════════════════════════════════════════╗${N}"
    echo -e "${C}║${N}       ${W}SNI | PROXY | CDN | HOST MANAGER${N}       ${C}║${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${C}║${N}  CDN Host : ${G}${CDN_DOMAIN:-$HOST}${N}"
    echo -e "${C}║${N}  Strength : ${G}${BOOSTER_SCORE}/100 [${BOOSTER_TIER}]${N}"
    echo -e "${C}║${N}  Verdict  : ${G}${BOOSTER_VERDICT}${N}"
    if [ "$UNSAVED_CHANGES" -eq 1 ]; then
      echo -e "${C}║${N}  Status   : ${Y}UNSAVED CHANGES (Click [s] Save)${N}"
    else
      echo -e "${C}║${N}  Status   : ${G}SYNCED (301 + Keep-Alive + No-LB)${N}"
    fi
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"

    mapfile -t SPH_LIST < "$STAGED_FILE"
    if [ ${#SPH_LIST[@]} -eq 0 ]; then
      echo -e "${C}║${N}  ${Y}No SNI / Proxy / CDN Host entries configured.${N}"
    else
      local idx=1
      for entry in "${SPH_LIST[@]}"; do
        echo -e "${C}║${N}  ${W}[$idx]${N} ${G}${entry}${N}"
        idx=$((idx + 1))
      done
    fi

    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${C}║${N}  ${W}[a]${N} Add (e.g. cdn.yourdomain.com)            ${C}║${N}"
    echo -e "${C}║${N}  ${W}[d]${N} Delete Entry                             ${C}║${N}"
    echo -e "${C}║${N}  ${W}[s]${N} Save (Apply Booster + Auto Reboot)       ${C}║${N}"
    echo -e "${C}║${N}  ${W}[0]${N} Back (Discard Unsaved)                   ${C}║${N}"
    echo -e "${C}╚══════════════════════════════════════════════╝${N}"
    read -p " Action >>> " SPH_OPT

    case "$SPH_OPT" in
      a|A)
        echo ""
        read -p "  Enter SNI | Proxy | CDN Host (e.g. cdn.yourdomain.com): " NEW_SPH
        NEW_SPH=$(echo "$NEW_SPH" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -z "$NEW_SPH" ]; then
          echo -e " ${R}[!] Input cannot be empty!${N}"
          sleep 1
        else
          echo "$NEW_SPH" >> "$STAGED_FILE"
          sed -i '/^[[:space:]]*$/d' "$STAGED_FILE"
          UNSAVED_CHANGES=1
          echo -e " ${G}[✓] Added '${NEW_SPH}' to list (Click [s] Save to apply & reboot).${N}"
          sleep 1
        fi
        ;;
      d|D)
        mapfile -t SPH_LIST < "$STAGED_FILE"
        if [ ${#SPH_LIST[@]} -eq 0 ]; then
          echo -e "\n ${R}[!] List is empty!${N}"
          sleep 1
        else
          read -p "  Enter entry # to delete : " DEL_SPH_IDX
          if ! [[ "$DEL_SPH_IDX" =~ ^[0-9]+$ ]] || [ "$DEL_SPH_IDX" -lt 1 ] || [ "$DEL_SPH_IDX" -gt "${#SPH_LIST[@]}" ]; then
            echo -e "\n ${R}[!] Invalid entry number!${N}"
            sleep 1
          else
            local POS=$((DEL_SPH_IDX - 1))
            local REM_ITEM="${SPH_LIST[$POS]}"
            unset 'SPH_LIST[$POS]'
            if [ ${#SPH_LIST[@]} -gt 0 ]; then
              printf "%s\n" "${SPH_LIST[@]}" > "$STAGED_FILE"
            else
              : > "$STAGED_FILE"
            fi
            sed -i '/^[[:space:]]*$/d' "$STAGED_FILE"
            UNSAVED_CHANGES=1
            echo -e "\n ${Y}[✓] Deleted '${REM_ITEM}' from list (Click [s] Save to apply & reboot).${N}"
            sleep 1
          fi
        fi
        ;;
      s|S)
        sed -i '/^[[:space:]]*$/d' "$STAGED_FILE"
        cp "$STAGED_FILE" "$SNI_PROXY_HOST_FILE"
        rm -f "$STAGED_FILE"

        LATEST_SPH=$(tail -n 1 "$SNI_PROXY_HOST_FILE" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$LATEST_SPH" ]; then
          set_config_kv "CDN_DOMAIN" "$LATEST_SPH"
          set_config_kv "HOST" "$LATEST_SPH"
          if [ -d "$OVPN_CLIENT_DIR" ]; then
            for ovpn in "${OVPN_CLIENT_DIR}"/*-tcp443.ovpn; do
              [ -f "$ovpn" ] || continue
              u_name=$(basename "$ovpn" "-tcp443.ovpn")
              generate_ovpn_profile "$u_name"
            done
          fi
        fi

        echo ""
        echo -e " ${Y}[*] Applying Real-Time Python Enhancement Booster...${N}"
        apply_enhancement_booster
        sync_host_config
        get_booster_verdict_and_score
        echo -e " ${G}[✓] Booster Verdict : ${BOOSTER_VERDICT} (${BOOSTER_SCORE}/100 [${BOOSTER_TIER}])${N}"
        trigger_auto_reboot "SNI | Proxy | CDN | Host saved & Enhancement Booster applied!"
        ;;
      0)
        rm -f "$STAGED_FILE"
        break
        ;;
      *)
        echo -e "\n ${R}[!] Invalid option!${N}"
        sleep 1
        ;;
    esac
  done
}

count_packages() {
  init_packages_store
  grep -c '[^[:space:]]' "$PACKAGES_FILE" 2>/dev/null || echo 0
}

is_package_in_list() {
  local TARGET_PKG="$1"
  init_packages_store
  [ -z "$TARGET_PKG" ] && return 1
  grep -Fxq "$TARGET_PKG" "$PACKAGES_FILE" 2>/dev/null
}

get_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  init_packages_store
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '$1==p && $2==u {print $3; exit}' "$ACCOUNT_PKG_DB"
}

set_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  local PKG_NAME="$3"
  init_packages_store
  local TMP
  TMP=$(mktemp)
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '!($1==p && $2==u)' "$ACCOUNT_PKG_DB" > "$TMP" 2>/dev/null || true
  echo "${PROTO_KEY}|${ACCT_ID}|${PKG_NAME}" >> "$TMP"
  mv "$TMP" "$ACCOUNT_PKG_DB"
}

remove_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  init_packages_store
  local TMP
  TMP=$(mktemp)
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '!($1==p && $2==u)' "$ACCOUNT_PKG_DB" > "$TMP" 2>/dev/null || true
  mv "$TMP" "$ACCOUNT_PKG_DB"
}

select_package_for_account() {
  init_packages_store
  local CNT
  CNT=$(count_packages)
  if [ "$CNT" -le 0 ]; then
    echo ""
    echo -e " ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return 1
  fi

  mapfile -t PKGS < "$PACKAGES_FILE"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e " ${W}Select Package Name (Required):${N}"
  local idx=1
  for p in "${PKGS[@]}"; do
    echo -e "  ${W}[$idx]${N} ${G}${p}${N}"
    idx=$((idx + 1))
  done
  read -p "  Package # : " P_SEL

  if ! [[ "$P_SEL" =~ ^[0-9]+$ ]] || [ "$P_SEL" -lt 1 ] || [ "$P_SEL" -gt "${#PKGS[@]}" ]; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return 1
  fi

  SELECTED_PACKAGE="${PKGS[$((P_SEL - 1))]}"
  if ! is_package_in_list "$SELECTED_PACKAGE"; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return 1
  fi
  return 0
}

verify_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  local ASSIGNED_PKG
  ASSIGNED_PKG=$(get_account_package "$PROTO_KEY" "$ACCT_ID")
  if [ -z "$ASSIGNED_PKG" ] || ! is_package_in_list "$ASSIGNED_PKG"; then
    return 1
  fi
  return 0
}

trigger_auto_reboot() {
  local REASON="${1:-Applying configuration...}"
  echo ""
  echo -e " ${G}[✓] ${REASON}${N}"
  echo -e " ${C}╠══════════════════════════════════════════════╣${N}"
  echo -e " ${G} Rebooting automatically in...${N}"
  for i in 3 2 1; do
    echo -e " ${R}   $i...${N}"
    sleep 1
  done
  echo -e " ${G} Reconnect and type: menu${N}"
  sleep 1
  reboot
}

apply_save_action() {
  local REASON="${1:-Configuration saved.}"
  local STATE
  STATE=$(get_auto_reboot_state)
  if [ "$STATE" == "ON" ]; then
    trigger_auto_reboot "$REASON"
  else
    echo -e "\n ${G}[✓] ${REASON} (Auto Reboot is OFF)${N}"
    sleep 1
  fi
}

sync_host_config() {
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  init_packages_store
  SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  [ -z "$HOST" ] && HOST="$SERVER_IP"
  [ -z "$NAMESERVER" ] && NAMESERVER="$HOST"
  [ -z "$CDN_DOMAIN" ] && CDN_DOMAIN="$HOST"

