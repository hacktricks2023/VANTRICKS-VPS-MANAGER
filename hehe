      break
    elif [[ "$CHK_OPT" =~ ^[0-9]+$ ]] && [ "$CHK_OPT" -ge 1 ] && [ "$CHK_OPT" -lt "$INDEX" ]; then
      CHK_USER="${USERS[$((CHK_OPT - 1))]}"
