edit_package_name() {
  init_packages_store
  mapfile -t PKGS < "$PACKAGES_FILE"
  if [ ${#PKGS[@]} -eq 0 ]; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return
  fi

  read -p "  Enter package number to edit : " EDIT_IDX
  if ! [[ "$EDIT_IDX" =~ ^[0-9]+$ ]] || [ "$EDIT_IDX" -lt 1 ] || [ "$EDIT_IDX" -gt "${#PKGS[@]}" ]; then
    echo -e "\n ${R}[!] Invalid package number!${N}"
    sleep 1
    return
  fi

  local ARR_POS=$((EDIT_IDX - 1))
  local OLD_PKG="${PKGS[$ARR_POS]}"
  read -p "  New package name (current: ${OLD_PKG}) : " NEW_PKG
  NEW_PKG=$(echo "$NEW_PKG" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  if [ -z "$NEW_PKG" ]; then
    echo -e "\n ${R}[!] Package name cannot be empty!${N}"
    sleep 1
    return
  fi

  PKGS[$ARR_POS]="$NEW_PKG"
  printf "%s\n" "${PKGS[@]}" > "$PACKAGES_FILE"
  sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE"
  awk -F'|' -v old="$OLD_PKG" -v new="$NEW_PKG" 'BEGIN{OFS="|"} {if ($3==old) $3=new; print}' "$ACCOUNT_PKG_DB" > "${ACCOUNT_PKG_DB}.tmp" && mv "${ACCOUNT_PKG_DB}.tmp" "$ACCOUNT_PKG_DB"
  echo -e "\n ${G}[✓] Updated #${EDIT_IDX} to '${NEW_PKG}'.${N}"
  sleep 1
}

delete_package_name() {
  init_packages_store
  mapfile -t PKGS < "$PACKAGES_FILE"
  if [ ${#PKGS[@]} -eq 0 ]; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return
  fi

  read -p "  Enter package number to delete : " DEL_IDX
  if ! [[ "$DEL_IDX" =~ ^[0-9]+$ ]] || [ "$DEL_IDX" -lt 1 ] || [ "$DEL_IDX" -gt "${#PKGS[@]}" ]; then
    echo -e "\n ${R}[!] Invalid package number!${N}"
    sleep 1
    return
  fi

  local ARR_POS=$((DEL_IDX - 1))
  local REM_PKG="${PKGS[$ARR_POS]}"
  unset 'PKGS[$ARR_POS]'
  if [ ${#PKGS[@]} -gt 0 ]; then
    printf "%s\n" "${PKGS[@]}" > "$PACKAGES_FILE"
  else
    : > "$PACKAGES_FILE"
  fi
  sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE"
  echo -e "\n ${G}[✓] Deleted package '${REM_PKG}'. Accounts using it will report error until updated.${N}"
  sleep 1
}

