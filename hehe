  echo -e "${C}║${N}  ${W}[3]${N} List Accounts                          ${C}║${N}"
  echo -e "${C}║${N}  ${W}[4]${N} Renew Account                          ${C}║${N}"
  echo -e "${C}║${N}  ${W}[0]${N} Back to Main Menu                      ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════════╝${N}"
  read -p " Choose : " ch
  case $ch in
    1) create_vmess ;;
    2) delete_xray ;;
    3) list_xray ;;
    4) renew_xray ;;
    0) main_menu ;;
    *) v2ray_menu ;;
  esac
}

create_vmess() {
  clear
  source "$CONFIG_FILE"
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e "${W} Create VMess Account ${N}"
  echo -e "${C}════════════════════════════════════════════════${N}"
  read -p " Username : " user

  # Check if exists in db
  if grep -q "^vmess $user " /etc/xray/accounts.db 2>/dev/null; then
    echo -e "${R} Error: Username already exists!${N}"
    press_enter
    v2ray_menu
  fi

  read -p " Expire (Days) : " days
  uuid=$(cat /proc/sys/kernel/random/uuid)
  exp=$(date -d "+$days days" +"%Y-%m-%d")

  # Add to JSON using jq/python
  python3 -c "
import json
with open('/usr/local/etc/xray/config.json', 'r') as f: data = json.load(f)
for ib in data['inbounds']:
    if ib['protocol'] == 'vmess':
        ib['settings']['clients'].append({'id': '$uuid', 'alterId': 0, 'email': '$user'})
with open('/usr/local/etc/xray/config.json', 'w') as f: json.dump(data, f, indent=2)
"

  # Add to internal DB
  echo "vmess $user $exp $uuid" >> /etc/xray/accounts.db
  systemctl restart xray > /dev/null 2>&1

  # Generate Vmess link (JSON config for app)
  cat > /tmp/vmcfg.json << EOF
{
  "v": "2",
  "ps": "$user - Blu-2026",
  "add": "${HOST}",
  "port": "80",
  "id": "${uuid}",
  "aid": "0",
  "scy": "auto",
  "net": "ws",
  "type": "none",
  "host": "${HOST}",
  "path": "/vmess",
  "tls": "none",
  "sni": "",
  "alpn": ""
}
EOF
  link="vmess://$(cat /tmp/vmcfg.json | base64 -w 0)"
  rm -f /tmp/vmcfg.json

  clear
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e "${G} VMess Account Created! ${N}"
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e " Username : $user"
  echo -e " UUID     : $uuid"
  echo -e " Expire   : $exp"
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e " Link: ${link}"
  echo -e "${C}════════════════════════════════════════════════${N}"
  press_enter
  v2ray_menu
}

delete_xray() {
  clear
  read -p " Username to delete : " user
  if grep -q " $user " /etc/xray/accounts.db; then
    sed -i "/ $user /d" /etc/xray/accounts.db
    # Remove from JSON
    python3 -c "
import json
with open('/usr/local/etc/xray/config.json', 'r') as f: data = json.load(f)
for ib in data['inbounds']:
    ib['settings']['clients'] = [c for c in ib['settings']['clients'] if c.get('email') != '$user']
with open('/usr/local/etc/xray/config.json', 'w') as f: json.dump(data, f, indent=2)
"
    systemctl restart xray > /dev/null 2>&1
    echo -e "${G} [✓] Deleted successfully!${N}"
  else
    echo -e "${R} [!] User not found!${N}"
  fi
  press_enter
  v2ray_menu
}

list_xray() {
  clear
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e "${W} List Xray Accounts ${N}"
  echo -e "${C}════════════════════════════════════════════════${N}"
  if [ -f /etc/xray/accounts.db ]; then
    while read type user exp uuid; do
      if [ -n "$user" ]; then
        printf " %-7s %-15s %s\n" "$type" "$user" "$exp"
      fi
    done < /etc/xray/accounts.db
  fi
  echo -e "${C}════════════════════════════════════════════════${N}"
  press_enter
  v2ray_menu
}

renew_xray() {
  clear
  read -p " Username to renew : " user
  if grep -q " $user " /etc/xray/accounts.db; then
    read -p " Extend (Days) : " days
    exp=$(date -d "+$days days" +"%Y-%m-%d")
    # Update DB file inline
    awk -v u="$user" -v e="$exp" '{if ($2==u) {$3=e}; print $0}' /etc/xray/accounts.db > /tmp/xdb
    mv /tmp/xdb /etc/xray/accounts.db
    systemctl restart xray > /dev/null 2>&1
    echo -e "${G} [✓] Renewed until $exp!${N}"
  else
    echo -e "${R} [!] User not found!${N}"
  fi
  press_enter
  v2ray_menu
}

