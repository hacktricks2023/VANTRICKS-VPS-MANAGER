  spin() {
    local pid=$1
    local i=0
    local sp='-\|/'
    while kill -0 $pid 2>/dev/null; do
      printf "\r [${sp:$i:1}] Please wait..."
      i=$(( (i+1) % 4 ))
      sleep 0.3
