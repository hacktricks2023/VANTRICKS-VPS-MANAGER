}

v2ray_delete_by_proto() {
  FILTER_PROTO="$1"
  touch "$XRAY_DB"
  while true; do
    clear
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${W}        DELETE ${FILTER_PROTO^^} USER                  ${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"

    VACCS=()
    IDX=1
    NOW_S=$(date +%s)

    while IFS= read -r line; do
      [ -z "$line" ] && continue
      vuser=$(echo "$line" | awk '{print $1}')
      vuuid=$(echo "$line" | awk '{print $2}')
      NCOLS=$(echo "$line" | awk '{print NF}')
      if [ "$NCOLS" -ge 5 ]; then
        vexpiry=$(echo "$line" | awk '{print $3" "$4}')
        vproto=$(echo "$line" | awk '{print $5}')
      else
        vexpiry=$(echo "$line" | awk '{print $3}')
        vproto=$(echo "$line" | awk '{print $4}')
      fi
      if [ "$vproto" == "$FILTER_PROTO" ]; then
        EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null || echo 0)
        SECS_LEFT=$(( EXP_S - NOW_S ))
        if [ "$SECS_LEFT" -le 0 ]; then
          TIME_LEFT="${R}EXPIRED${N}"
        else
          D=$(( SECS_LEFT/86400 ))
          H=$(( (SECS_LEFT%86400)/3600 ))
          M=$(( (SECS_LEFT%3600)/60 ))
          TIME_LEFT="${G}${D}d ${H}h ${M}m${N}"
        fi
        if [ "$FILTER_PROTO" == "trojan" ]; then
          DISPLAY_NAME="$vuuid"
        else
          DISPLAY_NAME="$vuser"
        fi
        VP_NAME=$(get_account_package "$FILTER_PROTO" "$vuuid")
        echo -e " ${W}[$IDX]${N} $DISPLAY_NAME  | Pkg: ${G}${VP_NAME:-NONE}${N} ($TIME_LEFT)"
        VACCS+=("$vuser:$vuuid:$vexpiry:$vproto")
        IDX=$((IDX + 1))
      fi
    done < "$XRAY_DB"

    if [ ${#VACCS[@]} -eq 0 ]; then
      echo -e " ${Y} No ${FILTER_PROTO^^} accounts found.${N}"
      press_enter; return
    fi

    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e " ${W}[e]${N} Remove all expired ${FILTER_PROTO^^} users"
    echo -e " ${W}[A]${N} Remove all ${FILTER_PROTO^^} users (force)"
    echo -e " ${W}[0]${N} Return"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    read -p " Option: " DOPT

    if [ "$DOPT" == "0" ]; then
      break
    elif [ "$DOPT" == "e" ]; then
      COUNT=0
      NOW_S=$(date +%s)
      TMP=$(mktemp)
      while IFS= read -r line; do
        [ -z "$line" ] && continue
        vuser=$(echo "$line" | awk '{print $1}')
        vuuid=$(echo "$line" | awk '{print $2}')
        NCOLS=$(echo "$line" | awk '{print NF}')
        if [ "$NCOLS" -ge 5 ]; then
          vexpiry=$(echo "$line" | awk '{print $3" "$4}')
          vproto=$(echo "$line" | awk '{print $5}')
        else
          vexpiry=$(echo "$line" | awk '{print $3}')
          vproto=$(echo "$line" | awk '{print $4}')
        fi
        EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null || echo 0)
        if [ "$vproto" == "$FILTER_PROTO" ] && [ "$EXP_S" -le "$NOW_S" ]; then
          remove_account_package "$FILTER_PROTO" "$vuuid"
          COUNT=$((COUNT + 1))
        else
          echo "$line" >> "$TMP"
        fi
      done < "$XRAY_DB"
      mv "$TMP" "$XRAY_DB"
      systemctl restart xray > /dev/null 2>&1
      echo -e "\n ${G}[✓] Removed $COUNT expired ${FILTER_PROTO^^} users!${N}"
      sleep 2
    elif [ "$DOPT" == "A" ]; then
      TMP=$(mktemp)
      grep -v " ${FILTER_PROTO}$" "$XRAY_DB" > "$TMP" 2>/dev/null || true
      mv "$TMP" "$XRAY_DB"
      sed -i "/^${FILTER_PROTO}|/d" "$ACCOUNT_PKG_DB" 2>/dev/null || true
      python3 - << PYEOF
import json
path = "$XRAY_CONF"
try:
    with open(path) as f:
        cfg = json.load(f)
    for inb in cfg.get("inbounds", []):
        if "$FILTER_PROTO" == "xhttp" and inb.get("streamSettings", {}).get("network") == "xhttp":
            inb["settings"]["clients"] = []
        elif inb.get("protocol") == "$FILTER_PROTO":
            inb["settings"]["clients"] = []
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
except Exception:
    pass
PYEOF
      systemctl restart xray > /dev/null 2>&1
      echo -e "\n ${G}[✓] All ${FILTER_PROTO^^} users removed!${N}"
      sleep 2
    elif [[ "$DOPT" =~ ^[0-9]+$ ]] && [ "$DOPT" -ge 1 ] && [ "$DOPT" -lt "$IDX" ]; then
      TARGET="${VACCS[$((DOPT - 1))]}"
      DEL_USER=$(echo "$TARGET" | cut -d: -f1)
      DEL_UUID=$(echo "$TARGET" | cut -d: -f2)
      DEL_PROTO=$(echo "$TARGET" | cut -d: -f4)

      sed -i "/^${DEL_USER} /d" "$XRAY_DB"
      remove_account_package "$DEL_PROTO" "$DEL_UUID"

      python3 - << PYEOF
import json
path = "$XRAY_CONF"
proto = "$DEL_PROTO"
uuid_val = "$DEL_UUID"
try:
    with open(path) as f:
        cfg = json.load(f)
    for inb in cfg.get("inbounds", []):
        if proto == "xhttp" and inb.get("streamSettings", {}).get("network") == "xhttp":
            clients = inb["settings"].get("clients", [])
            inb["settings"]["clients"] = [c for c in clients if c.get("id") != uuid_val]
        elif inb.get("protocol") == proto:
            clients = inb["settings"].get("clients", [])
            if proto in ["vless", "vmess"]:
                inb["settings"]["clients"] = [c for c in clients if c.get("id") != uuid_val]
            else:
                inb["settings"]["clients"] = [c for c in clients if c.get("password") != uuid_val]
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
except Exception:
    pass
PYEOF
      systemctl restart xray > /dev/null 2>&1
      echo -e "\n ${G}[✓] User '$DEL_USER' deleted!${N}"
      sleep 2
    else
      echo -e "\n${R} [!] Invalid option!${N}"
      sleep 1
    fi
  done
}

