            systemctl restart ws-proxy-8080 xray dnstt ssh-dnstt slipstream-rust nginx stunnel4 openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1 || true
            systemctl restart sslh > /dev/null 2>&1 || systemctl restart sslh-select > /dev/null 2>&1 || true

            trigger_auto_reboot "Domain ('$NEW_HOST') & NS ('$NEW_NS') saved. Rebooting..."
            ;;
          *)
            echo -e "\n ${Y}[!] Cancelled.${N}"
            sleep 1
            ;;
        esac
        ;;
      2)
        local OLD_H="$HOST"
        local OLD_N="$NAMESERVER"

        set_config_kv "HOST" "$DEF_H"
        set_config_kv "NAMESERVER" "$DEF_N"
        set_config_kv "PROTO_SSH" "ON"
        set_config_kv "PROTO_OVPN" "ON"
        set_config_kv "PROTO_SSL" "ON"
        set_config_kv "PROTO_MUX" "ON"
        set_config_kv "PROTO_WS" "ON"
        set_config_kv "PROTO_NGINX" "ON"
        set_config_kv "PROTO_XRAY" "ON"
        set_config_kv "PROTO_XHTTP" "ON"
        set_config_kv "PROTO_DNSTT" "ON"
        set_config_kv "PROTO_SSH_DNSTT" "ON"
        set_config_kv "PROTO_SLIPSTREAM" "ON"
        set_config_kv "BOOSTER_ENABLED" "ON"
        set_config_kv "REDIRECT_301" "ON"

        purge_old_domain_references "$OLD_H" "$OLD_N" "$DEF_H" "$DEF_N"
        sync_host_config
        apply_enhancement_booster
        apply_banner_config
        systemctl restart ws-proxy-8080 xray dnstt ssh-dnstt slipstream-rust nginx stunnel4 openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1 || true
        systemctl restart sslh > /dev/null 2>&1 || systemctl restart sslh-select > /dev/null 2>&1 || true

        trigger_auto_reboot "Reset to default Domain ('$DEF_H') & NS ('$DEF_N'). Rebooting..."
        ;;
      0)
        break
        ;;
      *)
        echo -e "\n ${R}[!] Invalid option!${N}"
        sleep 1
        ;;
    esac
  done
}

