        data = client.recv(BUFFER)
        if not data:
            client.close()
            return

        # Check if it's a V2Ray WS path - forward to nginx
        is_v2ray = False
        is_http = data[:4] in (b'GET ', b'POST', b'HEAD', b'CONN')
        is_websocket = b'Upgrade: websocket' in data or b'upgrade: websocket' in data

        if is_http:
            for path in V2RAY_PATHS:
                if path in data:
                    is_v2ray = True
                    break

        if is_v2ray:
            # Forward to nginx for V2Ray
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            target.connect((SSH_HOST, NGINX_PORT))
            target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
        elif is_http and not is_websocket:
            # Plain HTTP - always send plain response for response checkers
            client.send(RESPONSE_PLAIN)
            client.close()
            return
        else:
            # SSH with or without payload
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            target.connect((SSH_HOST, SSH_PORT))
            if is_http:
                # HTTP payload with websocket - send colored 101 response then tunnel
                client.send(RESPONSE_COLOR)
            else:
                # Raw SSH - forward data directly
                target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
    except:
        try: client.close()
        except: pass

def start(port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(('0.0.0.0', port))
    srv.listen(200)
    while True:
        try:
            c, _ = srv.accept()
            threading.Thread(target=handle, args=(c,), daemon=True).start()
        except:
            pass

if __name__ == '__main__':
    start(LISTEN_PORT)
PYEOF

  chmod +x /usr/local/bin/ws-proxy.py

  for PORT in 8080; do
    cat > /etc/systemd/system/ws-proxy-${PORT}.service << EOF
[Unit]
Description=WebSocket Proxy Port ${PORT}
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/ws-proxy.py ${PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
    systemctl enable ws-proxy-${PORT} > /dev/null 2>&1
    systemctl start ws-proxy-${PORT} > /dev/null 2>&1
  done

  echo -e " ${G}[✓] WebSocket proxy running on port 8080${N}"
}

