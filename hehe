# ══════════════════════════════════════════════
#   ACCOUNT MULTIPLEXER (AUTO)  -  1 account = many devices / many protocols, no fighting, no new port
#   * Auto device slots for EVERY account (uses the Online Limit given at creation, no manual limiting)
#   * OpenVPN: duplicate-cn -> every device of the same account gets its OWN virtual IP (no IP fight / no kick)
#   * Guard (out-of-band service): counts SSH + WS + SSL + DNSTT + OVPN devices together, removes the extra ones
#   * Opens NO TCP/UDP port and adds NO hop (so nothing can clash with SSH / WS / SSL / DNSTT)
# ══════════════════════════════════════════════

ui_opt() { ui_row "  ${Y}[$1]${N} ${W}$(printf '%-24s' "$2")${N}${3}"; }   # [n] Label ........ value

install_mux_python() {
  local TMP
  TMP=$(mktemp) || return 1
  cat > "$TMP" << 'MUXPY'
#!/usr/bin/env python3
# ACERO Account Multiplexer (Auto) - helper for vantricks_manager.sh   MUX_PY_VERSION=1
#   1 account = many devices / many protocols, no fighting, no new port.
#   Out-of-band: it only LOOKS at sessions and removes the extra ones. It never sits in the data path.
import json
import os
import re
import signal
import socket
import ssl
import subprocess
import sys
import time

CONF = "/etc/vantricks_script.conf"
DB = "/etc/vantricks_mux_limits.db"
LOG = "/var/log/vantricks-mux.log"
STATE = "/run/vantricks-mux.state"
SSHD_CONF = "/etc/ssh/sshd_config"
XRAY_CONF = "/usr/local/etc/xray/config.json"
OVPN = {
    "udp": ("OVPN-UDP", "/run/openvpn-server/acero-mux-udp.sock", "/var/log/openvpn/openvpn-udp-status.log"),
    "tcp": ("OVPN-TCP", "/run/openvpn-server/acero-mux-tcp.sock", "/var/log/openvpn/openvpn-tcp-status.log"),
}
LOOP = ("127.0.0.1", "::1", "localhost")
DETAIL = {
    "MUX": "via 80/443", "WS/SSL": "via 8080", "SSH+DNSTT": "via 5301",
    "DNSTT": "via 53", "SLIPSTREAM": "via 5302", "SSL": "via 443",
}


# ───────────────────────── small helpers ─────────────────────────
def sh(args, timeout=6):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except Exception:
        return ""


def conf():
    d = {}
    try:
        with open(CONF) as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#") or "=" not in ln:
                    continue
                k, v = ln.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                d[k.strip()] = v
    except OSError:
        pass
    return d


def to_int(v, default):
    try:
        return int(str(v).strip())
    except Exception:
        return default


def fmt_age(s):
    if s is None or s < 0:
        return "-"
    if s < 60:
        return "%ds" % s
    if s < 3600:
        return "%dm" % (s // 60)
    if s < 86400:
        return "%dh%02dm" % (s // 3600, (s % 3600) // 60)
    return "%dd%02dh" % (s // 86400, (s % 86400) // 3600)


def norm(addr):
    """'[::ffff:127.0.0.1]:22' -> ('127.0.0.1', '22')"""
    if ":" not in addr:
        return addr, ""
    host, port = addr.rsplit(":", 1)
    host = host.strip("[]").replace("::ffff:", "")
    return host, port


def accounts():
    out = {}
    try:
        with open("/etc/passwd") as f:
            for ln in f:
                p = ln.split(":")
                if len(p) >= 3 and p[2].isdigit() and int(p[2]) >= 1000 and p[0] != "nobody":
                    out[p[0]] = int(p[2])
    except OSError:
        pass
    return out


def log(kind, *fields):
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > 200000:
            with open(LOG) as f:
                keep = f.readlines()[-200:]
            with open(LOG, "w") as f:
                f.writelines(keep)
        with open(LOG, "a") as f:
            f.write("|".join([time.strftime("%Y-%m-%d %H:%M:%S"), kind] + [str(x) for x in fields]) + "\n")
    except OSError:
        pass


# ───────────────────────── limits ─────────────────────────
def read_db():
    d = {}
    try:
        with open(DB) as f:
            for ln in f:
                p = ln.split()
                if len(p) >= 2 and p[1].isdigit():
                    d[p[0]] = int(p[1])
    except OSError:
        pass
    return d


def write_db(d):
    tmp = DB + ".tmp"
    with open(tmp, "w") as f:
        for k in sorted(d):
            f.write("%s %d\n" % (k, d[k]))
    os.chmod(tmp, 0o600)
    os.replace(tmp, DB)


def maxsessions():
    """Online Limit chosen when the account was created (Match User ... MaxSessions N)."""
    res, cur = {}, None
    try:
        with open(SSHD_CONF) as f:
            for ln in f:
                s = ln.strip()
                m = re.match(r"^Match\s+User\s+(\S+)", s, re.I)
                if m:
                    cur = m.group(1)
                    continue
                if s.lower().startswith("match "):
                    cur = None
                    continue
                m = re.match(r"^MaxSessions\s+(\d+)", s, re.I)
                if m and cur and int(m.group(1)) >= 1:
                    res[cur] = int(m.group(1))
    except OSError:
        pass
    return res


def limit_for(user, db, ms, default):
    if user in db:
        return db[user], "custom"
    if user in ms:
        return ms[user], "auto"
    return default, "default"


# ───────────────────────── sessions ─────────────────────────
def parse_ps(text):
    rows = []
    for ln in text.splitlines():
        p = ln.strip().split(None, 3)
        if len(p) >= 4 and p[0].isdigit() and p[1].isdigit() and p[2].isdigit():
            rows.append((int(p[0]), int(p[1]), int(p[2]), p[3]))
    return rows


RE_SESS = re.compile(r"^sshd(?:-session)?: ([A-Za-z0-9_.-]+)@")


def ssh_conns(rows, users):
    """One entry per authenticated TCP connection (a connection may carry several channels)."""
    ages = {pid: age for pid, _, age, _ in rows}
    by = {}
    for pid, ppid, age, args in rows:
        m = RE_SESS.match(args)
        if not m or m.group(1) not in users:
            continue
        c = by.setdefault((m.group(1), ppid), {
            "kind": "ssh", "user": m.group(1), "priv": ppid, "pids": [], "age": age, "killable": True})
        c["pids"].append(pid)
        c["age"] = max(ages.get(ppid, age), age)
    return list(by.values())


def parse_ss(text):
    recs = []
    for ln in text.splitlines():
        t = ln.split()
        if len(t) < 5 or not t[0].startswith("ESTAB"):
            continue
        users = " ".join(t[5:])
        m = re.search(r'\("([^"]+)"', users)
        recs.append({"local": t[3], "peer": t[4],
                     "pids": [int(x) for x in re.findall(r"pid=(\d+)", users)],
                     "comm": m.group(1) if m else ""})
    return recs


def cmdline(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return f.read().replace(b"\0", b" ").decode("utf-8", "replace").strip()
    except OSError:
        return ""


def owner_kind(rec, cmd_fn=cmdline):
    for pid in rec["pids"] or [0]:
        cl = cmd_fn(pid) if pid else ""
        s = (rec["comm"] + " " + cl).lower()
        if "slipstream" in s:
            return "SLIPSTREAM"
        if "dnstt" in s:
            return "DNSTT"
        if "ws-proxy" in s:
            m = re.search(r"ws-proxy\.py\s+(\d+)", cl)
            return "SSH+DNSTT" if (m and m.group(1) == "5301") else "WS/SSL"
        if "sslh" in s:
            return "MUX"
        if "stunnel" in s:
            return "SSL"
    return (rec["comm"] or "LOCAL").upper()[:10]


def classify_ssh(c, ss, cmd_fn=cmdline):
    pids = set([c["priv"]] + c["pids"])
    rec = None
    for r in ss:
        if pids & set(r["pids"]) and norm(r["local"])[1] == "22":
            rec = r
            break
    if not rec:
        return "SSH", "-"
    host, port = norm(rec["peer"])
    if host not in LOOP:
        return "SSH", host
    for r in ss:
        if r is not rec and norm(r["local"]) == (host, port):
            k = owner_kind(r, cmd_fn)
            return k, DETAIL.get(k, "local")
    return "TUNNEL", "local"


# ───────────────────────── OpenVPN (management socket, status-file fallback) ─────────────────────────
def mgmt(path, cmd, until, timeout=3.0):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.4)
        s.connect(path)
        try:
            s.recv(4096)  # greeting
        except socket.timeout:
            pass
        s.settimeout(timeout)
        s.sendall((cmd + "\n").encode())
        out, end = "", time.time() + timeout
        while time.time() < end:
            try:
                chunk = s.recv(65536)
            except socket.timeout:
                break
            if not chunk:
                break
            out += chunk.decode("utf-8", "replace")
            if re.search(until, out, re.M):
                break
        try:
            s.sendall(b"quit\n")
        except OSError:
            pass
        s.close()
        return out
    except Exception:
        return None


def parse_status2(text, label):
    out = []
    for ln in text.splitlines():
        if ln.startswith("CLIENT_LIST,"):
            p = ln.rstrip("\r").split(",")
            if len(p) >= 9:
                out.append({"user": p[1], "real": p[2], "vip": p[3],
                            "since": int(p[8]) if p[8].isdigit() else 0, "proto": label})
    return out


def parse_status1(text, label):
    clients, routes, sect = [], {}, None
    for ln in text.splitlines():
        ln = ln.rstrip("\r")
        if ln.startswith("Common Name,"):
            sect = "c"
            continue
        if ln.startswith("Virtual Address,"):
            sect = "r"
            continue
        if ln.startswith("ROUTING TABLE") or ln.startswith("GLOBAL STATS") or ln == "END":
            sect = None
            continue
        p = ln.split(",")
        if sect == "c" and len(p) >= 2:
            clients.append((p[0], p[1]))
        elif sect == "r" and len(p) >= 3:
            routes[(p[1], p[2])] = p[0]
    return [{"user": u, "real": r, "vip": routes.get((u, r), "-"), "since": 0, "proto": label} for u, r in clients]


def ovpn_conns():
    out = []
    for label, sock, stf in OVPN.values():
        rows, killable = None, False
        if os.path.exists(sock):
            txt = mgmt(sock, "status 2", r"^END")
            if txt and re.search(r"^END", txt, re.M):
                rows, killable = parse_status2(txt, label), True
        if rows is None:
            try:
                if time.time() - os.path.getmtime(stf) < 180:
                    with open(stf) as f:
                        rows = parse_status1(f.read(), label)
            except OSError:
                pass
            rows = rows or []
        for r in rows:
            r.update(kind="ovpn", killable=killable, sock=sock, detail=r["vip"], age=-1)
            out.append(r)
    return out


def collect():
    cfg = conf()
    users = accounts()
    ps = parse_ps(sh(["ps", "-eo", "pid=,ppid=,etimes=,args="]))
    ss = parse_ss(sh(["ss", "-tnpH"]))
    devs = {}
    for c in ssh_conns(ps, users):
        c["proto"], c["detail"] = classify_ssh(c, ss)
        devs.setdefault(c["user"], []).append(c)
    now = time.time()
    for o in ovpn_conns():
        if o["user"] in users:
            o["age"] = int(now - o["since"]) if o["since"] else -1
            devs.setdefault(o["user"], []).append(o)
    for u in devs:
        devs[u].sort(key=lambda d: -d["age"])  # oldest first, unknown age last
    db, ms = read_db(), maxsessions()
    dl = max(1, to_int(cfg.get("MUX_DEFAULT_LIMIT"), 2))
    limits = {u: limit_for(u, db, ms, dl) for u in users}
    return cfg, users, devs, limits


# ───────────────────────── enforcement ─────────────────────────
def decide_kills(devs, limits, policy, strikes):
    """Over the limit for 2 checks in a row -> remove the extra device(s). Default: keep the newest."""
    kills = []
    for user, lst in devs.items():
        lim = limits.get(user, (0, ""))[0]
        if lim <= 0 or len(lst) <= lim:
            strikes.pop(user, None)
            continue
        strikes[user] = strikes.get(user, 0) + 1
        if strikes[user] < 2:
            continue
        excess = len(lst) - lim
        order = list(lst) if policy != "OLDEST" else list(reversed(lst))  # first = next to remove
        victims = [d for d in order if d.get("killable")][:excess]
        kills += [(user, d, lim) for d in victims]
    return kills


def kill_dev(d):
    if d["kind"] == "ssh":
        for pid in d["pids"] + [d["priv"]]:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        return True
    r = mgmt(d["sock"], "kill " + d["real"], r"^(SUCCESS|ERROR)")
    return bool(r and "SUCCESS" in r)


def step(strikes):
    cfg, users, devs, limits = collect()
    for user, d, lim in decide_kills(devs, limits, cfg.get("MUX_POLICY", "NEWEST"), strikes):
        if kill_dev(d):
            log("kick", user, d.get("proto", "?"), fmt_age(d["age"]), lim)
            strikes[user] = 0
    try:
        with open(STATE, "w") as f:
            f.write("%d|%d" % (time.time(), sum(len(v) for v in devs.values())))
    except OSError:
        pass


def guard():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    strikes = {}
    while True:
        if conf().get("MUX_AUTO", "OFF") != "ON":
            strikes.clear()
            time.sleep(5)
            continue
        try:
            step(strikes)
        except Exception as e:  # never die
            log("error", repr(e)[:80])
        time.sleep(4)


# ───────────────────────── port conflicts ─────────────────────────
def listeners():
    res = {}
    for ln in sh(["ss", "-H", "-ltnup"]).splitlines():
        t = ln.split()
        if len(t) < 5:
            continue
        proto = "udp" if t[0].startswith("udp") else "tcp"
        _, port = norm(t[4])
        m = re.search(r'\("([^"]+)"', " ".join(t[6:]))
        res.setdefault((proto, port), []).append(m.group(1) if m else "?")
    return res


def xray_ports():
    try:
        with open(XRAY_CONF) as f:
            return [int(i["port"]) for i in json.load(f).get("inbounds", []) if "port" in i]
    except Exception:
        return []


def port_rows(cfg, lis):
    on = lambda k: cfg.get(k, "ON") != "OFF"
    spec = [
        ("SSH", 22, "tcp", ("sshd",), "PROTO_SSH"),
        ("MUX 80", 80, "tcp", ("sslh",), "PROTO_MUX"),
        ("MUX 443", 443, "tcp", ("sslh",), "PROTO_MUX"),
        ("WebSocket", 8080, "tcp", ("python",), "PROTO_WS"),
        ("SSL stunnel", 7443, "tcp", ("stunnel",), "PROTO_SSL"),
        ("Nginx", 8880, "tcp", ("nginx",), "PROTO_NGINX"),
        ("OVPN TCP", 11940, "tcp", ("openvpn",), "PROTO_OVPN"),
        ("OVPN UDP", 1194, "udp", ("openvpn",), "PROTO_OVPN"),
        ("SSH+DNSTT", 5301, "tcp", ("python",), "PROTO_SSH_DNSTT"),
        ("Slipstream", 5302, "tcp", ("slipstream", "python"), "PROTO_SLIPSTREAM"),
        ("DNSTT", 53, "udp", ("dnstt",), "PROTO_DNSTT"),
    ]
    rows = []
    for name, port, proto, exp, tog in spec:
        comms = lis.get((proto, str(port)), [])
        hit = [c for c in comms if any(e in c.lower() for e in exp)]
        if hit:
            st, who = "ok", hit[0]
        elif comms:
            st, who = "conflict", comms[0]
        else:
            st, who = ("off" if not on(tog) else "down"), "-"
        if not on(tog) and not comms:
            st = "off"
        rows.append((name, "%d/%s" % (port, proto), who, st))
    xp = xray_ports()
    if xp:
        bad = [p for p in xp if not [c for c in lis.get(("tcp", str(p)), []) if "xray" in c.lower()]]
        foreign = [p for p in bad if lis.get(("tcp", str(p)))]
        st = "conflict" if foreign else ("down" if bad else "ok")
        if not on("PROTO_XRAY") and not foreign:
            st = "off"
        lo, hi = str(min(xp)), str(max(xp))
        k = next((i for i in range(min(len(lo), len(hi))) if lo[i] != hi[i]), len(hi))
        rows.append(("Xray x%d" % len(xp), lo if lo == hi else "%s-%s" % (lo, hi[k:]), "xray" if st == "ok" else "-", st))
    return rows


# ───────────────────────── low latency ─────────────────────────
def file_has(path, needle):
    try:
        with open(path, "rb") as f:
            return needle.encode() in f.read()
    except OSError:
        return False


def tcp_ping(port, n=3):
    best = None
    for _ in range(n):
        t = time.perf_counter()
        try:
            s = socket.create_connection(("127.0.0.1", port), timeout=1.0)
        except OSError:
            return None
        dt = (time.perf_counter() - t) * 1000
        s.close()
        best = dt if best is None else min(best, dt)
    return best


def banner_probe(port, ws=False, tls=False, hello=False):
    """ms until the SSH banner shows up through the protocol path (None = path broken)."""
    t0 = time.perf_counter()
    try:
        s = socket.create_connection(("127.0.0.1", port), timeout=3.0)
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        if tls:
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            s = ctx.wrap_socket(s)
        if ws:
            s.sendall(b"GET / HTTP/1.1\r\nHost: acero.local\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
        if hello:
            s.sendall(b"SSH-2.0-acero-check\r\n")
        buf = b""
        while b"SSH-" not in buf[-4096:] and len(buf) < 8192:
            d = s.recv(4096)
            if not d:
                break
            buf += d
        s.close()
        return (time.perf_counter() - t0) * 1000 if b"SSH-" in buf else None
    except Exception:
        return None


def lat_row(name, ms, nodelay, note_fix, listening=True):
    if not listening or ms is None:
        return ("L", name, "fail", "-", "not answering")
    if nodelay is False:
        return ("L", name, "fix", "%.1f" % ms, note_fix)
    if ms >= 100:
        return ("L", name, "slow", "%.1f" % ms, "slower than 100 ms on this server")
    return ("L", name, "ok", "up" if ms == 0.0 else "%.1f" % ms, "")


def latency_rows(cfg):
    lis = listeners()
    up = lambda proto, port: bool(lis.get((proto, str(port))))
    off = lambda k: cfg.get(k, "ON") == "OFF"
    rows = []

    def add(tog, name, ms, nd, fixnote, listening=True):
        rows.append(("L", name, "off", "-", "") if off(tog) else lat_row(name, ms, nd, fixnote, listening))

    add("PROTO_SSH", "SSH 22", banner_probe(22), True, "")
    add("PROTO_WS", "WebSocket 8080", banner_probe(8080, ws=True), file_has("/usr/local/bin/ws-proxy.py", "TCP_NODELAY"), "TCP_NODELAY missing")
    add("PROTO_MUX", "MUX 80 > WS", banner_probe(80, ws=True), None, "")
    add("PROTO_SSL", "SSL 443 > WS", banner_probe(443, ws=True, tls=True), file_has("/etc/stunnel/stunnel.conf", "TCP_NODELAY"), "stunnel TCP_NODELAY missing")
    add("PROTO_SSH_DNSTT", "SSH+DNSTT 5301", banner_probe(5301, hello=True), file_has("/usr/local/bin/ws-proxy.py", "TCP_NODELAY"), "TCP_NODELAY missing")
    add("PROTO_SLIPSTREAM", "Slipstream 5302", tcp_ping(5302), file_has("/usr/local/bin/slipstream-server", "TCP_NODELAY"), "TCP_NODELAY missing")
    add("PROTO_DNSTT", "DNSTT 53/udp", 0.0 if up("udp", 53) else None, None, "", up("udp", 53))
    add("PROTO_OVPN", "OVPN TCP 11940", tcp_ping(11940),
        file_has("/etc/openvpn/server/server-tcp.conf", "TCP_NODELAY") or file_has("/etc/openvpn/server/server-tcp.conf", "tcp-nodelay"),
        "socket-flags TCP_NODELAY missing")
    add("PROTO_OVPN", "OVPN UDP 1194", 0.0 if up("udp", 1194) else None, None, "", up("udp", 1194))
    add("PROTO_NGINX", "Nginx 8880", tcp_ping(8880), file_has("/etc/nginx/conf.d/v2ray.conf", "tcp_nodelay on"), "tcp_nodelay missing")
    xp = xray_ports()
    xnd = None
    try:
        with open(XRAY_CONF) as f:
            ibs = json.load(f).get("inbounds", [])
        xnd = all(i.get("streamSettings", {}).get("sockopt", {}).get("tcpNoDelay") is True for i in ibs) if ibs else None
    except Exception:
        pass
    add("PROTO_XRAY", "Xray WS/XHTTP", tcp_ping(xp[0]) if xp else None, xnd, "tcpNoDelay missing", bool(xp))
    return rows


def read1(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def system_rows():
    cc, qd = read1("/proc/sys/net/ipv4/tcp_congestion_control"), read1("/proc/sys/net/core/default_qdisc")
    tfo, lw = read1("/proc/sys/net/ipv4/tcp_fastopen"), read1("/proc/sys/net/ipv4/tcp_notsent_lowat")
    lwok = lw.isdigit() and int(lw) <= 131072
    return [
        ("Y", "BBR + queue", "ok" if cc == "bbr" and qd in ("fq", "fq_codel", "cake") else "fix", "%s/%s" % (cc or "?", qd or "?")),
        ("Y", "TCP Fast Open", "ok" if tfo in ("1", "3") else "fix", tfo or "?"),
        ("Y", "Send backlog", "ok" if lwok else "fix", lw or "?"),
    ]


