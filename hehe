v2ray_menu() {
  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}       ${W}Xray Management${N}                       ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  ${W}[1]${N} Create Vmess Account                   ${C}║${N}"
