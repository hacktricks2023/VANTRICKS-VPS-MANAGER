install_booster_python() {
  mkdir -p /usr/local/bin /etc/sysctl.d
  cat > "$BOOSTER_SCRIPT" << 'BOOSTERPY'
#!/usr/bin/env python3
import os
import re
import sys
import json
import time
import socket
import select
import threading
import subprocess
import urllib.request

SYSCTL_FILE = "/etc/sysctl.d/99-vantricks-booster.conf"
SNI_LIST_FILE = "/etc/vantricks_sni_proxy_hosts.list"
CONFIG_FILE = "/etc/vantricks_script.conf"
NGINX_CONF = "/etc/nginx/conf.d/v2ray.conf"
WS_PROXY_BIN = "/usr/local/bin/ws-proxy.py"
SLIPSTREAM_BIN = "/usr/local/bin/slipstream-server"
STUNNEL_CONF = "/etc/stunnel/stunnel.conf"
XRAY_CONF = "/usr/local/etc/xray/config.json"

