def parse_ps(text):
    rows = []
    for ln in text.splitlines():
        p = ln.strip().split(None, 3)
        if len(p) >= 4 and p[0].isdigit() and p[1].isdigit() and p[2].isdigit():
            rows.append((int(p[0]), int(p[1]), int(p[2]), p[3]))
    return rows


RE_SESS = re.compile(r"^sshd(?:-session)?: ([A-Za-z0-9_.-]+)@")


def ssh_conns(rows, users):
    ages = {pid: age for pid, _, age, _ in rows}
    by = {}
    for pid, ppid, age, args in rows:
        m = RE_SESS.match(args)
        if not m or m.group(1) not in users:
            continue
        c = by.setdefault((m.group(1), ppid), {
            "kind": "ssh", "user": m.group(1), "priv": ppid, "pids": [], "age": age, "killable": True})
        c["pids"].append(pid)
        c["age"] = max(ages.get(ppid, age), age)
    return list(by.values())


def parse_ss(text):
    recs = []
    for ln in text.splitlines():
        t = ln.split()
        if len(t) < 5 or not t[0].startswith("ESTAB"):
            continue
        users = " ".join(t[5:])
        m = re.search(r'\("([^"]+)"', users)
        recs.append({"local": t[3], "peer": t[4],
                     "pids": [int(x) for x in re.findall(r"pid=(\d+)", users)],
                     "comm": m.group(1) if m else ""})
    return recs


def cmdline(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return f.read().replace(b"\0", b" ").decode("utf-8", "replace").strip()
    except OSError:
        return ""


def owner_kind(rec, cmd_fn=cmdline):
    for pid in rec["pids"] or [0]:
        cl = cmd_fn(pid) if pid else ""
        s = (rec["comm"] + " " + cl).lower()
        if "slipstream" in s:
            return "SLIPSTREAM"
        if "dnstt" in s:
            return "DNSTT"
        if "ws-proxy" in s:
            m = re.search(r"ws-proxy\.py\s+(\d+)", cl)
            return "SSH+DNSTT" if (m and m.group(1) == "5301") else "WS/SSL"
        if "sslh" in s:
            return "MUX"
        if "stunnel" in s:
            return "SSL"
    return (rec["comm"] or "LOCAL").upper()[:10]


def classify_ssh(c, ss, cmd_fn=cmdline):
    pids = set([c["priv"]] + c["pids"])
    rec = None
    for r in ss:
        if pids & set(r["pids"]) and norm(r["local"])[1] == "22":
            rec = r
            break
    if not rec:
        return "SSH", "-"
    host, port = norm(rec["peer"])
    if host not in LOOP:
        return "SSH", host
    for r in ss:
        if r is not rec and norm(r["local"]) == (host, port):
            k = owner_kind(r, cmd_fn)
            return k, DETAIL.get(k, "local")
    return "TUNNEL", "local"


def mgmt(path, cmd, until, timeout=3.0):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.4)
        s.connect(path)
        try:
            s.recv(4096)
        except socket.timeout:
            pass
        s.settimeout(timeout)
        s.sendall((cmd + "\n").encode())
        out, end = "", time.time() + timeout
        while time.time() < end:
            try:
                chunk = s.recv(65536)
            except socket.timeout:
                break
            if not chunk:
                break
            out += chunk.decode("utf-8", "replace")
            if re.search(until, out, re.M):
                break
        try:
            s.sendall(b"quit\n")
        except OSError:
            pass
        s.close()
        return out
    except Exception:
        return None


