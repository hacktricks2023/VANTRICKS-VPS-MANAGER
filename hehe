def fmt_age(s):
    if s is None or s < 0:
        return "-"
    if s < 60:
        return "%ds" % s
    if s < 3600:
        return "%dm" % (s // 60)
    if s < 86400:
        return "%dh%02dm" % (s // 3600, (s % 3600) // 60)
    return "%dd%02dh" % (s // 86400, (s % 86400) // 3600)


def norm(addr):
    if ":" not in addr:
        return addr, ""
    host, port = addr.rsplit(":", 1)
