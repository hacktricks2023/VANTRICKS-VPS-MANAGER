  CPU_LOAD=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1 || echo "0")
  SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
}


# ══════════════════════════════════════════════
#   AUTO REMOVE EXPIRED
# ══════════════════════════════════════════════

auto_remove_expired() {
  local NOW_S=$(date +%s)
  # Remove expired SSH accounts
  while IFS=: read -r user _ uid _ _ _ _; do
    if [ "$uid" -ge 1000 ] && [ "$user" != "nobody" ]; then
      EXP=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
      if [ "$EXP" != "never" ] && [ -n "$EXP" ] && [ "$EXP" != "password must be changed" ]; then
        EXP_S=$(date -d "$EXP" +%s 2>/dev/null)
        if [ -n "$EXP_S" ] && [ "$EXP_S" -lt "$NOW_S" ]; then
          sed -i "/Match User $user/,/MaxSessions/d" /etc/ssh/sshd_config 2>/dev/null
          userdel -r "$user" > /dev/null 2>&1
        fi
      fi
    fi
  done < /etc/passwd
  # Remove expired xray accounts
  if [ -f /etc/xray/accounts.db ]; then
    TMP=$(mktemp)
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      NCOLS=$(echo "$line" | awk '{print NF}')
      if [ "$NCOLS" -ge 5 ]; then
        vexpiry=$(echo "$line" | awk '{print $3" "$4}')
      else
        vexpiry=$(echo "$line" | awk '{print $3}')
      fi
      EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null)
      if [ -n "$EXP_S" ] && [ "$EXP_S" -gt "$NOW_S" ]; then
        echo "$line" >> "$TMP"
      fi
    done < /etc/xray/accounts.db
    mv "$TMP" /etc/xray/accounts.db
    systemctl restart xray > /dev/null 2>&1
  fi
}

