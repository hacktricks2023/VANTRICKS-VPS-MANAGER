install_ssl() {
  echo -e "${Y}[*] Installing SSL & SSLH Multiplexer...${NC}"
  if [ "$PKG_TYPE" = "apt" ]; then
    pkg_install stunnel4 sslh certbot
  else
    pkg_install stunnel sslh certbot
  fi

  mkdir -p /etc/stunnel
  fuser -k 80/tcp > /dev/null 2>&1 || true
  
  if certbot certonly --standalone -d "$HOST" --non-interactive --agree-tos -m "admin@${HOST}" --http-01-port 80 > /dev/null 2>&1; then
    cat > /etc/stunnel/stunnel.conf << EOF
cert = /etc/letsencrypt/live/${HOST}/fullchain.pem
key = /etc/letsencrypt/live/${HOST}/privkey.pem
socket = a:SO_REUSEADDR=1
foreground = yes

[ssl-all]
accept = 127.0.0.1:7443
connect = 127.0.0.1:8080
EOF
  else
    openssl req -new -x509 -days 3650 -nodes -out /etc/stunnel/stunnel.pem -keyout /etc/stunnel/stunnel.pem -subj "/CN=VPS" > /dev/null 2>&1
    chmod 600 /etc/stunnel/stunnel.pem
    cat > /etc/stunnel/stunnel.conf << 'EOF'
cert = /etc/stunnel/stunnel.pem
socket = a:SO_REUSEADDR=1
foreground = yes

[ssl-all]
accept = 127.0.0.1:7443
connect = 127.0.0.1:8080
EOF
  fi

  cat > /etc/systemd/system/stunnel4.service << 'SEOF'
[Unit]
Description=SSL Tunnel
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/stunnel /etc/stunnel/stunnel.conf
Restart=always

[Install]
WantedBy=multi-user.target
SEOF
  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable stunnel4 > /dev/null 2>&1
  systemctl restart stunnel4 > /dev/null 2>&1

  mkdir -p /var/run/sslh /etc/sslh
