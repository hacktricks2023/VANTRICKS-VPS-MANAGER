# ══════════════════════════════════════════════
#   UI KIT (shared by the menu, Server Info and the login screen)
#   Every row is padded by its VISIBLE width, so borders always line up.
# ══════════════════════════════════════════════
UI_W=46
DIM='\033[2m'

ui_plain() { printf '%b' "$1" | sed -E 's/\x1b\[[0-9;]*[A-Za-z]//g'; }
ui_len()   { ui_plain "$1" | LC_ALL=C.UTF-8 wc -m | tr -d ' '; }
ui_line() {
  local fill; printf -v fill '%*s' "$UI_W" ''; fill=${fill// /═}
  printf '%b%s%s%s%b\n' "$C" "$1" "$fill" "$2" "$N"
}
ui_top() { ui_line ╔ ╗; }
ui_mid() { ui_line ╠ ╣; }
ui_bot() { ui_line ╚ ╝; }
ui_row() {
  local t="$1" len pad
  len=$(ui_len "$t"); pad=$((UI_W - len))
  # long value (link, path, UUID): keep it whole, drop the right border instead of cutting it or pushing it out of line
  if [ "$pad" -lt 0 ]; then printf '%b║%b%b\n' "$C" "$N" "$t"; return; fi
  printf '%b║%b%b%*s%b║%b\n' "$C" "$N" "$t" "$pad" '' "$C" "$N"
}
# one toggle row: [key] label ........ ● ON / ● OFF  (columns stay aligned for [1]..[11])
ui_toggle() {
  local st
  if [ "$3" = "ON" ]; then st="${G}● ON ${N}"; else st="${R}● OFF${N}"; fi
  ui_row "  $(printf '%b%-5s%b%b%-26s%b' "$Y" "[$1]" "$N" "$W" "$2" "$N")$st"
}
ui_ask() { printf '%b' " ${Y}❯${N} ${W}$1${N} ${DIM}›${N} "; }
ui_center() {
  local t="$1" len pad l
  len=$(ui_len "$t"); pad=$((UI_W - len)); [ "$pad" -lt 0 ] && pad=0; l=$((pad / 2))
  ui_row "$(printf '%*s' "$l" '')$t"
}
ui_split() {
  local a="$1" b="$2" la lb gap
  la=$(ui_len "$a"); lb=$(ui_len "$b"); gap=$((UI_W - la - lb - 1)); [ "$gap" -lt 1 ] && gap=1
  ui_row "$a$(printf '%*s' "$gap" '')$b "
}
ui_section() { ui_row " ${Y}◆${N} ${W}$1${N}"; }
ui_kv() { ui_row "  $(printf '%b%-10s%b' "$C" "$1" "$N") ${3:-$W}$2${N}"; }
ui_kvw() {
  local k="$1" v="$2" w=$((UI_W - 14)) first=1 chunk
  while [ -n "$v" ]; do
    chunk="${v:0:$w}"; v="${v:$w}"
    if [ "$first" = 1 ]; then ui_kv "$k" "$chunk" "$G"; first=0
    else ui_row "$(printf '%13s' '')${G}${chunk}${N}"; fi
  done
}
ui_bar() {
  local p="${1%.*}" n i f="" e="" col="$G"
  [[ "$p" =~ ^[0-9]+$ ]] || p=0
  [ "$p" -gt 100 ] && p=100
  [ "$p" -ge 60 ] && col="$Y"
  [ "$p" -ge 85 ] && col="$R"
  n=$(( (p + 5) / 10 ))
  for ((i = 0; i < 10; i++)); do if [ "$i" -lt "$n" ]; then f+="▰"; else e+="▱"; fi; done
  printf '%b%s%b%s%b' "$col" "$f" "$DIM" "$e" "$N"
}
ui_led() {
  case "$1" in
    active|ON|on) printf '%b●%b' "$G" "$N" ;;
    partial|PARTIAL) printf '%b●%b' "$Y" "$N" ;;
    *) printf '%b●%b' "$R" "$N" ;;
  esac
}
ui_svc2() { ui_row "  $(ui_led "$1") $(printf '%-13s' "$2")$(ui_led "$3") $4"; }
ui_menu_item() { printf '%b[%s]%b %b%s%b' "$Y" "$1" "$N" "$W" "$2" "$N"; }
ui_menu2() { ui_row "  $(printf '%b[%s]%b %b%-18s%b' "$Y" "$1" "$N" "$W" "$2" "$N")$(ui_menu_item "$3" "$4")"; }
# --- shared helpers for EVERY sub menu / sub screen (same look as the main menu) ---
ui_head() { ui_top; ui_center "${Y}◆${N} ${W}$1${N} ${Y}◆${N}"; ui_mid; }   # boxed title
ui_item() { ui_row "  ${Y}[$1]${N} ${W}$2${N}"; }                              # [1] Label
ui_back() { ui_row "  ${R}[0]${N} ${W}${1:-Back}${N} ${DIM}(or Enter)${N}"; }                       # [0] Back (red)
ui_ok()   { ui_row "  ${G}[✓]${N} $1"; }                                       # success row
ui_bad()  { ui_row "  ${R}[!]${N} $1"; }                                       # error / warning row
ui_note() { ui_row "  ${DIM}$1${N}"; }                                         # dim hint row
ui_msg()  { echo ""; echo -e " ${G}[✓]${N} $1"; }                              # result line under a box
ui_err()  { echo ""; echo -e " ${R}[!]${N} $1"; }
ui_svc1() {                                                                    # LED  NAME  ✓ WORKING / ✗ NOT WORKING
  if [ "$2" = "active" ]; then ui_row "  $(ui_led active) $(printf '%-16s' "$1")${G}✓ WORKING${N}"
  else ui_row "  $(ui_led inactive) $(printf '%-16s' "$1")${R}✗ NOT WORKING${N}"; fi
}

# Login screen + "Server Info": ports, service LEDs and server details
vt_info_screen() {
  local ip dom ns ban key bi bs bt bv on=0 t
  local s_ssh s_ou s_ot s_ov s_ssl s_s1 s_s2 s_mux s_ngx s_dns s_sd s_sl s_ws s_xr
  _st() { systemctl is-active "$1" 2>/dev/null; }
  ip=$(get_public_ipv4)
  dom="${HOST:-$ip}"; ns="${NAMESERVER:-$dom}"; key="$DNSTT_PUBKEY"
  if [ -n "$BANNER_TEXT" ]; then ban="$BANNER_TEXT"
  elif [ -s /etc/ssh/banner.txt ]; then ban=$(head -n 1 /etc/ssh/banner.txt)
  else ban="AVD TEAM"; fi
  bi=$(python3 /usr/local/bin/vantricks-booster.py summary 2>/dev/null || echo "100|S+|ULTRA BOOSTED|DIRECT / ORIGIN|unknown|-")
  bs=$(echo "$bi" | cut -d'|' -f1); bt=$(echo "$bi" | cut -d'|' -f2); bv=$(echo "$bi" | cut -d'|' -f3)
  cdn_prov=$(echo "$bi" | cut -d'|' -f4); cdn_srv=$(echo "$bi" | cut -d'|' -f5); cdn_ray=$(echo "$bi" | cut -d'|' -f6)
  [ -z "$bs" ] && bs=100
  [ -z "$cdn_prov" ] && cdn_prov="DIRECT / ORIGIN"

  s_ssh=$(_st ssh); [ "$s_ssh" != "active" ] && s_ssh=$(_st sshd)
  s_ou=$(_st openvpn-server@server); s_ot=$(_st openvpn-server@server-tcp)
  if [ "$s_ou" = active ] && [ "$s_ot" = active ]; then s_ov=active
  elif [ "$s_ou" = active ] || [ "$s_ot" = active ]; then s_ov=partial
  else s_ov=inactive; fi
  s_ssl=$(_st stunnel4)
  s_s1=$(_st sslh); s_s2=$(_st sslh-select)
  if [ "$s_s1" = active ] || [ "$s_s2" = active ]; then s_mux=active; else s_mux=inactive; fi
  s_ngx=$(_st nginx); s_dns=$(_st dnstt); s_sd=$(_st ssh-dnstt)
  s_sl=$(_st slipstream-rust); s_ws=$(_st ws-proxy-8080); s_xr=$(_st xray)
  for t in "$s_ssh" "$s_ov" "$s_ssl" "$s_mux" "$s_ngx" "$s_dns" "$s_sd" "$s_sl" "$s_ws" "$s_xr"; do
    [ "$t" = active ] && on=$((on + 1))
  done

  ui_top
  ui_center "${Y}◆${N} ${W}ACERO ${C}·${W} VANTRICKS VPS MANAGER${N} ${Y}◆${N}"
  ui_center "${DIM}${ip} · ${dom}${N}"
  ui_mid
  ui_section "PORTS"
  ui_kv "SSH" "22 · 80 · 443"
  ui_kv "SSH + WS" "80 · 443 · 8080"
  ui_kv "OpenVPN" "443 TCP · 1194 UDP"
  ui_kv "DNSTT" "53 (80, 443) · 5301"
  ui_kv "Slipstream" "127.0.0.1:5302 -> 22"
  ui_kv "WebSocket" "8080 (Keep-Alive)"
  ui_kv "Xray" "80 · 443 (WS/XHTTP, 301, No-LB)"
  ui_mid
  ui_split " ${Y}◆${N} ${W}SERVICES${N}" "${G}${on}/10${N} ${DIM}online${N}"
  ui_svc2 "$s_ssh" "SSH" "$s_ov" "OPENVPN"
  ui_svc2 "$s_ssl" "SSL" "$s_mux" "MULTIPLEXER"
  ui_svc2 "$s_ws" "WEBSOCKET" "$s_ngx" "NGINX"
  ui_svc2 "$s_xr" "XRAY/XHTTP" "$s_dns" "DNSTT"
  ui_svc2 "$s_sd" "SSH+DNSTT" "$s_sl" "SLIPSTREAM"
  ui_mid
  ui_section "SERVER"
  ui_kv "Public IP" "$ip" "$G"
  ui_kv "Domain" "$dom" "$G"
  ui_kv "NS" "$ns" "$G"
  ui_kv "CDN Info" "${cdn_prov} (${cdn_srv:-unknown})" "$C"
  [ -n "$cdn_ray" ] && [ "$cdn_ray" != "-" ] && ui_kv "CF-Ray" "$cdn_ray" "$W"
  ui_kv "Banner" "$ban" "$G"
  ui_kv "Booster" "$(ui_bar "$bs") ${W}${bs}/100 [${bt}]${N}"
  ui_kv "" "$bv" "$G"
  [ -n "$key" ] && ui_kvw "PubKey" "$key"
  ui_mid
  ui_center "${Y}▸${N} ${W}Type${N} ${G}menu${N} ${W}to open the manager${N}"
  ui_bot
}

# Login screen shown when you SSH in (rebuilt from the same UI kit above)
write_motd() {
  {
    echo '#!/bin/bash'
    echo '[ -n "$BASH_VERSION" ] || return 0 2>/dev/null || exit 0'
    echo '('
    declare -p R G Y C W N DIM UI_W
    declare -f ui_plain ui_len ui_line ui_top ui_mid ui_bot ui_row ui_center ui_split ui_section ui_kv ui_kvw ui_bar ui_led ui_svc2 vt_info_screen
    echo 'CONFIG_FILE="/etc/vantricks_script.conf"'
    echo '[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE" && vt_info_screen'
    echo ')'
  } > /etc/profile.d/vantricks-motd.sh
  chmod +x /etc/profile.d/vantricks-motd.sh
}

# ── PASSWORD CHECK ────────────────────────────────
check_password() {
  if [ ! -f "$CONFIG_FILE" ]; then
    clear
    ui_top
    ui_center "${Y}◆${N} ${W}Vantricks VPS Manager${N} ${Y}◆${N}"
    ui_mid
    read -p "  Password (Vantricks2026) : " INPUT_PASS

    CORRECT_PASS="Vantricks2026"

    if [ "$INPUT_PASS" == "$CORRECT_PASS" ]; then
      echo -e " ${G}[✓] Password correct! Proceeding...${N}"
      sleep 1
    else
      echo -e " ${R}[!] Wrong password! Access denied.${N}"
      echo ""
      exit 1
    fi
  fi
}
