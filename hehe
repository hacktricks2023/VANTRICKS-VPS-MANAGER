  DATETIME=$(TZ="Asia/Manila" date "+%m-%d-%Y %I:%M:%S %p")

  # real authenticated devices (one per SSH connection / OpenVPN client), not raw sockets
  SSH_ONLINE=0; OVPN_ONLINE=0
