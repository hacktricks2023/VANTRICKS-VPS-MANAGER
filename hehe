          UPKG=$(get_account_package "ssh_ovpn" "$user")
          ui_row "  ${Y}[$INDEX]${N} ${W}$user  ${Y}|${N} Online: ${G}$SESS${N}${N}"
          USERS+=("$user")
          INDEX=$((INDEX + 1))
        fi
      fi
    done < /etc/passwd

    ui_mid
    ui_row "  ${Y}[e]${N} ${W}Delete All Expired Accounts${N}"
    ui_row "  ${Y}[A]${N} ${W}Delete All Accounts (Force)${N}"
    ui_row "  ${R}[0]${N} ${W}Back${N} ${DIM}(or Enter)${N}"
    ui_bot
    read -r -p "$(ui_ask 'Select option')" DEL_OPT
    [ -z "$DEL_OPT" ] && break

    if [ "$DEL_OPT" == "0" ]; then
      break
    elif [ "$DEL_OPT" == "e" ]; then
      COUNT=0
      NOW_S=$(date +%s)
      while IFS=: read -r u _ uid _ _ _ _; do
        if [ "$uid" -ge 1000 ] && [ "$u" != "nobody" ]; then
          EXP=$(chage -l "$u" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
          if [ "$EXP" != "never" ] && [ -n "$EXP" ]; then
            EXP_S=$(date -d "$EXP" +%s 2>/dev/null || echo 0)
            if [ "$EXP_S" -lt "$NOW_S" ]; then
              sed -i "/Match User $u/,/MaxSessions/d" /etc/ssh/sshd_config
              rm -f "${OVPN_CLIENT_DIR}/${u}-tcp443.ovpn" "${OVPN_CLIENT_DIR}/${u}-udp1194.ovpn" "${OVPN_CLIENT_DIR}/${u}.ovpn" 2>/dev/null
              remove_account_package "ssh_ovpn" "$u"; mux_forget "$u"
              userdel -r "$u" > /dev/null 2>&1
              COUNT=$((COUNT + 1))
            fi
          fi
        fi
      done < /etc/passwd
      systemctl restart ssh > /dev/null 2>&1
      echo -e "\n${G} [✓] Deleted $COUNT expired SSH+OVPN users!${N}"
      sleep 2
    elif [ "$DEL_OPT" == "A" ]; then
      for u in "${USERS[@]}"; do
        sed -i "/Match User $u/,/MaxSessions/d" /etc/ssh/sshd_config
        rm -f "${OVPN_CLIENT_DIR}/${u}-tcp443.ovpn" "${OVPN_CLIENT_DIR}/${u}-udp1194.ovpn" "${OVPN_CLIENT_DIR}/${u}.ovpn" 2>/dev/null
        remove_account_package "ssh_ovpn" "$u"; mux_forget "$u"
