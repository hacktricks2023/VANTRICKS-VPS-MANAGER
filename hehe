#   INSTALL OPENVPN (TCP/443 via sslh + UDP/1194)
# ══════════════════════════════════════════════

_ovpn_make_certs() {
  # Plain openssl (no easy-rsa): CA + server cert (serverAuth) + ta.key. dh is "none" (ECDH) so no slow dh.pem.
  local P=/etc/openvpn/easy-rsa/pki
  mkdir -p "$P/issued" "$P/private" "$OVPN_DIR"
  rm -f /tmp/ovpn_newca
  if [ ! -s "$P/ca.crt" ] || [ ! -s "$P/private/ca.key" ]; then
    openssl genrsa -out "$P/private/ca.key" 2048 > /dev/null 2>&1
    openssl req -x509 -new -nodes -key "$P/private/ca.key" -sha256 -days 3650 \
      -subj "/CN=Vantricks-OVPN-CA" -out "$P/ca.crt" > /dev/null 2>&1
    rm -f "$P/issued/server.crt" "$P/private/server.key"
    touch /tmp/ovpn_newca
  fi
  if [ ! -s "$P/issued/server.crt" ] || [ ! -s "$P/private/server.key" ]; then
    openssl genrsa -out "$P/private/server.key" 2048 > /dev/null 2>&1
    openssl req -new -key "$P/private/server.key" -subj "/CN=server" -out /tmp/ovpn-server.csr > /dev/null 2>&1
    printf 'basicConstraints=CA:FALSE\nkeyUsage=digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\nsubjectAltName=DNS:server\n' > /tmp/ovpn-server.ext
    openssl x509 -req -in /tmp/ovpn-server.csr -CA "$P/ca.crt" -CAkey "$P/private/ca.key" -CAcreateserial \
      -out "$P/issued/server.crt" -days 3650 -sha256 -extfile /tmp/ovpn-server.ext > /dev/null 2>&1
    rm -f /tmp/ovpn-server.csr /tmp/ovpn-server.ext
  fi
  [ -s "$P/ta.key" ] || openvpn --genkey secret "$P/ta.key" > /dev/null 2>&1
  [ -s "$P/ta.key" ] || openvpn --genkey --secret "$P/ta.key" > /dev/null 2>&1
  [ -s "$P/ca.crt" ] && [ -s "$P/issued/server.crt" ] && [ -s "$P/private/server.key" ] && [ -s "$P/ta.key" ] || return 1
  cp -f "$P/ca.crt" "$P/issued/server.crt" "$P/private/server.key" "$P/ta.key" "$OVPN_DIR/"
  chmod 600 "$OVPN_DIR/server.key" "$OVPN_DIR/ta.key"
  return 0
}

install_openvpn() {
  echo -e " ${Y}[*] Installing & configuring OpenVPN (TCP/443 + UDP/1194)...${N}"
  mkdir -p "$OVPN_DIR" "$OVPN_CLIENT_DIR" /etc/openvpn/easy-rsa /var/log/openvpn

  _ovpn_make_certs || { echo -e " ${R}[x] could not create OpenVPN certificates${N}"; return 1; }

  PAM_SO="/usr/lib/x86_64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so"
  if [ ! -f "$PAM_SO" ]; then
    PAM_SO=$(find /usr/lib -name "openvpn-plugin-auth-pam.so" 2>/dev/null | head -n 1)
  fi

  cat > "${OVPN_DIR}/server.conf" << EOF
port 1194
proto udp
dev tun
ca ca.crt
cert server.crt
key server.key
dh none
auth SHA256
tls-auth ta.key 0
topology subnet
server 10.8.0.0 255.255.255.0
ifconfig-pool-persist /var/log/openvpn/ipp-udp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
keepalive 10 120
cipher AES-256-GCM
user nobody
group nogroup
persist-key
persist-tun
status /var/log/openvpn/openvpn-udp-status.log
verb 3
plugin ${PAM_SO} login
username-as-common-name
EOF

  cat > "${OVPN_DIR}/server-tcp.conf" << EOF
port 11940
proto tcp-server
dev tun1
ca ca.crt
cert server.crt
key server.key
dh none
auth SHA256
tls-auth ta.key 0
topology subnet
server 10.9.0.0 255.255.255.0
ifconfig-pool-persist /var/log/openvpn/ipp-tcp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
keepalive 10 120
cipher AES-256-GCM
user nobody
group nogroup
persist-key
persist-tun
status /var/log/openvpn/openvpn-tcp-status.log
verb 3
socket-flags TCP_NODELAY
plugin ${PAM_SO} login
username-as-common-name
EOF
  [ "${MUX_AUTO:-OFF}" = "ON" ] && mux_ovpn_conf on

  sed -i 's/^#*net.ipv4.ip_forward=.*/net.ipv4.ip_forward=1/' /etc/sysctl.conf
  grep -q "^net.ipv4.ip_forward=1" /etc/sysctl.conf || echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
  sysctl -p > /dev/null 2>&1

  IFACE=$(ip route | grep default | awk '{print $5}' | head -1)
  if [ -n "$IFACE" ]; then
    iptables -t nat -C POSTROUTING -s 10.8.0.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o "$IFACE" -j MASQUERADE
    iptables -t nat -C POSTROUTING -s 10.9.0.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -s 10.9.0.0/24 -o "$IFACE" -j MASQUERADE
  fi
  iptables -C INPUT -p udp --dport 1194 -j ACCEPT 2>/dev/null || iptables -A INPUT -p udp --dport 1194 -j ACCEPT
  netfilter-persistent save > /dev/null 2>&1 || true

  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  systemctl restart openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  echo -e " ${G}[✓] OpenVPN ready on TCP/443 (via sslh -> 11940) & UDP/1194${N}"
}

