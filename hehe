v2ray_check_by_proto() {
  FILTER_PROTO="$1"
  source "$CONFIG_FILE"
  clear
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${W}           ${FILTER_PROTO^^} USERS                      ${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo ""

  FOUND=0
  TODAY_S=$(date +%s)

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    vuser=$(echo "$line" | awk '{print $1}')
    vuuid=$(echo "$line" | awk '{print $2}')
    NCOLS=$(echo "$line" | awk '{print NF}')
    if [ "$NCOLS" -ge 5 ]; then
      vexpiry=$(echo "$line" | awk '{print $3" "$4}')
      vproto=$(echo "$line" | awk '{print $5}')
    else
      vexpiry=$(echo "$line" | awk '{print $3}')
      vproto=$(echo "$line" | awk '{print $4}')
    fi

    if [ "$vproto" == "$FILTER_PROTO" ]; then
      FOUND=1
      EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null || echo 0)
      SECS_LEFT=$(( EXP_S - TODAY_S ))
      if [ $SECS_LEFT -le 0 ]; then
        TIME_LEFT="EXPIRED"
      else
        D=$(( SECS_LEFT/86400 ))
        H=$(( (SECS_LEFT%86400)/3600 ))
        M=$(( (SECS_LEFT%3600)/60 ))
        S=$(( SECS_LEFT%60 ))
        TIME_LEFT="${D}d ${H}h ${M}m ${S}s"
      fi

      # Trojan uses password as remarks, vless/vmess use username
      if [ "$FILTER_PROTO" == "trojan" ]; then
        LINK_TLS="trojan://${vuuid}@${HOST}:443?type=ws&security=tls&host=${HOST}&path=/trojan&sni=${HOST}#${vuuid}"
        LINK_NTLS="trojan://${vuuid}@${HOST}:80?type=ws&host=${HOST}&path=/trojan#${vuuid}"
        echo -e " Password   : ${G}$vuuid${N}"
      elif [ "$FILTER_PROTO" == "vless" ]; then
        LINK_TLS="vless://${vuuid}@${HOST}:443?encryption=none&type=ws&security=tls&host=${HOST}&path=/vless&sni=${HOST}#${vuser}"
        LINK_NTLS="vless://${vuuid}@${HOST}:80?encryption=none&type=ws&host=${HOST}&path=/vless#${vuser}"
        echo -e " Username   : ${G}$vuser${N}"
      else
        VMESS_TLS="{\"v\":\"2\",\"ps\":\"${vuser}\",\"add\":\"${HOST}\",\"port\":\"443\",\"id\":\"${vuuid}\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"${HOST}\",\"path\":\"/vmess\",\"tls\":\"tls\",\"sni\":\"${HOST}\"}"
        VMESS_NTLS="{\"v\":\"2\",\"ps\":\"${vuser}\",\"add\":\"${HOST}\",\"port\":\"80\",\"id\":\"${vuuid}\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"${HOST}\",\"path\":\"/vmess\",\"tls\":\"\"}"
        LINK_TLS="vmess://$(echo -n "$VMESS_TLS" | base64 -w 0)"
        LINK_NTLS="vmess://$(echo -n "$VMESS_NTLS" | base64 -w 0)"
        echo -e " Username   : ${G}$vuser${N}"
      fi

      echo -e " Expiration : ${G}$TIME_LEFT${N}"
      echo -e " TLS (443)  :"
      echo -e " ${G}$LINK_TLS${N}"
      echo ""
      echo -e " NON TLS (80):"
      echo -e " ${G}$LINK_NTLS${N}"
      echo -e " ${C}════════════════════════════════════════════════${N}"
      echo ""
    fi
  done < /etc/xray/accounts.db

  if [ $FOUND -eq 0 ]; then
    echo -e " ${Y} No ${FILTER_PROTO^^} accounts found.${N}"
  fi

  press_enter
}

