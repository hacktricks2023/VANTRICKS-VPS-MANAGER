# Info / result screens: ONE rule everywhere -> type 0 or just press Enter to go back
press_enter() {
  echo ""
  read -r -p "$(printf '%b' " ${R}❯${N} ${W}Back${N} ${DIM}(type 0 or press Enter)${N} ${DIM}›${N} ")" _
}
# only for flows that continue after a message (not a "go back")
press_continue() {
  echo ""
  read -r -p "$(ui_ask 'Press Enter to continue')" _
}

get_public_ipv4() {
  local pub=""
  if [ -x "$BOOSTER_SCRIPT" ]; then
    pub=$(python3 "$BOOSTER_SCRIPT" ip 2>/dev/null | tr -d '[:space:]')
  fi
  if [ -z "$pub" ] || ! [[ "$pub" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    pub=$(curl -4 -fsS --max-time 2 https://api.ipify.org 2>/dev/null || curl -4 -fsS --max-time 2 https://ipv4.icanhazip.com 2>/dev/null | tr -d '[:space:]')
  fi
  if [ -z "$pub" ] || ! [[ "$pub" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    pub=$(hostname -I 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $i !~ /^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)/) {print $i; exit}}')
  fi
  [ -z "$pub" ] && pub=$(hostname -I 2>/dev/null | awk '{print $1}')
  echo "$pub"
}

check_root() {
  if [ "$EUID" -ne 0 ]; then
    echo -e "${R}[ERROR] Please run as root: sudo bash vantricks_manager.sh${N}"
    exit 1
  fi
}

check_os() {
  DISTRO=$(grep -oP '(?<=^ID=).+' /etc/os-release 2>/dev/null | tr -d '"' || echo "unknown")
  if [ "$DISTRO" != "debian" ] && [ "$DISTRO" != "ubuntu" ]; then
    echo -e "${R}[ERROR] Unsupported OS! Only Debian/Ubuntu is supported.${N}"
    exit 1
  fi
}

# num: always returns ONE number (fixes "0 0" / empty values that break [ -gt ])
num() {
  local v
  v=$(printf '%s' "$1" | head -n1 | tr -dc '0-9')
  echo "${v:-0}"
}

init_packages_store() {
  mkdir -p /etc
  touch "$PACKAGES_FILE" "$ACCOUNT_PKG_DB" "$SNI_PROXY_HOST_FILE"
  sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE" "$SNI_PROXY_HOST_FILE" 2>/dev/null || true
}

ensure_default_toggles() {
  mkdir -p /etc
  touch "$CONFIG_FILE"
  source "$CONFIG_FILE" 2>/dev/null || true

  local VARS=(
    "PROTO_SSH=${PROTO_SSH:-ON}"
    "PROTO_OVPN=${PROTO_OVPN:-ON}"
    "PROTO_SSL=${PROTO_SSL:-ON}"
    "PROTO_MUX=${PROTO_MUX:-ON}"
    "PROTO_WS=${PROTO_WS:-ON}"
    "PROTO_NGINX=${PROTO_NGINX:-ON}"
    "PROTO_XRAY=${PROTO_XRAY:-ON}"
    "PROTO_XHTTP=${PROTO_XHTTP:-ON}"
    "PROTO_DNSTT=${PROTO_DNSTT:-ON}"
    "PROTO_SSH_DNSTT=${PROTO_SSH_DNSTT:-ON}"
    "PROTO_SLIPSTREAM=${PROTO_SLIPSTREAM:-ON}"
    "BOOSTER_ENABLED=${BOOSTER_ENABLED:-ON}"
    "REDIRECT_301=${REDIRECT_301:-ON}"
    "MUX_AUTO=${MUX_AUTO:-OFF}"
    "MUX_DEFAULT_LIMIT=${MUX_DEFAULT_LIMIT:-2}"
    "MUX_POLICY=${MUX_POLICY:-NEWEST}"
    "AUTO_REBOOT_ON_SAVE=${AUTO_REBOOT_ON_SAVE:-ON}"
    "BANNER_TEXT=${BANNER_TEXT:-$DEFAULT_BANNER_TEXT}"
  )

  # migrate an old unquoted banner (BANNER_TEXT=AVD TEAM -> "AVD TEAM")
  sed -i -E '/^BANNER_TEXT=[^"'"'"'].*[[:space:]]/ s/^BANNER_TEXT=(.*)$/BANNER_TEXT="\1"/' "$CONFIG_FILE" 2>/dev/null || true

  for entry in "${VARS[@]}"; do
    local k="${entry%%=*}"
    if ! grep -q "^${k}=" "$CONFIG_FILE" 2>/dev/null; then
      set_config_kv "$k" "${entry#*=}"
    fi
  done
  source "$CONFIG_FILE" 2>/dev/null || true
}

set_config_kv() {
  local KEY="$1"
  local VAL="$2"
  mkdir -p /etc
  touch "$CONFIG_FILE"
  sed -i "/^${KEY}=/d" "$CONFIG_FILE" 2>/dev/null || true
  if printf '%s' "$VAL" | grep -qE '^[A-Za-z0-9_.@:/,+=-]*$'; then
    echo "${KEY}=${VAL}" >> "$CONFIG_FILE"
  else
    local ESC="${VAL//\\/\\\\}"; ESC="${ESC//\"/\\\"}"; ESC="${ESC//\$/\\\$}"; ESC="${ESC//\`/\\\`}"
    echo "${KEY}=\"${ESC}\"" >> "$CONFIG_FILE"
  fi
  export "$KEY=$VAL"
}

get_banner_text() {
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  if [ -n "$BANNER_TEXT" ]; then
    echo "$BANNER_TEXT"
  elif [ -s "$SSH_BANNER_FILE" ]; then
    head -n 1 "$SSH_BANNER_FILE"
  else
    echo "$DEFAULT_BANNER_TEXT"
  fi
}

# Put "Banner" in the GLOBAL part of sshd_config (top of file, before any "Match User" block).
# sshd keeps the FIRST value it reads and a Banner placed after a Match block only applies to that
# one user - that is why the default banner never showed. Also strips Banner from sshd_config.d.
set_sshd_banner_global() {
  local CFG=/etc/ssh/sshd_config
  [ -f "$CFG" ] || return 1
  cp -f "$CFG" "$CFG.bak-banner" 2>/dev/null
  sed -i -E '/^[[:space:]]*#?[[:space:]]*Banner[[:space:]]/d' "$CFG"
  sed -i "1i Banner $SSH_BANNER_FILE" "$CFG"
  if [ -d /etc/ssh/sshd_config.d ]; then
    sed -i -E '/^[[:space:]]*Banner[[:space:]]/d' /etc/ssh/sshd_config.d/*.conf 2>/dev/null || true
  fi
  if ! sshd -t -f "$CFG" > /dev/null 2>&1; then
    cp -f "$CFG.bak-banner" "$CFG" 2>/dev/null
    return 1
  fi
  return 0
}

apply_banner_config() {
  local BTEXT
  BTEXT=$(get_banner_text)
  mkdir -p /etc/ssh
  printf "%s\n" "$BTEXT" > "$SSH_BANNER_FILE"
  chmod 644 "$SSH_BANNER_FILE" 2>/dev/null
  if [ -f /etc/ssh/sshd_config ]; then
    set_sshd_banner_global
    systemctl restart ssh > /dev/null 2>&1 || systemctl restart sshd > /dev/null 2>&1 || true
  fi
}

custom_banner_menu() {
  while true; do
    local CUR_BANNER
    CUR_BANNER=$(get_banner_text)
    clear
    ui_top
    ui_center "${Y}◆${N} ${W}CUSTOM BANNER (DEFAULT: AVD TEAM)${N} ${Y}◆${N}"
    ui_mid
    ui_row "  Active Banner : ${G}${CUR_BANNER}${N}"
    ui_mid
    ui_row "  ${Y}[1]${N} ${W}Set Custom Banner Text${N}"
    ui_row "  ${Y}[2]${N} ${W}Reset Banner to Default (AVD TEAM)${N}"
    ui_row "  ${R}[0]${N} ${W}Back${N} ${DIM}(or Enter)${N}"
    ui_bot
    read -r -p "$(ui_ask 'Select option')" BOPT
    [ -z "$BOPT" ] && break

    case "$BOPT" in
      1)
        echo ""
        read -p "  Enter custom banner text: " NEW_BANNER
        NEW_BANNER=$(echo "$NEW_BANNER" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -z "$NEW_BANNER" ]; then
          echo -e " ${R}[!] Banner text cannot be empty!${N}"
          sleep 1
        else
          set_config_kv "BANNER_TEXT" "$NEW_BANNER"
          apply_banner_config
          echo -e " ${G}[✓] Custom banner updated to '${NEW_BANNER}' and applied!${N}"
          sleep 1
        fi
        ;;
      2)
        set_config_kv "BANNER_TEXT" "$DEFAULT_BANNER_TEXT"
        apply_banner_config
        echo -e "\n ${G}[✓] Banner reset to default: ${DEFAULT_BANNER_TEXT}${N}"
        sleep 1
        ;;
      0)
        break
        ;;
      *)
        echo -e "\n ${R}[!] Invalid option!${N}"
        sleep 1
        ;;
    esac
  done
}

get_auto_reboot_state() {
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  if [ "${AUTO_REBOOT_ON_SAVE^^}" == "OFF" ]; then
    echo "OFF"
  else
    echo "ON"
  fi
}

set_auto_reboot_state() {
  local NEW_STATE="${1^^}"
  [ "$NEW_STATE" != "ON" ] && NEW_STATE="OFF"
  set_config_kv "AUTO_REBOOT_ON_SAVE" "$NEW_STATE"
  AUTO_REBOOT_ON_SAVE="$NEW_STATE"
}

toggle_auto_reboot() {
  local CUR
  CUR=$(get_auto_reboot_state)
  if [ "$CUR" == "ON" ]; then
    set_auto_reboot_state "OFF"
    echo -e "\n ${Y}[✓] Auto Reboot on Save is now: OFF${N}"
  else
    set_auto_reboot_state "ON"
    echo -e "\n ${G}[✓] Auto Reboot on Save is now: ON${N}"
  fi
  sleep 1
}

