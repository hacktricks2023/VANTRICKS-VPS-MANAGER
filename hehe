install_golang() {
  echo -e "${Y}[*] Installing Golang...${NC}"
  wget -q "https://go.dev/dl/go1.22.5.linux-amd64.tar.gz" -O /tmp/go.tar.gz
  rm -rf /usr/local/go
  tar -C /usr/local -xzf /tmp/go.tar.gz > /dev/null 2>&1
  export PATH=$PATH:/usr/local/go/bin
}

install_custom_openssh() {
  echo -e "${Y}[*] Installing Custom OpenSSH...${NC}"
  if [ "$PKG_TYPE" = "apt" ]; then
    pkg_install build-essential zlib1g-dev libssl-dev libpam0g-dev libselinux1-dev libedit-dev autoconf
  else
    pkg_install gcc make zlib-devel openssl-devel pam-devel libselinux-devel libedit-devel autoconf
  fi

  OPENSSH_VER="9.2p1"
  cd /tmp
  wget -q "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${OPENSSH_VER}.tar.gz" -O openssh-src.tar.gz 2>/dev/null
  tar -xzf openssh-src.tar.gz > /dev/null 2>&1
  cd openssh-${OPENSSH_VER}
  sed -i 's/#define SSH_VERSION.*/#define SSH_VERSION "Blu-2026-SSH"/' version.h
  sed -i 's/#define SSH_PORTABLE.*/#define SSH_PORTABLE ""/' version.h
  ./configure --prefix=/usr --sysconfdir=/etc/ssh --with-pam > /dev/null 2>&1
  make -j$(nproc) > /dev/null 2>&1
  systemctl stop ssh 2>/dev/null || systemctl stop sshd 2>/dev/null || true
  install -m 755 sshd /usr/sbin/sshd
  mkdir -p /var/empty /run/sshd
  useradd -r -s /sbin/nologin -d /var/empty sshd > /dev/null 2>&1 || true

  cat > /etc/systemd/system/ssh.service << 'SVCEOF'
[Unit]
Description=SSH Tunneling Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/sshd -D
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
SVCEOF

  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable ssh > /dev/null 2>&1
  systemctl start ssh > /dev/null 2>&1
}

install_websocket() {
  echo -e "${Y}[*] Installing WebSocket Proxy (Port 8080)...${NC}"
  cat > /usr/local/bin/ws-proxy.py << 'PYEOF'
#!/usr/bin/env python3
import socket, threading, select, sys
LISTEN_PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
SSH_HOST, SSH_PORT, NGINX_PORT = '127.0.0.1', 22, 8880
BUFFER, TIMEOUT = 65535, 60
V2RAY_PATHS = [b'/vmess', b'/vless', b'/trojan']
RESPONSE_COLOR = b"HTTP/1.1 101 <font color=#00FF00>Custom-SSH</font>\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n"
RESPONSE_PLAIN = b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n"

def forward(src, dst):
    try:
        while True:
            r, _, _ = select.select([src], [], [], TIMEOUT)
            if r:
                d = src.recv(BUFFER)
                if not d: break
                dst.sendall(d)
    except: pass
    finally:
        try: src.close()
        except: pass
        try: dst.close()
        except: pass

def handle(client):
    try:
        data = client.recv(BUFFER)
        if not data: client.close(); return
        is_v2ray = False
        is_http = data[:4] in (b'GET ', b'POST', b'HEAD', b'CONN')
        is_ws = b'Upgrade: websocket' in data or b'upgrade: websocket' in data
        if is_http:
            for path in V2RAY_PATHS:
                if path in data: is_v2ray = True; break
        if is_v2ray:
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            target.connect((SSH_HOST, NGINX_PORT))
            target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
        elif is_http and not is_ws:
            client.send(RESPONSE_PLAIN)
            client.close()
            return
        else:
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            target.connect((SSH_HOST, SSH_PORT))
            if is_http: client.send(RESPONSE_COLOR)
            else: target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
    except:
        try: client.close()
        except: pass

def start(port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(('0.0.0.0', port))
    srv.listen(200)
    while True:
        try:
            c, _ = srv.accept()
            threading.Thread(target=handle, args=(c,), daemon=True).start()
        except: pass

if __name__ == '__main__':
    start(LISTEN_PORT)
PYEOF
  chmod +x /usr/local/bin/ws-proxy.py

  cat > /etc/systemd/system/ws-proxy-8080.service << EOF
[Unit]
Description=WebSocket Proxy
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/ws-proxy.py 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
  systemctl enable ws-proxy-8080 > /dev/null 2>&1
  systemctl start ws-proxy-8080 > /dev/null 2>&1
}

