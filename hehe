# boot-time service (re-opens ports, restarts the stack). Shared by the first install and by in-place updates.
write_startup_service() {
  cat > /usr/local/bin/vantricks-startup.sh << 'STARTEOF'
#!/bin/bash
systemctl stop apache2 > /dev/null 2>&1
systemctl mask apache2 > /dev/null 2>&1
fuser -k 80/tcp > /dev/null 2>&1
fuser -k 443/tcp > /dev/null 2>&1
chattr -i /etc/resolv.conf > /dev/null 2>&1
echo "nameserver 8.8.8.8" > /etc/resolv.conf
echo "nameserver 8.8.4.4" >> /etc/resolv.conf
chattr +i /etc/resolv.conf > /dev/null 2>&1
# re-open the tunnel ports on every boot (some images reload a default-REJECT ruleset)
for P in 22 80 443 8080; do iptables -C INPUT -p tcp --dport $P -j ACCEPT > /dev/null 2>&1 || iptables -I INPUT -p tcp --dport $P -j ACCEPT > /dev/null 2>&1; done
sleep 3
[ -x /usr/local/bin/vantricks-booster.py ] && python3 /usr/local/bin/vantricks-booster.py apply > /dev/null 2>&1
systemctl restart ssh > /dev/null 2>&1
systemctl restart openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
systemctl restart stunnel4 > /dev/null 2>&1
systemctl restart nginx > /dev/null 2>&1
systemctl restart ws-proxy-8080 > /dev/null 2>&1
sleep 3
systemctl restart sslh > /dev/null 2>&1 || systemctl restart sslh-select > /dev/null 2>&1
systemctl restart xray > /dev/null 2>&1
systemctl restart dnstt ssh-dnstt slipstream-rust > /dev/null 2>&1
STARTEOF
  chmod +x /usr/local/bin/vantricks-startup.sh

  cat > /etc/systemd/system/vantricks-startup.service << 'SVCEOF'
[Unit]
Description=vantricks Script Startup
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vantricks-startup.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
SVCEOF
  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable vantricks-startup > /dev/null 2>&1
}

# ══════════════════════════════════════════════
#   IN-PLACE UPDATE  (run the same installer again = upgrade, no uninstall needed)
# ══════════════════════════════════════════════
SCRIPT_BUILD="V51"
VER_FILE="/etc/vantricks_installed.ver"

self_fingerprint() { sha256sum "$1" 2>/dev/null | cut -c1-12; }

mark_installed_version() {
  echo "$(self_fingerprint "$(realpath "$0" 2>/dev/null)") $SCRIPT_BUILD $(date +%F)" > "$VER_FILE" 2>/dev/null
}

backup_before_update() {
  local B="/root/vantricks-backup-$(date +%Y%m%d-%H%M%S).tgz" L=""
  for f in /etc/vantricks* /etc/xray /usr/local/etc/xray /etc/openvpn/server /etc/ssh/banner.txt /etc/ssh/sshd_config /root/vantricks-script.sh /etc/nginx/conf.d/v2ray.conf; do
    [ -e "$f" ] && L="$L $f"
  done
  tar czf "$B" $L > /dev/null 2>&1 && chmod 600 "$B" && echo "$B"
  # keep only the 3 newest backups
  ls -1t /root/vantricks-backup-*.tgz 2>/dev/null | tail -n +4 | xargs -r rm -f
}

upgrade_step() {
  # upgrade_step "label" command...   -> runs quietly, prints a tick or a warning, never aborts the update
  local label="$1"; shift
  if ( "$@" ) > /dev/null 2>&1; then
    echo -e "  ${G}[✓]${N} $label"
  else
    echo -e "  ${Y}[!]${N} $label ${DIM}(skipped, will retry on next update)${N}"
  fi
}

upgrade_in_place() {
  local MODE="$1" SELF NEW OLD="" OLDB="unknown" BK
  SELF="$(realpath "$0" 2>/dev/null)"
  NEW="$(self_fingerprint "$SELF")"
  if [ -f "$VER_FILE" ]; then OLD="$(awk '{print $1}' "$VER_FILE")"; OLDB="$(awk '{print $2}' "$VER_FILE")"; fi

  clear
  ui_top
  ui_center "${Y}◆${N} ${W}Vantricks VPS Manager - UPDATE${N} ${Y}◆${N}"
  ui_mid
  echo -e "  Installed : ${W}${OLDB}${N} ${DIM}(${OLD:-no version file})${N}"
  echo -e "  This run  : ${W}${SCRIPT_BUILD}${N} ${DIM}(${NEW})${N}"
  ui_bot

  if [ "$MODE" != "force" ] && [ -n "$OLD" ] && [ "$OLD" = "$NEW" ]; then
    echo -e "\n ${G}[✓] Already up to date.${N} Nothing to change."
    return 0
  fi

  echo -e "\n ${Y}Installed script found - updating in place.${N}"
  echo -e " ${DIM}Accounts, domain, NS, ports and settings are kept. No uninstall needed.${N}\n"

  BK="$(backup_before_update)"
  [ -n "$BK" ] && echo -e "  ${G}[✓]${N} Backup saved: ${W}${BK}${N}" || echo -e "  ${Y}[!]${N} Backup skipped"

  upgrade_step "Settings (new options added, yours kept)" ensure_default_toggles
  upgrade_step "Speed booster"                            apply_enhancement_booster
  upgrade_step "Startup service"                          write_startup_service
  upgrade_step "Account Multiplexer (auto limit)"         mux_heal
  upgrade_step "WebSocket / SSL stack"                    heal_ws_stack force
  upgrade_step "SSH banner ($(get_banner_text))"          apply_banner_config
  upgrade_step "Login info screen"                        write_motd
  upgrade_step "Firewall ports"                           heal_network_layer
  upgrade_step "Menu command (type: menu)"                refresh_menu_command "$SELF"

  if ws_selftest 80 > /dev/null 2>&1; then
    echo -e "  ${G}[✓]${N} Port 80 payload path OK (101 + SSH banner)"
  else
    echo -e "  ${Y}[!]${N} Port 80 self-test failed - run: ${W}bash /root/vantricks-script.sh --heal${N}"
  fi

  mark_installed_version
  echo -e "\n ${G}[✓] Updated to ${SCRIPT_BUILD}.${N} Your users and settings were not touched."
  return 0
}

refresh_menu_command() {
  local S="$1"
  [ -f "$S" ] || return 1
  [ "$S" = "/root/vantricks-script.sh" ] || cp -f "$S" /root/vantricks-script.sh
  chmod +x /root/vantricks-script.sh
  printf '#!/bin/bash\nsudo bash /root/vantricks-script.sh\n' > /usr/local/bin/menu
  chmod +x /usr/local/bin/menu
}

