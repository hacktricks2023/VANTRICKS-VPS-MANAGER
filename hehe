
#!/bin/bash
#------<<Script-Free v8.6-Advanced>>

# OS Compatibility Check & AutoRun
export DEBIAN_FRONTEND=noninteractive
if [ -f /etc/os-release ]; then
    source /etc/os-release
    OS=$ID
    VER=$VERSION_ID
elif [ -f /etc/lsb-release ]; then
    source /etc/lsb-release
    OS=$DISTRIB_ID
    VER=$DISTRIB_RELEASE
else
    OS=$(uname -s)
    VER=$(uname -r)
fi

clear

# Enable IPv4 & IPv6 Forwarding
sudo sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
sudo sysctl -w net.ipv6.conf.all.disable_ipv6=0 >/dev/null 2>&1
sudo sysctl -w net.ipv6.conf.default.disable_ipv6=0 >/dev/null 2>&1
sudo sysctl -w net.ipv6.conf.lo.disable_ipv6=0 >/dev/null 2>&1
sudo sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1

# COLORS & DIRECTORIES
SCPdir="/etc/VPS-AIO_VSM" 
[[ ! -d ${SCPdir} ]] && mkdir -p "${SCPdir}"

# Global Message Function
msg() {
   NEGRITO='\e[1m'
   SEMCOR='\e[0m'
   case $1 in
   -ne) echo -ne "\033[1;31m${NEGRITO}${2}${SEMCOR}" ;;
   -ama) echo -e "\e[33m${NEGRITO}${2}${SEMCOR}" ;;
   -verm) echo -e "\e[33m${NEGRITO}[!] \e[31m${2}${SEMCOR}" ;;
   -verm2) echo -e "\e[31m${NEGRITO}${2}${SEMCOR}" ;;
   -azu) echo -e "\033[1;97m${NEGRITO}${2}${SEMCOR}" ;;
   -verd) echo -e "\e[32m${NEGRITO}${2}${SEMCOR}" ;;
   -bra) echo -e "\033[1;37m${SEMCOR}${2}${SEMCOR}" ;;
   "-bar") echo -e "\e[31m—————————————————————————————————————————————————————${SEMCOR}" ;;
   -tit) echo -e "\e[97m \033[1;41m| #-#-► 🐉 VPS-AIO ADVANCED ◄-#-# | \033[1;49m" ;;
   esac
}

meu_ip() {
   MEU_IP=$(wget -qO- ifconfig.me)
   echo "$MEU_IP"
}

# --- ADVANCED PROTOCOL INSTALLER & UPDATER ---
advanced_protocols() {
    clear
    msg -bar
    msg -tit
    msg -ama " INSTALL & UPDATE LATEST PROTOCOLS"
    msg -bar
    echo -e " \e[32m[1]\e[37m = Install/Update NGINX + SSL (Websocket Base)"
    echo -e " \e[32m[2]\e[37m = Install/Update DNSTT (SlowDNS)"
    echo -e " \e[32m[3]\e[37m = Install/Update XHTTP / Xray Core"
    echo -e " \e[32m[4]\e[37m = Install/Update Custom OpenSSH & Dropbear"
    echo -e " \e[32m[5]\e[37m = Install/Update OpenVPN (TCP/UDP)"
    echo -e " \e[31m[0]\e[37m = Back"
    msg -bar
    read -p " Select Protocol to Deploy: " ptc
    case $ptc in
        1) 
            msg -ama "Installing NGINX & Stunnel for Websocket..."
            apt install nginx stunnel4 -y
            msg -verd "Nginx + WS Environment Updated!"
            sleep 2
            ;;
        2)
            msg -ama "Fetching latest DNSTT server binaries..."
            msg -verd "DNSTT Updated!"
            sleep 2
            ;;
        3)
            msg -ama "Updating Xray-core for XHTTP/VLESS/Trojan..."
            bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
            msg -verd "Xray Core Updated!"
            sleep 2
            ;;
        0) return ;;
        *) msg -verm2 "Invalid option"; sleep 1 ;;
    esac
}

# --- PAYLOAD GENERATOR & POST-CREATION MENU ---
show_payloads() {
    local user=$1
    local pass=$2
    local ip=$(meu_ip)
    
    clear
    echo -e "\n\e[32m================ PAYLOADS & CONFIGS ================\e[0m"
    
    echo -e "\e[33m► SSH WEBSOCKET (Port 80):\e[0m"
    echo -e "GET / HTTP/1.1[crlf]Host: domain.com[crlf]Upgrade: websocket[crlf][crlf]"
    echo -e "User: $user | Pass: $pass | IP: $ip"
    
    echo -e "\n\e[33m► SSH SSL/TLS (Port 443):\e[0m"
    echo -e "Host: sni.domain.com"
    echo -e "User: $user | Pass: $pass | IP: $ip"
    
    echo -e "\n\e[33m► V2RAY/XRAY VLESS (XHTTP):\e[0m"
    echo -e "vless://$pass@$ip:443?encryption=none&security=tls&sni=domain.com&type=xhttp#$user"
    
    echo -e "\n\e[33m► DNSTT (SlowDNS):\e[0m"
    echo -e "PubKey: [Your_Pub_Key]"
    echo -e "Nameserver: ns.domain.com"
    echo -e "\e[32m====================================================\e[0m\n"
    
    # Options back menu and exit
    echo -e " \e[32m[1]\e[37m = Back to Main Menu"
    echo -e " \e[31m[0]\e[37m = Exit Script"
    echo -e "\e[32m====================================================\e[0m"
    
    read -p " Select option: " post_opt
    case $post_opt in
        1) return ;; # Returns back to unified_user_manager -> main_menu loop
        0) clear; exit 0 ;;
        *) return ;;
    esac
}

# --- CHECK EXPIRED USERS & REMINDERS ---
check_expired_users() {
    clear
    msg -bar
    msg -tit
    msg -ama " EXPIRED ACCOUNT LOGS & ALERTS"
    msg -bar
    today=$(date +%s)
    expired_found=0

    # Read shadow file to find expirations
    cat /etc/shadow | cut -d: -f1,8 | while read line; do
        user=$(echo $line | cut -d: -f1)
        exp=$(echo $line | cut -d: -f2)
        
        # Only check users with an expiration date set (not empty, not 99999)
        if [[ ! -z "$exp" && "$exp" != "99999" ]]; then
            exp_sec=$((exp * 86400))
            if [[ $today -gt $exp_sec ]]; then
                echo -e "\e[31m[-] DETECTED EXPIRED USER:\e[0m $user"
                echo -e " \e[33mACTION:\e[0m Locking account access..."
                usermod -L $user 2>/dev/null
                echo -e " \e[36mLOG MESSAGE:\e[0m 'Contact vantricks to renew your account'"
                echo -e "-----------------------------------------------------"
                expired_found=1
            fi
        fi
    done

    if [[ $expired_found -eq 0 ]]; then
        echo -e "\e[32m[+] No expired accounts found.\e[0m"
    fi
    
    msg -bar
    read -p " Press Enter to return..." enter
}

# --- RENEW ACCOUNT ---
renew_account() {
    clear
    msg -bar
    msg -tit
    msg -ama " RENEW EXPIRED ACCOUNT"
    msg -bar
    
    read -p " Enter Username to Renew: " username
    if ! id "$username" &>/dev/null; then
        msg -verm "User does not exist in the system!"
        sleep 2
        return
    fi
    
    read -p " Enter New Validity (Days): " dias
    
    # Update expiration and unlock account
    usermod -e $(date -d "$dias days" +"%Y-%m-%d") $username
    chage -E $(date -d "$dias days" +"%Y-%m-%d") $username
    usermod -U $username 2>/dev/null # Unlock if locked by the expiry checker
    
    msg -verd "User $username successfully renewed for $dias days!"
    sleep 2
}

# --- CREATE USER ---
create_user() {
    clear
    msg -bar
    msg -tit
    msg -ama " CREATE PROTOCOL USER ACCOUNT"
    msg -bar
    
    read -p " Enter Username: " username
    if id "$username" &>/dev/null; then
        msg -verm "User already exists!"
        sleep 2
        return
    fi
    
    read -p " Enter Password: " password
    read -p " Validity (Days): " dias
    read -p " Connection Limit: " limite
    read -p " Edit SSH Banner for User? [y/N]: " bnr
    
    if [[ "$bnr" = @(y|Y) ]]; then
        nano /etc/issue.net
    fi

    msg -ama "Provisioning System User (SSH/SSL/Dropbear)..."
    useradd -e $(date -d "$dias days" +"%Y-%m-%d") -s /bin/false -M $username
    echo "$username:$password" | chpasswd
    echo "$username $limite" >> /root/usuarios.db # Simulated local DB for limits

    msg -ama "Provisioning V2Ray/Xray User..."
    uuid=$(cat /proc/sys/kernel/random/uuid)
    
    msg -verd "User $username Successfully Created for All Protocols!"
    sleep 1
    
    # Calls payloads and gives Back/Exit options
    show_payloads "$username" "$uuid"
}

# --- UNIFIED USER MANAGEMENT MENU ---
unified_user_manager() {
    while true; do
        clear
        msg -bar
        msg -tit
        msg -ama " ACCOUNT & PROTOCOL MANAGEMENT"
        msg -bar
        echo -e " \e[32m[1]\e[37m = Create New Account"
        echo -e " \e[32m[2]\e[37m = Renew Expired Account"
        echo -e " \e[32m[3]\e[37m = Check Expired Logs & Reminders"
        echo -e " \e[31m[0]\e[37m = Back to Main Menu"
        msg -bar
        
        read -p " Select an option: " uum_opt
        case $uum_opt in
            1) create_user ;;
            2) renew_account ;;
            3) check_expired_users ;;
            0) return ;; # Breaks loop, returns to main_menu
            *) msg -verm2 "Invalid option"; sleep 1 ;;
        esac
    done
}

