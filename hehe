SCRIPT_BUILD="V52"
VER_FILE="/etc/vantricks_installed.ver"

self_fingerprint() { sha256sum "$1" 2>/dev/null | cut -c1-12; }

mark_installed_version() {
  echo "$(self_fingerprint "$(realpath "$0" 2>/dev/null)") $SCRIPT_BUILD $(date +%F)" > "$VER_FILE" 2>/dev/null
}

backup_before_update() {
  local B="/root/vantricks-backup-$(date +%Y%m%d-%H%M%S).tgz" L=""
  for f in /etc/vantricks* /etc/xray /usr/local/etc/xray /etc/openvpn/server /etc/ssh/banner.txt /etc/ssh/sshd_config /root/vantricks-script.sh /etc/nginx/conf.d/v2ray.conf; do
    [ -e "$f" ] && L="$L $f"
  done
  tar czf "$B" $L > /dev/null 2>&1 && chmod 600 "$B" && echo "$B"
  ls -1t /root/vantricks-backup-*.tgz 2>/dev/null | tail -n +4 | xargs -r rm -f
}

upgrade_step() {
  local label="$1"; shift
  if ( "$@" ) > /dev/null 2>&1; then
    echo -e "  ${G}[✓]${N} $label"
  else
    echo -e "  ${Y}[!]${N} $label ${DIM}(skipped, will retry on next update)${N}"
  fi
}

upgrade_in_place() {
  local MODE="$1" SELF NEW OLD="" OLDB="unknown" BK
  SELF="$(realpath "$0" 2>/dev/null)"
  NEW="$(self_fingerprint "$SELF")"
  if [ -f "$VER_FILE" ]; then OLD="$(awk '{print $1}' "$VER_FILE")"; OLDB="$(awk '{print $2}' "$VER_FILE")"; fi

  clear
  ui_top
  ui_center "${Y}◆${N} ${W}Vantricks VPS Manager - UPDATE${N} ${Y}◆${N}"
  ui_mid
  echo -e "  Installed : ${W}${OLDB}${N} ${DIM}(${OLD:-no version file})${N}"
  echo -e "  This run  : ${W}${SCRIPT_BUILD}${N} ${DIM}(${NEW})${N}"
  ui_bot

  if [ "$MODE" != "force" ] && [ -n "$OLD" ] && [ "$OLD" = "$NEW" ]; then
    echo -e "\n ${G}[✓] Already up to date.${N} Nothing to change."
    return 0
  fi

  echo -e "\n ${Y}Installed script found - updating in place.${N}"
  echo -e " ${DIM}Accounts, domain, NS, ports and settings are kept. No uninstall needed.${N}\n"

  BK="$(backup_before_update)"
  [ -n "$BK" ] && echo -e "  ${G}[✓]${N} Backup saved: ${W}${BK}${N}" || echo -e "  ${Y}[!]${N} Backup skipped"

  upgrade_step "Settings (new options added, yours kept)" ensure_default_toggles
  upgrade_step "Python Booster & CDN Scanner"           install_booster_python
  upgrade_step "Speed booster"                            apply_enhancement_booster
  upgrade_step "Startup service"                          write_startup_service
  upgrade_step "Account Multiplexer (auto limit)"         mux_heal
  upgrade_step "WebSocket / SSL stack"                    heal_ws_stack force
  upgrade_step "SSH banner ($(get_banner_text))"          apply_banner_config
  upgrade_step "Login info screen"                        write_motd
  upgrade_step "Firewall ports"                           heal_network_layer
  upgrade_step "Menu command (type: menu)"                refresh_menu_command "$SELF"

  if ws_selftest 80 > /dev/null 2>&1; then
    echo -e "  ${G}[✓]${N} Port 80 payload path OK (101 + SSH banner)"
  else
    echo -e "  ${Y}[!]${N} Port 80 self-test failed - run: ${W}bash /root/vantricks-script.sh --heal${N}"
  fi

  mark_installed_version
  echo -e "\n ${G}[✓] Updated to ${SCRIPT_BUILD}.${N} Your users and settings were not touched."
  return 0
}

install_self_script() {
  local SRC_PATH="$1"
  mkdir -p /root /usr/local/bin
  if [ -n "$SRC_PATH" ] && [ -f "$SRC_PATH" ] && [ "$SRC_PATH" != "/root/vantricks-script.sh" ]; then
    cp -f "$SRC_PATH" /root/vantricks-script.sh.tmp
    if grep -q '^main_menu$' /root/vantricks-script.sh.tmp; then
      mv -f /root/vantricks-script.sh.tmp /root/vantricks-script.sh
    else
      rm -f /root/vantricks-script.sh.tmp
    fi
  fi
  chmod +x /root/vantricks-script.sh 2>/dev/null || true
  cat > /usr/local/bin/menu << 'MENUEOF'
#!/bin/bash
if [ -f /root/vantricks-script.sh ]; then
  exec sudo bash /root/vantricks-script.sh "$@"
else
  echo "[!] /root/vantricks-script.sh missing. Re-run installer to restore."
  exit 1
fi
MENUEOF
  chmod +x /usr/local/bin/menu
}

refresh_menu_command() {
  local S="$1"
  install_self_script "$S"
}

