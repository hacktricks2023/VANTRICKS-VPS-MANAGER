R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
C='\033[0;36m'
W='\033[1;37m'
N='\033[0m'

DIV="════════════════════════════════════════════════"
CONFIG_FILE="/etc/vantricks_script.conf"
PACKAGES_FILE="/etc/vantricks_packages.list"
ACCOUNT_PKG_DB="/etc/vantricks_account_packages.db"
