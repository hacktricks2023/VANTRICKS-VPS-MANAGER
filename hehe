  (
    exec > /dev/null 2>&1

    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      openssh-server curl wget python3 openssl net-tools psmisc > /dev/null 2>&1

    # Completely nuke apache2 — it conflicts with sslh on port 80/443
