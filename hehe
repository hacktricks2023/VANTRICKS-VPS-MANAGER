v2ray_delete_account() {
  clear
  ui_top
  ui_center "${Y}◆${N} ${W}DELETE V2RAY ACCOUNT${N} ${Y}◆${N}"
  ui_mid

  if [ ! -f "$XRAY_DB" ] || [ ! -s "$XRAY_DB" ]; then
    ui_row "  ${Y}No accounts found.${N}"
    ui_bot
    press_enter
    return
  fi

  USERS=()
  UUIDS=()
  INDEX=1
  while IFS= read -r line; do
    [ -z "$line" ] && break
    vuser=$(echo "$line" | awk '{print $1}')
    vuuid=$(echo "$line" | awk '{print $2}')
    NCOLS=$(echo "$line" | awk '{print NF}')
    if [ "$NCOLS" -ge 5 ]; then
      vproto=$(echo "$line" | awk '{print $5}')
    else
      vproto=$(echo "$line" | awk '{print $4}')
    fi
    ui_row "  ${Y}[$INDEX]${N} ${W}$vuser${N} ${Y}|${N} ${G}$vproto${N}"
    USERS+=("$vuser")
    UUIDS+=("$vuuid")
    INDEX=$((INDEX + 1))
  done < "$XRAY_DB"

  ui_mid
  ui_row "  ${Y}[A]${N} ${W}Delete All V2Ray Accounts${N}"
  ui_row "  ${R}[0]${N} ${W}Back${N} ${DIM}(or Enter)${N}"
  ui_bot
  read -r -p "$(ui_ask 'Select option')" DEL_OPT
  [ -z "$DEL_OPT" ] && return

  if [ "$DEL_OPT" == "0" ]; then
    return
  elif [ "$DEL_OPT" == "A" ]; then
    for u_id in "${UUIDS[@]}"; do
      remove_account_package "vmess" "$u_id"
      remove_account_package "vless" "$u_id"
      remove_account_package "trojan" "$u_id"
    done
    > "$XRAY_DB"
    python3 - "$XRAY_CONF" << 'PYEOF'
import json, sys, os
conf_path = sys.argv[1]
if os.path.exists(conf_path):
    with open(conf_path, 'r') as f:
        cfg = json.load(f)
    for ib in cfg.get('inbounds', []):
        ib.setdefault('settings', {})['clients'] = []
    with open(conf_path, 'w') as f:
        json.dump(cfg, f, indent=2)
PYEOF
    systemctl restart xray > /dev/null 2>&1
    echo -e "\n ${G}[✓] All V2Ray accounts deleted!${N}"
    sleep 2
  elif [[ "$DEL_OPT" =~ ^[0-9]+$ ]] && [ "$DEL_OPT" -ge 1 ] && [ "$DEL_OPT" -lt "$INDEX" ]; then
    TARGET_UUID="${UUIDS[$((DEL_OPT - 1))]}"
    TARGET_USER="${USERS[$((DEL_OPT - 1))]}"
    grep -v "$TARGET_UUID" "$XRAY_DB" > /tmp/xray_db.tmp && mv /tmp/xray_db.tmp "$XRAY_DB"
    remove_account_package "vmess" "$TARGET_UUID"
    remove_account_package "vless" "$TARGET_UUID"
    remove_account_package "trojan" "$TARGET_UUID"
    python3 - "$XRAY_CONF" "$TARGET_UUID" << 'PYEOF'
import json, sys, os
conf_path, target = sys.argv[1], sys.argv[2]
if os.path.exists(conf_path):
    with open(conf_path, 'r') as f:
        cfg = json.load(f)
    for ib in cfg.get('inbounds', []):
        clients = ib.get('settings', {}).get('clients', [])
        ib['settings']['clients'] = [c for c in clients if c.get('id') != target and c.get('password') != target]
    with open(conf_path, 'w') as f:
        json.dump(cfg, f, indent=2)
PYEOF
    systemctl restart xray > /dev/null 2>&1
    echo -e "\n ${G}[✓] Account '$TARGET_USER' deleted!${N}"
    sleep 2
  fi
}

