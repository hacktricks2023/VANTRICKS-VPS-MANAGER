create_ssh_ovpn_user() {
  sync_host_config
  SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  clear
  DATETIME=$(TZ="Asia/Manila" date "+%m-%d-%Y %I:%M:%S %p")
