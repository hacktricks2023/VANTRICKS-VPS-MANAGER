repair_openvpn() {
  local mode="$1"
  systemctl stop openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1 || true
  rm -rf /etc/systemd/system/openvpn-server@.service.d /run/openvpn-server/* 2>/dev/null
  _ovpn_make_certs || { [ "$mode" = "quiet" ] || ui_err "could not build OpenVPN certificates"; return 1; }
  local PAM_SO="/usr/lib/x86_64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so"
  [ -f "$PAM_SO" ] || PAM_SO=$(find /usr/lib -name "openvpn-plugin-auth-pam.so" 2>/dev/null | head -n 1)
  local f
  for f in "$OVPN_DIR/server.conf" "$OVPN_DIR/server-tcp.conf"; do
    [ -f "$f" ] || continue
    sed -i -E 's|^dh .*|dh none|' "$f"
    sed -i -E "s|^plugin .*|plugin ${PAM_SO} login|" "$f"
    grep -q '^dh ' "$f" || echo "dh none" >> "$f"
  done
  [ ! -f "$OVPN_DIR/server.conf" ] && install_openvpn > /dev/null 2>&1
  if [ -f /tmp/ovpn_newca ] && [ -d "$OVPN_CLIENT_DIR" ]; then
    rm -f /tmp/ovpn_newca
    local ovpn u_name
    for ovpn in "${OVPN_CLIENT_DIR}"/*-tcp443.ovpn; do
      [ -f "$ovpn" ] || continue
      u_name=$(basename "$ovpn" "-tcp443.ovpn")
      generate_ovpn_profile "$u_name"
    done
  fi
  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  systemctl restart openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  if [ "$mode" != "quiet" ]; then
    local u t
    u=$(systemctl is-active openvpn-server@server 2>/dev/null)
    t=$(systemctl is-active openvpn-server@server-tcp 2>/dev/null)
    if [ "$u" = active ] && [ "$t" = active ]; then ui_msg "OpenVPN UDP + TCP running"
    else ui_err "OpenVPN UDP=$u TCP=$t  (journalctl -u openvpn-server@server)"; fi
  fi
}

restart_services() {
  clear
  ui_head "RESTARTING ALL SERVICES"
  ui_note "Syncing host, banner, booster & stack..."
  ui_bot
  echo ""
  sync_host_config
  apply_enhancement_booster
  apply_banner_config
  heal_ws_stack force
  mux_heal
  if ! systemctl is-active --quiet openvpn-server@server 2>/dev/null || ! systemctl is-active --quiet openvpn-server@server-tcp 2>/dev/null; then
    repair_openvpn quiet
  fi
  for SVC in ssh stunnel4 nginx ws-proxy-8080 xray dnstt ssh-dnstt slipstream-rust openvpn-server@server openvpn-server@server-tcp; do
    systemctl restart "$SVC" > /dev/null 2>&1
    STATUS=$(systemctl is-active "$SVC" 2>/dev/null)
    if [ "$STATUS" == "active" ]; then
      echo -e "  ${G}[✓]${N} ${W}$SVC${N} restarted"
    else
      echo -e "  ${R}[!]${N} ${W}$SVC${N} failed"
    fi
  done
  systemctl restart sslh > /dev/null 2>&1 || systemctl restart sslh-select > /dev/null 2>&1
  STATUS=$(systemctl is-active sslh 2>/dev/null)
  [ "$STATUS" != "active" ] && STATUS=$(systemctl is-active sslh-select 2>/dev/null)
  if [ "$STATUS" == "active" ]; then
    echo -e "  ${G}[✓]${N} ${W}sslh${N} restarted"
  else
    echo -e "  ${R}[!]${N} ${W}sslh${N} failed"
  fi
  write_motd >/dev/null 2>&1
  echo ""
  press_enter
}

