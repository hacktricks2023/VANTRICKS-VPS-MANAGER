#!/bin/bash
# ==============================================================================
# VANTRICKS VPS MANAGER - FULL AUTOMATED SUITE (NO KEY / ALL IN ONE)
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL VARIABLES & PATHS
# ------------------------------------------------------------------------------
IP_ADDRESS=$(hostname -I | awk '{print $1}')
DOMAIN_FILE="/etc/.domain"
NS_FILE="/etc/.nsdomain"
BANNER_FILE="/etc/issue.net"

# ------------------------------------------------------------------------------
# UI HELPER FUNCTIONS
# ------------------------------------------------------------------------------
fun_bar() {
    local cmd1="$1"
    local cmd2="$2"
    
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        eval "$cmd1" > /dev/null 2>&1
        eval "$cmd2" > /dev/null 2>&1
        touch $HOME/fim
    ) > /dev/null 2>&1 &
    
    tput civis
    echo -ne "  \033[1;33m◇ INSTALLING IN PROGRESS... \033[1;37m- \033[1;33m["
    while true; do
        for ((i=0; i<18; i++)); do
            echo -ne "\033[1;31m#"
            sleep 0.05s
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
        echo -e "\033[1;33m]"
        sleep 0.5s
        tput cuu1
        tput dl1
        echo -ne "  \033[1;33m◇ INSTALLING IN PROGRESS... \033[1;37m- \033[1;33m["
    done
    echo -e "\033[1;33m]\033[1;37m -\033[1;32m◇ DONE!\033[0m"
    tput cnorm
}

show_header() {
    clear
    tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "◇─────────ㅤ🌍 VANTRICKS VPS MANAGER (UNLOCKED) 🌍ㅤ─────────◇" ; tput sgr0
    echo ""
}

# ------------------------------------------------------------------------------
# CORE INSTALLATION MODULES
# ------------------------------------------------------------------------------

# 1. Base Package Installation
install_packages() {
    local pacotes=(
        "bc" "cron" "screen" "nano" "unzip" "lsof" "net-tools" 
        "dos2unix" "nload" "jq" "curl" "figlet" "python3" "python3-pip"
        "socat" "iptables" "tar" "git" "uuid-runtime"
    )
    apt-get update -y > /dev/null 2>&1
    for prog in "${pacotes[@]}"; do
        apt-get install -y "$prog" > /dev/null 2>&1
    done

    if ! id "lxd1" &>/dev/null; then
        useradd -m -s /bin/false lxd1
        echo "lxd1:0001" | chpasswd
    fi
}

# 2. Custom OpenSSH Configurations
install_custom_openssh() {
    sed -i 's/#Port 22/Port 22/' /etc/ssh/sshd_config
    sed -i 's/Port 22222/Port 22/' /etc/ssh/sshd_config
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
    sed -i 's/#Banner none/Banner \/etc\/issue.net/' /etc/ssh/sshd_config
    systemctl restart ssh > /dev/null 2>&1 || service ssh restart > /dev/null 2>&1
}

# 3. Nginx Installation & Setup
install_nginx() {
    apt-get install -y nginx > /dev/null 2>&1
    systemctl enable nginx > /dev/null 2>&1
    systemctl restart nginx > /dev/null 2>&1
}

# 4. Certbot / SSL Installation
install_ssl() {
    apt-get install -y certbot python3-certbot-nginx > /dev/null 2>&1
    if [[ -f "$DOMAIN_FILE" ]]; then
        local domain=$(cat "$DOMAIN_FILE")
        certbot --nginx -d "$domain" --non-interactive --agree-tos --register-unsafely-without-email > /dev/null 2>&1
    fi
}

# 5. WebSocket Proxy Setup & XHTTP
install_websocket() {
    wget -O /usr/local/bin/ws-server https://raw.githubusercontent.com/hacktricks2023/VANTRICKS-VPS-MANAGER/main/Install/ws-server > /dev/null 2>&1 || true
    chmod +x /usr/local/bin/ws-server > /dev/null 2>&1
    
    mkdir -p /etc/xhttp
    echo "XHTTP Core framework initialized." > /etc/xhttp/config.json
}

# 6. SlowDNS / DNSTT Setup
install_dnstt() {
    rm -rf /tmp/install_sdns
    wget -O /tmp/install_sdns https://raw.githubusercontent.com/leitura/slowdns/main/install > /dev/null 2>&1
    if [[ -f /tmp/install_sdns ]]; then
        chmod +x /tmp/install_sdns
        /tmp/install_sdns auto > /dev/null 2>&1 || true
    fi
}

# 7. OpenVPN & V2Ray Setup
install_ovpn_v2ray() {
    apt-get install -y openvpn ca-certificates > /dev/null 2>&1
    bash <(curl -L https://raw.githubusercontent.com/v2fly/fhs-install-v2ray/master/install-release.sh) > /dev/null 2>&1 || true
}

# ------------------------------------------------------------------------------
# HOST, NAMESERVER & BANNER MANAGEMENT
# ------------------------------------------------------------------------------
configure_domain_ns() {
    echo -e "\033[1;36m◇ DOMAIN & NAMESERVER CONFIGURATION\033[0m"
    
    echo -ne "\033[1;33m◇ Enter Host/Domain Name (e.g., vps.example.com) [Press Enter to skip]: \033[0m"
    read input_domain
    if [[ -n "$input_domain" ]]; then
        echo "$input_domain" > "$DOMAIN_FILE"
        echo -e "\033[1;32m✔ Host updated: $input_domain\033[0m"
    fi

    echo -ne "\033[1;33m◇ Enter NS (Nameserver) Domain (e.g., ns.example.com) [Press Enter to skip]: \033[0m"
    read input_ns
    if [[ -n "$input_ns" ]]; then
        echo "$input_ns" > "$NS_FILE"
        echo -e "\033[1;32m✔ Nameserver updated: $input_ns\033[0m"
    fi
    echo ""
}

# ------------------------------------------------------------------------------
# INTERACTIVE MENU GENERATOR (Merged Accounts & Easy Setup)
# ------------------------------------------------------------------------------
build_menu_system() {
cat << 'EOF' > /bin/menu
#!/bin/bash
IP=$(hostname -I | awk '{print $1}')
DOM=$(cat /etc/.domain 2>/dev/null || echo "No-Domain-Set")
NS=$(cat /etc/.nsdomain 2>/dev/null || echo "No-NS-Set")

create_merged_account() {
    clear
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e "\033[1;32m       CREATE UNIFIED ACCOUNT (ALL PROTOCOLS)       \033[0m"
    echo -e "\033[1;36m====================================================\033[0m"
    read -p " ➔ Enter Username : " usr
    read -p " ➔ Enter Password : " pass
    read -p " ➔ Validity (Days): " days

    # 1. SSH Account Creation
    EXP=$(date -d "+$days days" +%Y-%m-%d)
    useradd -e $EXP -M -s /bin/false $usr 2>/dev/null
    echo "$usr:$pass" | chpasswd
    
    # 2. V2Ray UUID Generation
    V_UUID=$(uuidgen)

    # Output Block for Easy Copy
    clear
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e "\033[1;32m     SUCCESS! CREDENTIALS READY TO COPY             \033[0m"
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e " \033[1;33m[ ACCOUNT DETAILS ]\033[0m"
    echo -e " Username   : \033[1;37m$usr\033[0m"
    echo -e " Password   : \033[1;37m$pass\033[0m"
    echo -e " Expiration : \033[1;37m$EXP ($days Days)\033[0m"
    echo -e " Host/IP    : \033[1;37m$IP\033[0m"
    echo -e " Domain     : \033[1;37m$DOM\033[0m"
    echo -e " NS Domain  : \033[1;37m$NS\033[0m"
    echo -e "\033[1;36m----------------------------------------------------\033[0m"
    echo -e " \033[1;33m[ SUPPORTED PORTS ]\033[0m"
    echo -e " SSH / Dropbear : \033[1;37m22\033[0m"
    echo -e " OpenVPN        : \033[1;37m1194\033[0m"
    echo -e " SlowDNS        : \033[1;37m53, 5300\033[0m"
    echo -e " WS HTTP/HTTPS  : \033[1;37m80 / 443\033[0m"
    echo -e "\033[1;36m----------------------------------------------------\033[0m"
    echo -e " \033[1;33m[ WEBSOCKET PAYLOAD (COPY/PASTE) ]\033[0m"
    echo -e " GET / HTTP/1.1[crlf]Host: $DOM[crlf]Upgrade: websocket[crlf][crlf]"
    echo -e "\033[1;36m----------------------------------------------------\033[0m"
    echo -e " \033[1;33m[ V2RAY VMESS CONFIG (COPY/PASTE) ]\033[0m"
    echo -e " {\"v\": \"2\", \"ps\": \"$usr-VMESS\", \"add\": \"$IP\", \"port\": \"80\", \"id\": \"$V_UUID\", \"net\": \"ws\", \"host\": \"$DOM\", \"path\": \"/\"}"
    echo -e "\033[1;36m====================================================\033[0m"
    echo ""
    read -p " Press Enter to return to menu..."
}

update_host_ns() {
    clear
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e "\033[1;32m         UPDATE HOST & NS (WITH AUTO RESTART)       \033[0m"
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e " 1) Update Domain / Host (Current: $DOM)"
    echo -e " 2) Update Nameserver (Current: $NS)"
    echo -e " 0) Back to Menu"
    echo -e "\033[1;36m====================================================\033[0m"
    read -p " Select an option: " hs_opt
    
    case $hs_opt in
        1)
            read -p " Enter New Domain: " new_dom
            echo "$new_dom" > /etc/.domain
            echo -e "\033[1;32m Updating Domain and restarting services (Nginx/V2Ray/WS)...\033[0m"
            systemctl restart nginx v2ray >/dev/null 2>&1
            echo -e "\033[1;32m Successfully Updated!\033[0m"
            sleep 2
            ;;
        2)
            read -p " Enter New NS Domain: " new_ns
            echo "$new_ns" > /etc/.nsdomain
            echo -e "\033[1;32m Updating NS and restarting SlowDNS/DNSTT...\033[0m"
            systemctl restart slowdns dnstt-server >/dev/null 2>&1
            echo -e "\033[1;32m Successfully Updated!\033[0m"
            sleep 2
            ;;
        0) return ;;
    esac
}

update_banner() {
    clear
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e "\033[1;32m             SSH BANNER CONFIGURATION               \033[0m"
    echo -e "\033[1;36m====================================================\033[0m"
    echo -e " 1) Apply Standard Premium Banner"
    echo -e " 2) Apply Strict Warning / Rules Banner"
    echo -e " 3) Custom Input Banner"
    echo -e " 0) Back to Menu"
    echo -e "\033[1;36m====================================================\033[0m"
    read -p " Select an option: " ban_opt
    
    case $ban_opt in
        1)
            echo "<br><font color='#00FF00'><b>==============================</b></font><br><font color='#FFFFFF'><b>PREMIUM SERVER CONNECTED</b></font><br><font color='#00FF00'><b>==============================</b></font>" > /etc/issue.net
            ;;
        2)
            echo "<br><font color='#FF0000'><b>==============================</b></font><br><font color='#FFFFFF'><b>NO SPAM. NO HACKING. NO TORRENT.</b></font><br><font color='#FF0000'><b>==============================</b></font>" > /etc/issue.net
            ;;
        3)
            echo "Enter your Custom Banner (HTML Supported):"
            read custom_ban
            echo "$custom_ban" > /etc/issue.net
            ;;
        0) return ;;
    esac
    
    echo -e "\033[1;32m Auto-Restarting SSH Service...\033[0m"
    systemctl restart ssh sshd >/dev/null 2>&1
    echo -e "\033[1;32m Banner Applied Successfully!\033[0m"
    sleep 2
}

while true; do
    clear
    echo -e "\033[1;36m◇─────────ㅤ🌍 VANTRICKS VPS MANAGER 🌍ㅤ─────────◇\033[0m"
    echo -e " Server IP  : \033[1;32m$IP\033[0m"
    echo -e " Domain     : \033[1;33m$DOM\033[0m"
    echo -e " Nameserver : \033[1;33m$NS\033[0m"
    echo -e "\033[1;36m=======================================================\033[0m"
    echo -e " \033[1;32m[1]\033[0m ➔ Create Merged Account (SSH, V2Ray, OpenVPN)"
    echo -e " \033[1;32m[2]\033[0m ➔ Update Host & NS Config (Auto-Restart)"
    echo -e " \033[1;32m[3]\033[0m ➔ Update SSH Banner"
    echo -e " \033[1;31m[0]\033[0m ➔ Exit Manager"
    echo -e "\033[1;36m=======================================================\033[0m"
    read -p " Select Option: " main_opt
    
    case $main_opt in
        1) create_merged_account ;;
        2) update_host_ns ;;
        3) update_banner ;;
        0) clear; exit 0 ;;
        *) echo -e "\033[1;31m Invalid Option!\033[0m"; sleep 1 ;;
    esac
done
EOF
chmod +x /bin/menu
ln -sf /bin/menu /bin/h
}

# ------------------------------------------------------------------------------
# MAIN EXECUTION FLOW
# ------------------------------------------------------------------------------

show_header

# 1. Privilege Check
if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[ERROR] This script must be executed as root!\033[0m"
    exit 1
fi

# 2. Host and NameServer Configuration Prompt
configure_domain_ns

# 3. Begin Automated Merge Installation
echo -e "\033[1;33m◇ STARTING FULL AUTOMATED SUITE INSTALLATION...\033[0m"
echo ""

echo -e "\033[1;32m[1/7] Updating System & Installing Core Dependencies...\033[0m"
fun_bar 'install_packages'

echo -e "\033[1;32m[2/7] Configuring Custom OpenSSH...\033[0m"
fun_bar 'install_custom_openssh'

echo -e "\033[1;32m[3/7] Deploying Nginx & Requesting SSL Certificates...\033[0m"
fun_bar 'install_nginx' 'install_ssl'

echo -e "\033[1;32m[4/7] Installing WebSocket & XHTTP Protocol Handlers...\033[0m"
fun_bar 'install_websocket'

echo -e "\033[1;32m[5/7] Configuring SlowDNS & DNSTT Services...\033[0m"
fun_bar 'install_dnstt'

echo -e "\033[1;32m[6/7] Installing OpenVPN & V2Ray Core Engine...\033[0m"
fun_bar 'install_ovpn_v2ray'

echo -e "\033[1;32m[7/7] Generating Interactive Menu UI...\033[0m"
fun_bar 'build_menu_system'

# Firewall Unlocks
if [[ -f "/usr/sbin/ufw" ]]; then
    ufw allow 22/tcp > /dev/null 2>&1
    ufw allow 80/tcp > /dev/null 2>&1
    ufw allow 443/tcp > /dev/null 2>&1
    ufw allow 1194/tcp > /dev/null 2>&1
    ufw allow 1194/udp > /dev/null 2>&1
    ufw allow 53/udp > /dev/null 2>&1
fi

# Clean execution history
cat /dev/null > ~/.bash_history && history -c

# ------------------------------------------------------------------------------
# COMPLETION
# ------------------------------------------------------------------------------
show_header
echo -e "        \033[1;32m◇ ALL INSTALLATIONS COMPLETED SUCCESSFULLY! ◇\033[0m"
echo ""
echo -e "\033[1;33m◇ RUN MAIN MENU COMMAND : \033[1;32mmenu\033[0m or \033[1;32mh\033[0m"
echo ""
echo -e "\033[1;36m=============================================================\033[0m"
