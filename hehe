create_vmess() {
  clear
  source "$CONFIG_FILE"
  SERVER_IP=$(hostname -I | awk '{print $1}')
  read -p " Username : " user
  read -p " Expire (Days) : " days
  uuid=$(cat /proc/sys/kernel/random/uuid)
  exp=$(date -d "+$days days" +"%Y-%m-%d")

  python3 -c "
import json
with open('/usr/local/etc/xray/config.json', 'r') as f: data = json.load(f)
for ib in data['inbounds']:
    if ib['protocol'] == 'vmess':
        ib['settings']['clients'].append({'id': '$uuid', 'alterId': 0, 'email': '$user'})
with open('/usr/local/etc/xray/config.json', 'w') as f: json.dump(data, f, indent=2)
"
  echo "vmess $user $exp $uuid" >> /etc/xray/accounts.db
  systemctl restart xray > /dev/null 2>&1

  cat > /tmp/vmcfg.json << EOF
{
  "v": "2", "ps": "$user", "add": "${HOST}", "port": "80",
  "id": "${uuid}", "aid": "0", "scy": "auto", "net": "ws",
  "type": "none", "host": "${HOST}", "path": "/vmess", "tls": "none"
}
EOF
  link="vmess://$(cat /tmp/vmcfg.json | base64 -w 0)"
  rm -f /tmp/vmcfg.json

  clear
  echo -e "${G}=======================================${NC}"
  echo -e "${G} VMess Account Created Successfully! ${NC}"
  echo -e "${G}=======================================${NC}"
  echo -e " Username : $user"
  echo -e " Expired On : $exp"
  echo -e " Host/IP : ${HOST} / ${SERVER_IP}"
  echo -e " Port TLS : 443"
  echo -e " Port Non-TLS : 80"
  echo -e " Path : /vmess"
  echo -e " UUID : $uuid"
  echo -e "======================================="
  echo -e " VMess Link : ${link}"
  echo -e "======================================="
  
  post_creation_menu
}

delete_xray() {
  clear
  read -p " Username to delete : " user
  if grep -q " $user " /etc/xray/accounts.db; then
    sed -i "/ $user /d" /etc/xray/accounts.db
    python3 -c "
import json
with open('/usr/local/etc/xray/config.json', 'r') as f: data = json.load(f)
for ib in data['inbounds']:
    if 'clients' in ib.get('settings', {}):
        ib['settings']['clients'] = [c for c in ib['settings']['clients'] if c.get('email') != '$user']
with open('/usr/local/etc/xray/config.json', 'w') as f: json.dump(data, f, indent=2)
"
    systemctl restart xray > /dev/null 2>&1
    echo -e "${G}Account deleted.${NC}"
  else
    echo -e "${R}User not found.${NC}"
  fi
  press_enter
  xray_menu
}

list_xray() {
  clear
  echo -e "${C}========================================================================${NC}"
  echo -e "${W} Xray Account List ${NC}"
  echo -e "${C}========================================================================${NC}"
  NOW_S=$(date +%s)
  if [ -f /etc/xray/accounts.db ]; then
    while read -r proto u e uuid; do
      EXP_S=$(date -d "$e" +%s 2>/dev/null)
      if [ -n "$EXP_S" ] && [ "$EXP_S" -lt "$NOW_S" ]; then
        printf " %-7s %-12s %-12s ${R}[EXPIRED] - Contact vantricks to renew your account${NC}\n" "$proto" "$u" "$e"
      else
        printf " %-7s %-12s %-12s ${G}[ACTIVE]${NC}\n" "$proto" "$u" "$e"
      fi
    done < /etc/xray/accounts.db
  fi
  echo -e "${C}========================================================================${NC}"
  press_enter
  xray_menu
}

renew_xray() {
  clear
  read -p " Username : " user
  if grep -q " $user " /etc/xray/accounts.db; then
    read -p " Extend (Days) : " days
    exp=$(date -d "+$days days" +"%Y-%m-%d")
    awk -v u="$user" -v e="$exp" '{if ($2==u) {$3=e}; print $0}' /etc/xray/accounts.db > /tmp/xdb
    mv /tmp/xdb /etc/xray/accounts.db
    systemctl restart xray > /dev/null 2>&1
    echo -e "${G}Account renewed until $exp.${NC}"
  else
    echo -e "${R}User not found.${NC}"
  fi
  press_enter
  xray_menu
}

