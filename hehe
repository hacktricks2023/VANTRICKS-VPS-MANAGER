install_all() {
  clear
  ui_head "Vantricks VPS Manager - INSTALL"
  ui_row "  ${W}Installing... Please wait${N}"
  ui_bot
  echo ""

  spin() {
    local pid=$1
    local i=0
    local sp='-\|/'
    while kill -0 $pid 2>/dev/null; do
      printf "\r [${sp:$i:1}] Please wait..."
      i=$(( (i+1) % 4 ))
      sleep 0.3
    done
    printf "\r%-40s\r [✓] Installation complete!\n" ""
  }

  (
    exec > /dev/null 2>&1

    apt-get update -y
    install_python_deps
    init_packages_store
    install_booster_python

    systemctl stop apache2 > /dev/null 2>&1
    systemctl disable apache2 > /dev/null 2>&1
    systemctl mask apache2 > /dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get remove --purge -y apache2 apache2-bin apache2-data apache2-utils apache2-* > /dev/null 2>&1
    apt-get autoremove -y > /dev/null 2>&1
    apt-get autoclean -y > /dev/null 2>&1
    rm -rf /etc/apache2 /var/www/html /var/log/apache2 > /dev/null 2>&1
    fuser -k 80/tcp > /dev/null 2>&1
    fuser -k 443/tcp > /dev/null 2>&1

    NEW_HOSTNAME=$(echo "$INPUT_HOST" | cut -d'.' -f1)
    hostnamectl set-hostname "$NEW_HOSTNAME" > /dev/null 2>&1
    echo "127.0.0.1 $NEW_HOSTNAME" >> /etc/hosts

    timedatectl set-timezone Asia/Manila > /dev/null 2>&1

    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config

    printf "%s\n" "${BANNER_TEXT:-$DEFAULT_BANNER_TEXT}" > "$SSH_BANNER_FILE"
    set_sshd_banner_global
    systemctl enable ssh > /dev/null 2>&1
    systemctl restart ssh > /dev/null 2>&1

    install_ssl
    install_nginx
    install_websocket
    heal_ws_stack force
    install_dnstt
    install_ssh_dnstt
    install_slipstream
    install_openvpn
    install_v2ray_auto
    sync_host_config
    install_custom_openssh
    apply_banner_config
    apply_enhancement_booster
    heal_network_layer
    persist_iptables

    cp "$(realpath "$0")" /root/vantricks-script.sh
    chmod +x /root/vantricks-script.sh
    mark_installed_version
    echo "#!/bin/bash" > /usr/local/bin/menu
    echo "sudo bash /root/vantricks-script.sh" >> /usr/local/bin/menu
    chmod +x /usr/local/bin/menu
  ) &
  spin $!

  echo ""

  write_motd
  echo -e " ${G}[✓] Login info screen installed!${N}"

  write_startup_service
  echo -e " ${G}[✓] Startup service installed!${N}"
  echo -e " ${Y}[*] Waiting for services to start...${N}"
  sleep 5
  systemctl restart stunnel4 > /dev/null 2>&1
  systemctl restart sslh > /dev/null 2>&1 || systemctl restart sslh-select > /dev/null 2>&1
  systemctl restart xray dnstt ssh-dnstt slipstream-rust > /dev/null 2>&1
  sleep 5

  show_summary
  read -p " Press Enter to reboot... "

  echo ""
  ui_mid
  echo -e "${G} Rebooting in...${N}"
  for i in 3 2 1; do
    echo -e "${R}   $i...${N}"
    sleep 1
  done
  echo -e "${G} Reconnect and type: menu${N}"
  sleep 1
  reboot
}

