#!/usr/bin/env bash
# ==============================================================================
# VANTRICKS VPS MANAGER - SECURE AUTOMATED HARDENED SUITE
# ==============================================================================
set -euo pipefail
IFS=$'\n\t'

# Environment Guards
readonly LOG_FILE="/var/log/vps_install.log"
readonly DOMAIN_FILE="/etc/.vps_domain"
readonly NS_FILE="/etc/.vps_nsdomain"
readonly BANNER_FILE="/etc/issue.net"

# Color Codes
readonly RED='\033[1;31m'
readonly GREEN='\033[1;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[1;36m'
readonly NC='\033[0m'

log() {
    echo -e "${GREEN}[INFO]${NC} $1" | tee -a "$LOG_FILE"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1" | tee -a "$LOG_FILE"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG_FILE" >&2
    exit 1
}

# Ensure Root Execution
if [[ "$(id -u)" -ne 0 ]]; then
    error "This script must be executed with root privileges."
fi

# Modern Non-blocking Progress Bar Execution
run_task() {
    local task_name="$1"
    shift
    local cmd=("$@")

    log "Starting task: ${task_name}"
    "${cmd[@]}" >> "$LOG_FILE" 2>&1 &
    local pid=$!

    local spin='-\|/'
    local i=0
    tput civis
    while kill -0 "$pid" 2>/dev/null; do
        i=$(( (i+1) % 4 ))
        printf "\r${BLUE}  ◇ [%c] Working on: %s...${NC}" "${spin:$i:1}" "$task_name"
        sleep 0.1
    done
    tput cnorm
    
    wait "$pid" || error "Task '${task_name}' failed. See ${LOG_FILE}"
    printf "\r${GREEN}  ✔ Finished: %s${NC}\n" "$task_name"
}

# Core Install Routines
install_packages() {
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends \
        bc cron screen nano unzip lsof net-tools \
        dos2unix nload jq curl figlet python3 python3-pip \
        socat iptables tar git nginx certbot python3-certbot-nginx \
        sslh stunnel4 openvpn ca-certificates
}

configure_ssh() {
    sed -i 's/#Port 22/Port 22/' /etc/ssh/sshd_config
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
    sed -i 's/#Banner none/Banner \/etc\/issue.net/' /etc/ssh/sshd_config
    
    # Restrict permissions on banner
    touch "$BANNER_FILE"
    chmod 644 "$BANNER_FILE"
    
    systemctl restart ssh
}

configure_network_services() {
    # Certificate Provisioning
    if [[ -f "$DOMAIN_FILE" ]]; then
        local domain
        domain=$(cat "$DOMAIN_FILE")
        certbot --nginx -d "$domain" --non-interactive --agree-tos --register-unsafely-without-email || true
    fi

    # UFW Hardening (UDP services pruned)
    if command -v ufw >/dev/null 2>&1; then
        ufw allow 22/tcp
        ufw allow 80/tcp
        ufw allow 443/tcp
        ufw allow 53/udp
        ufw allow 1194/tcp
        ufw allow 8080/tcp
    fi
}

main() {
    clear
    log "Initializing Hardened Setup Environment..."
    
    # Set secure permissions
    umask 027
    
    run_task "Base Package Installation" install_packages
    run_task "OpenSSH Hardening" configure_ssh
    run_task "Network Services & Firewall Setup" configure_network_services

    log "Installation completed successfully."
}

main "$@"
