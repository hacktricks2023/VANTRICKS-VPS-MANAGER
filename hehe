install_ovpn() {
  echo -e " ${Y}[*] Installing OpenVPN...${N}"
  DEBIAN_FRONTEND=noninteractive apt-get install -y openvpn iptables easy-rsa > /dev/null 2>&1

  # Generate CA and Certs
  make-cadir /etc/openvpn/easy-rsa
  cd /etc/openvpn/easy-rsa
  ./easyrsa init-pki > /dev/null 2>&1
  EASYRSA_BATCH=1 ./easyrsa build-ca nopass > /dev/null 2>&1
  EASYRSA_BATCH=1 ./easyrsa gen-req server nopass > /dev/null 2>&1
  EASYRSA_BATCH=1 ./easyrsa sign-req server server > /dev/null 2>&1
  EASYRSA_BATCH=1 ./easyrsa gen-dh > /dev/null 2>&1
  openvpn --genkey secret ta.key > /dev/null 2>&1

  cp pki/ca.crt /etc/openvpn/
  cp pki/issued/server.crt /etc/openvpn/
  cp pki/private/server.key /etc/openvpn/
  cp pki/dh.pem /etc/openvpn/
  cp ta.key /etc/openvpn/

  # Find PAM Plugin
  PLUGIN_PATH=$(find /usr/lib -name "openvpn-plugin-auth-pam.so" | head -n 1)
  [ -z "$PLUGIN_PATH" ] && PLUGIN_PATH="/usr/lib/openvpn/openvpn-plugin-auth-pam.so"

  cat > /etc/openvpn/server.conf << EOF
port 1194
proto udp
dev tun
ca ca.crt
cert server.crt
key server.key
dh dh.pem
plugin $PLUGIN_PATH login
verify-client-cert none
username-as-common-name
server 10.8.0.0 255.255.255.0
ifconfig-pool-persist ipp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
keepalive 10 120
cipher AES-256-CBC
user nobody
group nogroup
persist-key
persist-tun
status openvpn-status.log
verb 3
EOF

  sed -i 's/#net.ipv4.ip_forward=1/net.ipv4.ip_forward=1/g' /etc/sysctl.conf
  sysctl -p > /dev/null 2>&1

  IFACE=$(ip route | grep default | awk '{print $5}' | head -1)
  iptables -t nat -I POSTROUTING 1 -s 10.8.0.0/24 -o $IFACE -j MASQUERADE
  iptables-save > /etc/iptables.up.rules
  
  cat > /etc/network/if-pre-up.d/iptables << 'IPT'
#!/bin/sh
iptables-restore < /etc/iptables.up.rules
IPT
  chmod +x /etc/network/if-pre-up.d/iptables

  systemctl enable openvpn@server > /dev/null 2>&1
  systemctl restart openvpn@server > /dev/null 2>&1

  # Create universal client template
  cat > /root/client.ovpn << OVPNCLI
client
dev tun
proto udp
remote ${SERVER_IP} 1194
resolv-retry infinite
nobind
persist-key
persist-tun
auth-user-pass
cipher AES-256-CBC
auth SHA256
verb 3
<ca>
$(cat /etc/openvpn/ca.crt)
</ca>
OVPNCLI

  echo -e " ${G}[✓] OpenVPN running on port 1194 (UDP)${N}"
}

install_custom_openssh() {
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential zlib1g-dev libssl-dev libpam0g-dev \
    libselinux1-dev libedit-dev autoconf > /dev/null 2>&1

  OPENSSH_VER="9.2p1"
  cd /tmp
  wget -q "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${OPENSSH_VER}.tar.gz" -O openssh-src.tar.gz 2>/dev/null
  tar -xzf openssh-src.tar.gz > /dev/null 2>&1
  cd openssh-${OPENSSH_VER}

  # Patch version string
  sed -i 's/#define SSH_VERSION.*/#define SSH_VERSION "Blu-2026-SSH"/' version.h
  sed -i 's/#define SSH_PORTABLE.*/#define SSH_PORTABLE ""/' version.h

  ./configure --prefix=/usr --sysconfdir=/etc/ssh --with-pam > /dev/null 2>&1
  make -j$(nproc) > /dev/null 2>&1

  # Stop ssh before replacing binary to avoid "Text file busy"
  systemctl stop ssh > /dev/null 2>&1
  systemctl stop sshd > /dev/null 2>&1
  install -m 755 sshd /usr/sbin/sshd

  # Create required dirs and sshd user for privilege separation
  mkdir -p /var/empty /run/sshd
  chown root:root /var/empty
  chmod 755 /var/empty
  useradd -r -s /sbin/nologin -d /var/empty sshd > /dev/null 2>&1 || true

  # Fix systemd service to use -D flag (foreground) with Type=simple
  cat > /etc/systemd/system/ssh.service << 'SVCEOF'
[Unit]
Description=Blu-2026-SSH Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/sshd -D
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
SVCEOF

  systemctl daemon-reload > /dev/null 2>&1
  systemctl enable ssh > /dev/null 2>&1
  systemctl start ssh > /dev/null 2>&1

  cd /tmp && rm -rf openssh-${OPENSSH_VER} openssh-src.tar.gz
  echo -e " ${G}[✓] Blu-2026-SSH installed!${N}"
}

