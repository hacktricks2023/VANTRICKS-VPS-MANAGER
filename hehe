# ══════════════════════════════════════════════
#   INSTALL OPENVPN (TCP/443 via sslh + UDP/1194)
# ══════════════════════════════════════════════

install_openvpn() {
  echo -e " ${Y}[*] Installing & configuring OpenVPN (TCP/443 + UDP/1194)...${N}"
  mkdir -p "$OVPN_DIR" "$OVPN_CLIENT_DIR" /etc/openvpn/easy-rsa /var/log/openvpn

  if [ -d /usr/share/easy-rsa ]; then
    cp -r /usr/share/easy-rsa/* /etc/openvpn/easy-rsa/ 2>/dev/null || true
  fi

  cd /etc/openvpn/easy-rsa || return
  export EASYRSA_BATCH=1
  export EASYRSA_REQ_CN="Vantricks-OVPN-CA"

  if [ ! -f /etc/openvpn/easy-rsa/pki/ca.crt ]; then
    ./easyrsa init-pki > /dev/null 2>&1
    ./easyrsa build-ca nopass > /dev/null 2>&1
    ./easyrsa gen-dh > /dev/null 2>&1
    ./easyrsa build-server-full server nopass > /dev/null 2>&1
    ./easyrsa build-client-full vantricks-client nopass > /dev/null 2>&1
    openvpn --genkey secret /etc/openvpn/easy-rsa/pki/ta.key > /dev/null 2>&1
  fi

  cp /etc/openvpn/easy-rsa/pki/ca.crt "$OVPN_DIR/" 2>/dev/null || true
  cp /etc/openvpn/easy-rsa/pki/issued/server.crt "$OVPN_DIR/" 2>/dev/null || true
  cp /etc/openvpn/easy-rsa/pki/private/server.key "$OVPN_DIR/" 2>/dev/null || true
  cp /etc/openvpn/easy-rsa/pki/dh.pem "$OVPN_DIR/" 2>/dev/null || true
  cp /etc/openvpn/easy-rsa/pki/ta.key "$OVPN_DIR/" 2>/dev/null || true

  PAM_SO="/usr/lib/x86_64-linux-gnu/openvpn/plugins/openvpn-plugin-auth-pam.so"
  if [ ! -f "$PAM_SO" ]; then
    PAM_SO=$(find /usr/lib -name "openvpn-plugin-auth-pam.so" 2>/dev/null | head -n 1)
  fi

  cat > "${OVPN_DIR}/server.conf" << EOF
port 1194
proto udp
dev tun
ca ca.crt
cert server.crt
key server.key
dh dh.pem
auth SHA256
tls-auth ta.key 0
topology subnet
server 10.8.0.0 255.255.255.0
ifconfig-pool-persist /var/log/openvpn/ipp-udp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
keepalive 10 120
cipher AES-256-GCM
user nobody
group nogroup
persist-key
persist-tun
status /var/log/openvpn/openvpn-udp-status.log
verb 3
plugin ${PAM_SO} login
username-as-common-name
EOF

  cat > "${OVPN_DIR}/server-tcp.conf" << EOF
port 11940
proto tcp-server
dev tun1
ca ca.crt
cert server.crt
key server.key
dh dh.pem
auth SHA256
tls-auth ta.key 0
topology subnet
server 10.9.0.0 255.255.255.0
ifconfig-pool-persist /var/log/openvpn/ipp-tcp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
keepalive 10 120
cipher AES-256-GCM
user nobody
group nogroup
persist-key
persist-tun
status /var/log/openvpn/openvpn-tcp-status.log
verb 3
plugin ${PAM_SO} login
username-as-common-name
EOF

  sed -i 's/^#*net.ipv4.ip_forward=.*/net.ipv4.ip_forward=1/' /etc/sysctl.conf
  grep -q "^net.ipv4.ip_forward=1" /etc/sysctl.conf || echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
  sysctl -p > /dev/null 2>&1

  IFACE=$(ip route | grep default | awk '{print $5}' | head -1)
  if [ -n "$IFACE" ]; then
    iptables -t nat -C POSTROUTING -s 10.8.0.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o "$IFACE" -j MASQUERADE
    iptables -t nat -C POSTROUTING -s 10.9.0.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -s 10.9.0.0/24 -o "$IFACE" -j MASQUERADE
  fi
  iptables -C INPUT -p udp --dport 1194 -j ACCEPT 2>/dev/null || iptables -A INPUT -p udp --dport 1194 -j ACCEPT
  netfilter-persistent save > /dev/null 2>&1 || true

  systemctl enable openvpn@server openvpn@server-tcp > /dev/null 2>&1
  systemctl restart openvpn@server openvpn@server-tcp > /dev/null 2>&1
  echo -e " ${G}[✓] OpenVPN ready on TCP/443 (via sslh -> 11940) & UDP/1194${N}"
}

