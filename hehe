  IFS='|' read -r lim src <<< "$(python3 "$MUX_PY" limit "$U" 2>/dev/null)"
  echo -e "  Now          : ${G}${lim:-?}${N} device(s) ${DIM}(${src:-?})${N}"
  read -r -p "  New limit (number · 0 = no limit · a = auto): " L
  case "$L" in
    "") return ;;
    a|A) python3 "$MUX_PY" set-limit "$U" auto; ui_msg "$U is back to auto" ;;
    *[!0-9]*) ui_err "Type a number, 0 or a"; sleep 1.5; return ;;
    *) python3 "$MUX_PY" set-limit "$U" "$L"; ui_msg "$U limit = $L" ;;
  esac
  sleep 1.5
}

mux_slotbar() {
  local u="$1" l="$2" cells f i col="$G" s=""
  if [ "$l" -le 0 ]; then cells=$((u < 1 ? 1 : u)); else cells="$l"; fi
  [ "$cells" -gt 8 ] && cells=8
  f="$u"; [ "$f" -gt "$cells" ] && f="$cells"
  if [ "$l" -gt 0 ] && [ "$u" -gt "$l" ]; then col="$R"; elif [ "$l" -gt 0 ] && [ "$u" -eq "$l" ]; then col="$Y"; fi
  for ((i = 0; i < cells; i++)); do
    if [ "$i" -lt "$f" ]; then s+="${col}▰${N}"; else s+="${DIM}▱${N}"; fi
  done
  printf '%b%*s' "$s" "$((8 - cells))" ''
}

mux_live_dashboard() {
  local SNAP K ans ts pill t a b c d e col tag cnt mark idle idlen idleshown custom
  local T_ON T_DEV T_ACC T_OVER H_AUTO H_POL H_DEF H_GAGE H_KICK
  while true; do
    ensure_default_toggles
    SNAP=$(python3 "$MUX_PY" snapshot 2>/dev/null)
    ts=$(TZ="Asia/Manila" date '+%I:%M:%S %p')
    IFS='|' read -r _ T_ON T_DEV T_ACC T_OVER <<< "$(grep -m1 '^T|' <<< "$SNAP")"
    IFS='|' read -r _ H_AUTO H_POL H_DEF H_GAGE H_KICK <<< "$(grep -m1 '^H|' <<< "$SNAP")"
    : "${T_ON:=0}" "${T_DEV:=0}" "${T_ACC:=0}" "${T_OVER:=0}" "${H_AUTO:=OFF}" "${H_KICK:=0}"
    clear
    ui_top
    ui_center "${Y}◆${N} ${W}MULTIPLEXER · LIVE${N} ${Y}◆${N}"
    if [ "$H_AUTO" = "ON" ]; then pill="${G}● AUTO ON${N}"; else pill="${R}● AUTO OFF${N}"; fi
    ui_split " ${DIM}${ts}${N}" "$pill"
    ui_mid
    ui_kv "Online" "${G}${T_DEV}${N} device(s) ${DIM}· ${T_ON}/${T_ACC} accounts${N}"
    if [ "$T_OVER" -gt 0 ] 2>/dev/null; then ui_kv "Over limit" "${R}${T_OVER} account(s)${N}"; else ui_kv "Over limit" "${G}none${N}"; fi
    if [ "$H_AUTO" != "ON" ]; then ui_row "  ${R}[!]${N} Auto OFF · showing only, not limiting"; fi
    ui_mid
    ui_section "ONLINE NOW"
    idle=""; idlen=0; idleshown=0; custom=0
    if [ "$T_DEV" -eq 0 ] 2>/dev/null; then ui_note "No device connected right now."; fi
    while IFS='|' read -r t a b c d e; do
      case "$t" in
        U)
          if [ "$c" -gt 0 ] && [ "$b" -gt "$c" ]; then col="$R"; tag="${R}OVER${N}"
          elif [ "$c" -gt 0 ] && [ "$b" -eq "$c" ]; then col="$Y"; tag="${Y}FULL${N}"
          else col="$G"; tag=""; fi
          if [ "$c" -eq 0 ]; then cnt="$b/inf"; else cnt="$b/$c"; fi
          mark=" "; [ "$d" = "custom" ] && { mark="*"; custom=1; }
          ui_row "  ${col}●${N} $(printf '%b%-11s%b%s' "$W" "${a:0:11}" "$N" "$mark")$(mux_slotbar "$b" "$c") $(printf '%-6s' "$cnt")${tag}"
          ;;
        D)
          ui_row "     $(printf '%b%-3s%b%b%-10s%b %-15s %b%5s%b' "$Y" "#$b" "$N" "$C" "$c" "$N" "$d" "$DIM" "$e" "$N")"
          ;;
        I)
          idlen=$((idlen + 1))
          if [ "${#idle}" -lt 24 ]; then idle="${idle:+$idle, }$a"; idleshown=$((idleshown + 1)); fi
          ;;
      esac
    done <<< "$SNAP"
    [ "$custom" -eq 1 ] && ui_note "* custom limit (set with [l])"
    if [ "$idlen" -gt 0 ]; then
      ui_mid
      ui_section "IDLE (${idlen})"
      [ "$idlen" -gt "$idleshown" ] && idle="$idle +$((idlen - idleshown))"
      ui_note "$idle"
    fi
    K=$(python3 "$MUX_PY" log 3 2>/dev/null)
    if [ -n "$K" ]; then
      ui_mid
      ui_section "RECENT ACTIONS"
      while IFS='|' read -r _ t a b c d; do
        ui_row "  ${DIM}${t}${N} ${R}cut${N} ${W}${a}${N} ${DIM}${b} ${c} · limit ${d}${N}"
      done <<< "$K"
    fi
    ui_mid
    ui_item r "Refresh"
    ui_item l "Set account limit"
    ui_back
    ui_bot
    read -r -p "$(ui_ask 'Action')" ans
    case "$ans" in
      r|R) continue ;;
      l|L) mux_set_account_limit ;;
      ""|0) break ;;
      *) ;;
    esac
  done
}

mux_lowlat_fix() {
  local f changed=0
  echo ""
  apply_enhancement_booster; ui_msg "Kernel tuning re-applied (BBR, fq, Fast Open)"
  f="$OVPN_DIR/server-tcp.conf"
  if [ -f "$f" ] && ! grep -qE 'TCP_NODELAY|tcp-nodelay' "$f"; then
    printf 'socket-flags TCP_NODELAY\n' >> "$f"
    systemctl restart openvpn-server@server-tcp > /dev/null 2>&1
    ui_msg "OpenVPN TCP: TCP_NODELAY on"; changed=1
  fi
  if [ -f /etc/stunnel/stunnel.conf ] && ! grep -q 'TCP_NODELAY' /etc/stunnel/stunnel.conf; then
    sed -i '0,/^foreground/s//socket = l:TCP_NODELAY=1\nsocket = r:TCP_NODELAY=1\nforeground/' /etc/stunnel/stunnel.conf
    systemctl restart stunnel4 > /dev/null 2>&1
    ui_msg "SSL (stunnel): TCP_NODELAY on"; changed=1
  fi
  if [ -f /usr/local/bin/ws-proxy.py ] && ! grep -q 'TCP_NODELAY' /usr/local/bin/ws-proxy.py; then
    heal_ws_stack force > /dev/null 2>&1
    ui_msg "WebSocket proxy rebuilt with TCP_NODELAY"; changed=1
  fi
  if [ -f "$NGINX_V2RAY_CONF" ] && ! grep -q 'tcp_nodelay on' "$NGINX_V2RAY_CONF"; then
    sync_host_config; systemctl reload nginx > /dev/null 2>&1
    ui_msg "Nginx: tcp_nodelay on"; changed=1
  fi
  [ "$changed" -eq 0 ] && ui_msg "Nothing else to change"
  sleep 2
}

mux_latency_screen() {
  local OUT ans t a b c d ok=0 tot=0 bad=0 led tag ms
  while true; do
    clear
    echo -e "\n ${Y}[*] Testing every protocol path, please wait...${N}"
    OUT=$(python3 "$MUX_PY" latency 2>/dev/null)
    ok=0; tot=0; bad=0
    while IFS='|' read -r t a b c d; do
      [ "$t" = "L" ] || continue
      [ "$b" = "off" ] && continue
      tot=$((tot + 1)); [ "$b" = "ok" ] && ok=$((ok + 1)) || bad=1
    done <<< "$OUT"
    clear
    ui_head "LOW LATENCY CHECK"
    if [ "$ok" -eq "$tot" ] && [ "$tot" -gt 0 ]; then ui_split " ${Y}◆${N} ${W}PROTOCOLS${N}" "${G}✓ ${ok}/${tot} OK${N}"
    else ui_split " ${Y}◆${N} ${W}PROTOCOLS${N}" "${Y}${ok}/${tot} OK${N}"; fi
    while IFS='|' read -r t a b c d; do
      [ "$t" = "L" ] || continue
      case "$b" in
        ok)   led="${G}●${N}"; tag="${G}✓ OK${N}" ;;
        slow) led="${Y}●${N}"; tag="${Y}SLOW${N}" ;;
        fix)  led="${Y}●${N}"; tag="${Y}! FIX${N}" ;;
        off)  led="${DIM}○${N}"; tag="${DIM}OFF${N}" ;;
        *)    led="${R}●${N}"; tag="${R}✗ DOWN${N}" ;;
      esac
      if [[ "$c" =~ ^[0-9.]+$ ]]; then ms="$(printf '%6s' "$c") ms"; else ms="$(printf '%6s' "$c")   "; fi
      ui_row "  ${led} $(printf '%-15s' "$a") ${ms}  ${tag}"
      if [ "$b" != "ok" ] && [ "$b" != "off" ] && [ -n "$d" ]; then ui_note "    ↳ ${d}"; fi
    done <<< "$OUT"
    ui_mid
    ui_section "SYSTEM"
    while IFS='|' read -r t a b c d; do
      [ "$t" = "Y" ] || continue
      if [ "$b" = "ok" ]; then led="${G}●${N}"; tag="${G}✓${N}"; else led="${Y}●${N}"; tag="${Y}! FIX${N}"; bad=1; fi
      ui_row "  ${led} $(printf '%-15s' "$a") $(printf '%-12s' "$c")${tag}"
    done <<< "$OUT"
    ui_mid
    ui_note "Time to the SSH banner, measured here."
    ui_note "Guard is out-of-band: 0 extra hops."
    ui_mid
    [ "$bad" -eq 1 ] && ui_item f "Fix what can be fixed"
    ui_item r "Test again"
    ui_back
    ui_bot
    read -r -p "$(ui_ask 'Action')" ans
    case "$ans" in
      f|F) mux_lowlat_fix ;;
      r|R) ;;
      ""|0) break ;;
    esac
  done
}

mux_conflicts_screen() {
  local OUT t a b c d bad=0 led tag
  OUT=$(python3 "$MUX_PY" conflicts 2>/dev/null)
  while IFS='|' read -r t a b c d; do [ "$d" = "conflict" ] && bad=$((bad + 1)); done <<< "$OUT"
  clear
  ui_head "PORT CONFLICT CHECK"
  if [ "$bad" -eq 0 ]; then ui_split " ${Y}◆${N} ${W}LISTENING PORTS${N}" "${G}✓ no conflict${N}"
  else ui_split " ${Y}◆${N} ${W}LISTENING PORTS${N}" "${R}✗ ${bad} conflict(s)${N}"; fi
  while IFS='|' read -r t a b c d; do
    [ "$t" = "C" ] || continue
    case "$d" in
      ok)       led="${G}●${N}"; tag="${G}✓${N}" ;;
      conflict) led="${R}●${N}"; tag="${R}✗ TAKEN${N}" ;;
      off)      led="${DIM}○${N}"; tag="${DIM}OFF${N}" ;;
      *)        led="${R}●${N}"; tag="${R}✗ DOWN${N}" ;;
    esac
    ui_row "  ${led} $(printf '%-11s %-9s %-11s' "$a" "$b" "${c:0:11}") ${tag}"
  done <<< "$OUT"
  ui_mid
  ui_note "Account Multiplexer opens no TCP/UDP port."
  ui_note "OVPN control = private unix socket."
  ui_note "TAKEN = another program holds that port."
  ui_bot
  press_enter
}

