  clear
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${W}      ${PROTO^^} (WEBSOCKET) ACCOUNT CREATED         ${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  if [ "$PROTO" == "trojan" ]; then
