server_menu() {
  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}       ${W}Server Actions${N}                        ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  ${W}[1]${N} Restart All Services                   ${C}║${N}"
  echo -e "${C}║${N}  ${W}[2]${N} Fix DNS/Internet                       ${C}║${N}"
  echo -e "${C}║${N}  ${W}[3]${N} Update Script Config (Host/NS)         ${C}║${N}"
  echo -e "${C}║${N}  ${W}[4]${N} Reboot Server                          ${C}║${N}"
  echo -e "${C}║${N}  ${W}[0]${N} Back to Main Menu                      ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════════╝${N}"
  read -p " Choose : " ch
  case $ch in
    1)
       echo -e "${Y} Restarting...${N}"
       systemctl restart ssh sslh stunnel4 ws-proxy-8080 xhttp-proxy nginx xray dnstt openvpn@server 2>/dev/null
       echo -e "${G} Done!${N}"
       press_enter; server_menu
       ;;
    2)
       echo -e "${Y} Fixing DNS...${N}"
       chattr -i /etc/resolv.conf 2>/dev/null || true
       echo "nameserver 8.8.8.8" > /etc/resolv.conf
       echo "nameserver 8.8.4.4" >> /etc/resolv.conf
       chattr +i /etc/resolv.conf 2>/dev/null || true
       echo -e "${G} DNS Reset to Google. Services restarting...${N}"
       systemctl restart sslh stunnel4 dnstt 2>/dev/null
       press_enter; server_menu
       ;;
    3)
       clear
       source "$CONFIG_FILE"
       echo -e " Current Host : $HOST"
       echo -e " Current NS   : $NAMESERVER"
       read -p " Enter New Host: " h
       read -p " Enter New NS: " ns
       sed -i "/^HOST=/d" "$CONFIG_FILE"
       sed -i "/^NAMESERVER=/d" "$CONFIG_FILE"
       echo "HOST=$h" >> "$CONFIG_FILE"
       echo "NAMESERVER=$ns" >> "$CONFIG_FILE"
       echo -e "${G} Updated! Script will use this on next rebuild.${N}"
       press_enter; server_menu
       ;;
    4)
       echo -e "${Y} Rebooting server...${N}"
       sleep 1
       reboot
       ;;
    0) main_menu ;;
    *) server_menu ;;
  esac
}

