# Default Protocol Toggles (ALL ON by default - RED / OFF removed)
PROTO_SSH="ON"
PROTO_OVPN="ON"
PROTO_SSL="ON"
PROTO_MUX="ON"
PROTO_WS="ON"
PROTO_NGINX="ON"
