install_booster_python() {
  mkdir -p /usr/local/bin /etc/sysctl.d
  cat > "$BOOSTER_SCRIPT" << 'BOOSTERPY'
#!/usr/bin/env python3
import os
import sys
import json
import time
import socket
import subprocess

SYSCTL_FILE = "/etc/sysctl.d/99-vantricks-booster.conf"
SNI_LIST_FILE = "/etc/vantricks_sni_proxy_hosts.list"
CONFIG_FILE = "/etc/vantricks_script.conf"
NGINX_CONF = "/etc/nginx/conf.d/v2ray.conf"

SYSCTL_PARAMS = {
    "net.core.default_qdisc": "fq",
    "net.ipv4.tcp_congestion_control": "bbr",
    "net.ipv4.tcp_window_scaling": "1",
    "net.ipv4.tcp_sack": "1",
    "net.ipv4.tcp_fastopen": "3",
    "net.ipv4.tcp_tw_reuse": "1",
    "net.ipv4.tcp_fin_timeout": "15",
    "net.ipv4.tcp_keepalive_time": "60",
    "net.ipv4.tcp_keepalive_intvl": "15",
    "net.ipv4.tcp_keepalive_probes": "4",
    "net.ipv4.tcp_slow_start_after_idle": "0",
    "net.ipv4.tcp_notsent_lowat": "16384",
    "net.core.rmem_max": "67108864",
    "net.core.wmem_max": "67108864",
    "net.core.rmem_default": "1048576",
    "net.core.wmem_default": "1048576",
    "net.ipv4.tcp_rmem": "4096 1048576 67108864",
    "net.ipv4.tcp_wmem": "4096 1048576 67108864",
    "net.core.somaxconn": "65535",
    "net.core.netdev_max_backlog": "65535",
    "net.ipv4.tcp_max_syn_backlog": "32768",
    "net.ipv4.tcp_syncookies": "1",
    "net.ipv4.tcp_mtu_probing": "1",
    "vm.swappiness": "10",
    "fs.file-max": "2097152",
}

SERVICES = [
    ("SSH", ["ssh", "sshd"]),
    ("OVPN-UDP", ["openvpn@server"]),
    ("OVPN-TCP", ["openvpn@server-tcp"]),
    ("SSL", ["stunnel4"]),
    ("MUX", ["sslh", "sslh-select"]),
    ("WS-8080", ["ws-proxy-8080"]),
    ("NGINX", ["nginx"]),
    ("XRAY", ["xray"]),
    ("DNSTT", ["dnstt"]),
    ("SSH-DNSTT", ["ssh-dnstt"]),
    ("SLIPSTREAM", ["slipstream-rust"]),
]

def run_cmd(cmd):
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True)
        return out.strip()
    except Exception:
        return ""

def read_sysctl(key):
    path = "/proc/sys/" + key.replace(".", "/")
    try:
        with open(path, "r") as f:
            return " ".join(f.read().strip().split())
    except Exception:
        return run_cmd(["sysctl", "-n", key])

def load_conf():
    cfg = {}
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    return cfg

def apply_booster():
    subprocess.run(["modprobe", "tcp_bbr"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.makedirs("/etc/modules-load.d", exist_ok=True)
    with open("/etc/modules-load.d/vantricks-bbr.conf", "w") as mf:
        mf.write("tcp_bbr\n")

    lines = ["# Vantricks Real-Time Python Kernel & Network Enhancement Booster"]
    for k, v in SYSCTL_PARAMS.items():
        lines.append(f"{k} = {v}")
        subprocess.run(["sysctl", "-w", f"{k}={v}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    with open(SYSCTL_FILE, "w") as sf:
        sf.write("\n".join(lines) + "\n")
    subprocess.run(["sysctl", "--system"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    route_out = run_cmd(["ip", "route", "show", "default"])
    if route_out:
        parts = route_out.split()
        if "dev" in parts:
            iface = parts[parts.index("dev") + 1]
            subprocess.run(["tc", "qdisc", "replace", "dev", iface, "root", "fq"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def service_active(names):
    for n in names:
        st = run_cmd(["systemctl", "is-active", n])
        if st == "active":
            return True
    return False

def get_sni_hosts():
    if not os.path.exists(SNI_LIST_FILE):
        return []
    with open(SNI_LIST_FILE, "r") as f:
        return [line.strip() for line in f if line.strip()]

def check_nginx_and_xhttp():
    has_301 = False
    has_keepalive = False
    no_lb = True
    has_xhttp = False
    if os.path.exists(NGINX_CONF):
        try:
            with open(NGINX_CONF, "r") as f:
                txt = f.read()
            has_301 = "return 301" in txt
            has_keepalive = "keepalive_timeout" in txt and "Keep-Alive" in txt
            no_lb = "upstream " not in txt
            has_xhttp = "/xhttp" in txt and "10089" in txt
        except Exception:
            pass
    return has_301, has_keepalive, no_lb, has_xhttp

def evaluate_metrics():
    score = 0
    details = {}
    cfg = load_conf()

    cc = read_sysctl("net.ipv4.tcp_congestion_control")
    qd = read_sysctl("net.core.default_qdisc")
    bbr_pts = 0
    if cc == "bbr":
        bbr_pts += 18
    elif cc:
        bbr_pts += 6
    if qd in ("fq", "fq_codel"):
        bbr_pts += 7
    score += bbr_pts
    details["cc"] = cc or "unknown"
    details["qdisc"] = qd or "unknown"
    details["bbr_pts"] = bbr_pts

    rmem = read_sysctl("net.core.rmem_max")
    tfo = read_sysctl("net.ipv4.tcp_fastopen")
    ka = read_sysctl("net.ipv4.tcp_keepalive_time")
    has_301, has_ka_hdr, no_lb, has_xhttp = check_nginx_and_xhttp()
    buf_pts = 0
    try:
        if int(rmem) >= 16777216:
            buf_pts += 8
        elif int(rmem) >= 2097152:
            buf_pts += 4
    except Exception:
        pass
    if tfo in ("3", "2", "1"):
        buf_pts += 4
    try:
        if int(ka) <= 120:
            buf_pts += 4
    except Exception:
        pass
    if has_ka_hdr and has_301 and no_lb:
        buf_pts += 5
    if has_xhttp:
        buf_pts += 4
    score += buf_pts
    details["rmem_max"] = rmem or "0"
    details["fastopen"] = tfo or "0"
    details["keepalive"] = ka or "7200"
    details["has_301"] = has_301
    details["has_ka_hdr"] = has_ka_hdr
    details["no_lb"] = no_lb
    details["has_xhttp"] = has_xhttp
    details["buf_pts"] = buf_pts

    active_count = 0
    svc_states = {}
    for label, unit_list in SERVICES:
        up = service_active(unit_list)
        svc_states[label] = up
        if up:
            active_count += 1
    svc_pts = round((active_count / len(SERVICES)) * 25)
    score += svc_pts
    details["active_services"] = active_count
    details["total_services"] = len(SERVICES)
    details["svc_states"] = svc_states
    details["svc_pts"] = svc_pts

    sni_hosts = get_sni_hosts()
    host_val = cfg.get("HOST", "")
    ns_val = cfg.get("NAMESERVER", "")
    cdn_val = cfg.get("CDN_DOMAIN", host_val)
    sni_pts = 0
    if host_val and ns_val:
        sni_pts += 5
    if cdn_val or len(sni_hosts) > 0:
        sni_pts += 4
    t0 = time.perf_counter()
    local_ok = False
    for port in (8080, 8880, 22):
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.4):
                local_ok = True
                break
        except Exception:
            continue
    rtt_ms = round((time.perf_counter() - t0) * 1000, 2)
    if local_ok:
        sni_pts += 6
    score += sni_pts
    details["host"] = host_val or "N/A"
    details["ns"] = ns_val or "N/A"
    details["cdn"] = cdn_val or "N/A"
    details["sni_count"] = len(sni_hosts)
    details["sni_hosts"] = sni_hosts
    details["local_rtt_ms"] = rtt_ms
    details["sni_pts"] = sni_pts

    mem_avail_pct = 50.0
    try:
        meminfo = {}
        with open("/proc/meminfo") as mf:
            for line in mf:
                parts = line.split()
                if len(parts) >= 2:
                    meminfo[parts[0].rstrip(":")] = int(parts[1])
        total_m = meminfo.get("MemTotal", 1)
        avail_m = meminfo.get("MemAvailable", meminfo.get("MemFree", 0))
        mem_avail_pct = round((avail_m / max(total_m, 1)) * 100, 1)
    except Exception:
        pass
    res_pts = 10 if mem_avail_pct >= 25 else (6 if mem_avail_pct >= 12 else 3)
    score += res_pts
    details["mem_avail_pct"] = mem_avail_pct
    details["res_pts"] = res_pts

    score = max(0, min(100, int(score)))
    if score >= 90:
        verdict = "ULTRA BOOSTED (OPTIMAL)"
        tier = "S+"
    elif score >= 75:
        verdict = "HIGH STRENGTH (ENHANCED)"
        tier = "A"
    elif score >= 55:
        verdict = "MODERATE (NEEDS BOOST)"
        tier = "B"
    else:
        verdict = "LOW / UNOPTIMIZED"
        tier = "C"

    tcp_estab = run_cmd(["ss", "-s"])
    estab_num = "0"
    for line in tcp_estab.splitlines():
        if "estab" in line:
            for tok in line.replace(",", " ").replace("(", " ").split():
                if tok.isdigit():
                    estab_num = tok
                    break

    return {
        "score": score,
        "tier": tier,
        "verdict": verdict,
        "estab_tcp": estab_num,
        "details": details,
    }

def render_bar(pct, width=20):
    filled = int(round((pct / 100.0) * width))
    return "█" * filled + "░" * (width - filled)

def live_monitor(iterations=0):
    G = "\033[0;32m"
    C = "\033[0;36m"
    Y = "\033[1;33m"
    R = "\033[0;31m"
    W = "\033[1;37m"
    N = "\033[0m"
    count = 0
    try:
        while True:
            data = evaluate_metrics()
            sc = data["score"]
            col = G if sc >= 80 else (Y if sc >= 55 else R)
            d = data["details"]
            os.system("clear")
            print(f"{C}╔══════════════════════════════════════════════════════╗{N}")
            print(f"{C}║{N}    {W}VANTRICKS REAL-TIME PYTHON ENHANCEMENT BOOSTER{N}    {C}║{N}")
            print(f"{C}╠══════════════════════════════════════════════════════╣{N}")
            print(f"{C}║{N}  Strength Score : {col}{sc}/100 [{data['tier']}] {render_bar(sc)}{N}")
            print(f"{C}║{N}  Live Verdict   : {col}{data['verdict']}{N}")
            print(f"{C}╠══════════════════════════════════════════════════════╣{N}")
            print(f"{C}║{N}  TCP Congestion : {G}{d['cc'].upper()}{N} | Qdisc: {G}{d['qdisc']}{N} ({d['bbr_pts']}/25 pts)")
            print(f"{C}║{N}  TCP Buffer Max : {G}{d['rmem_max']} B{N} | FastOpen: {G}{d['fastopen']}{N} ({d['buf_pts']}/25 pts)")
            print(f"{C}║{N}  Keep-Alive     : {G}{d['keepalive']}s (HTTP KA: {'ON' if d['has_ka_hdr'] else 'OFF'}){N} | TCP Estab: {G}{data['estab_tcp']}{N}")
            print(f"{C}║{N}  301 + No-LB    : {G}{'301 + NO-LB' if (d['has_301'] and d['no_lb']) else 'CHECK'}{N} | XHTTP: {G}{'ON' if d['has_xhttp'] else 'OFF'}{N}")
            print(f"{C}║{N}  Protocols Up   : {G}{d['active_services']}/{d['total_services']}{N} ({d['svc_pts']}/25 pts)")
            print(f"{C}║{N}  Domain / CDN   : {G}{d['host']}{N} -> {G}{d['cdn']}{N}")
            print(f"{C}║{N}  Nameserver (NS): {G}{d['ns']}{N} | SNI: {G}{d['sni_count']}{N} | RTT: {G}{d['local_rtt_ms']}ms{N}")
            print(f"{C}║{N}  Free RAM Head  : {G}{d['mem_avail_pct']}%{N} ({d['res_pts']}/10 pts)")
            print(f"{C}╠══════════════════════════════════════════════════════╣{N}")
            svc_line = "  "
            for idx, (lbl, up) in enumerate(d["svc_states"].items(), 1):
                mark = f"{G}ON{N}" if up else f"{R}OFF{N}"
                svc_line += f"{lbl}:{mark}  "
                if idx % 3 == 0:
                    print(f"{C}║{N}{svc_line}")
                    svc_line = "  "
            if svc_line.strip():
                print(f"{C}║{N}{svc_line}")
            print(f"{C}╠══════════════════════════════════════════════════════╣{N}")
            print(f"{C}║{N}  {Y}Press Ctrl+C to return to Vantricks Manager...{N}       {C}║{N}")
            print(f"{C}╚══════════════════════════════════════════════════════╝{N}")
            count += 1
            if iterations > 0 and count >= iterations:
                break
            time.sleep(2)
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "json"
    if mode == "apply":
        apply_booster()
        res = evaluate_metrics()
        print(json.dumps(res))
    elif mode == "summary":
        res = evaluate_metrics()
        print(f"{res['score']}|{res['tier']}|{res['verdict']}")
    elif mode == "live":
        live_monitor(0)
    elif mode == "once":
        live_monitor(1)
    else:
        print(json.dumps(evaluate_metrics()))
BOOSTERPY
  chmod +x "$BOOSTER_SCRIPT"
}

apply_enhancement_booster() {
  [ ! -x "$BOOSTER_SCRIPT" ] && install_booster_python
  python3 "$BOOSTER_SCRIPT" apply > /dev/null 2>&1 || true
}

get_booster_verdict_and_score() {
  [ ! -x "$BOOSTER_SCRIPT" ] && install_booster_python
  local RAW
  RAW=$(python3 "$BOOSTER_SCRIPT" summary 2>/dev/null || echo "70|B|ENHANCEMENT ACTIVE")
  BOOSTER_SCORE=$(echo "$RAW" | cut -d'|' -f1)
  BOOSTER_TIER=$(echo "$RAW" | cut -d'|' -f2)
  BOOSTER_VERDICT=$(echo "$RAW" | cut -d'|' -f3)
}

