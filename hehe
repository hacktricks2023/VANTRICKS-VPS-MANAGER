        D=$(( SECS_LEFT/86400 ))
        H=$(( (SECS_LEFT%86400)/3600 ))
        M=$(( (SECS_LEFT%3600)/60 ))
        S=$(( SECS_LEFT%60 ))
        TIME_LEFT="${D}d ${H}h ${M}m ${S}s"
