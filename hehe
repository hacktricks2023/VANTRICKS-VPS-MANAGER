install_slipstream() {
  echo -e " ${Y}[*] Installing Slipstream tunnel service...${N}"
  mkdir -p "$SLIPSTREAM_DIR"
  if [ ! -x "$SLIPSTREAM_BIN" ]; then
    cat > "$SLIPSTREAM_BIN" << 'SLIPPY'
#!/usr/bin/env python3
import sys
import socket
import threading
import select

def parse_args(argv):
    listen_addr = ("127.0.0.1", 5302)
    target_addr = ("127.0.0.1", 22)
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--listen" and i + 1 < len(argv) and ":" in argv[i + 1]:
            h, p = argv[i + 1].rsplit(":", 1)
            listen_addr = (h, int(p))
            i += 2
        elif arg == "--target" and i + 1 < len(argv) and ":" in argv[i + 1]:
            h, p = argv[i + 1].rsplit(":", 1)
            target_addr = (h, int(p))
            i += 2
        else:
            i += 1
    return listen_addr, target_addr

def bridge(a, b):
    try:
        while True:
            r, _, _ = select.select([a, b], [], [], 120)
            if not r:
                break
            for s in r:
                data = s.recv(65535)
                if not data:
                    return
                dst = b if s is a else a
                dst.sendall(data)
    except Exception:
        pass
    finally:
        for sock in (a, b):
            try:
                sock.close()
            except Exception:
                pass

def handle_client(conn, target_addr):
    try:
        conn.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        upstream = socket.create_connection(target_addr, timeout=15)
        upstream.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        upstream.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        bridge(conn, upstream)
    except Exception:
        try:
            conn.close()
        except Exception:
            pass

def main():
    listen_addr, target_addr = parse_args(sys.argv)
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(listen_addr)
    srv.listen(256)
    while True:
        try:
            c, _ = srv.accept()
            threading.Thread(target=handle_client, args=(c, target_addr), daemon=True).start()
        except Exception:
            pass

if __name__ == "__main__":
    main()
SLIPPY
    chmod +x "$SLIPSTREAM_BIN"
  fi

  cat > /usr/local/bin/slipstream-start.sh << SLIPSEOF
#!/bin/bash
exec ${SLIPSTREAM_BIN} --domain ${NAMESERVER:-$HOST} --listen 127.0.0.1:5302 --target 127.0.0.1:22
SLIPSEOF
