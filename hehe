#!/bin/bash

# =============================================
#   Vantricks VPS MANAGER (SSH + OVPN + XRAY/WS)
#   OS: Debian/Ubuntu | DNS Ready
# =============================================

# Colors
R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
C='\033[0;36m'
W='\033[1;37m'
N='\033[0m'

DIV="════════════════════════════════════════════════"
CONFIG_FILE="/etc/vantricks_script.conf"
PACKAGES_FILE="/etc/vantricks_packages.list"
ACCOUNT_PKG_DB="/etc/vantricks_account_packages.db"
OVPN_DIR="/etc/openvpn/server"
OVPN_CLIENT_DIR="/etc/openvpn/client"
XRAY_CONF="/usr/local/etc/xray/config.json"
XRAY_DB="/etc/xray/accounts.db"
NGINX_V2RAY_CONF="/etc/nginx/conf.d/v2ray.conf"
SERVER_ERROR_MSG="Server error contact owner vantricks team."
AUTO_REBOOT_ON_SAVE="ON"

# ── PASSWORD CHECK ────────────────────────────────
check_password() {
  if [ ! -f "$CONFIG_FILE" ]; then
    clear
    echo -e "${C}╔══════════════════════════════════════════════╗${N}"
    echo -e "${C}║${N}          ${W}Vantricks VPS Manager${N}                ${C}║${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    read -p "  Password (Vantricks2026) : " INPUT_PASS

    CORRECT_PASS="Vantricks2026"

    if [ "$INPUT_PASS" == "$CORRECT_PASS" ]; then
      echo -e " ${G}[✓] Password correct! Proceeding...${N}"
      sleep 1
    else
      echo -e " ${R}[!] Wrong password! Access denied.${N}"
      echo ""
      exit 1
    fi
  fi
}
# ─────────────────────────────────────────────────

# ══════════════════════════════════════════════
#   HELPERS, PACKAGE GATE & HOST DOMAIN SYNC
# ══════════════════════════════════════════════

press_enter() {
  echo ""
  read -p " Press Enter to continue... "
}

check_root() {
  if [ "$EUID" -ne 0 ]; then
    echo -e "${R}[ERROR] Please run as root: sudo bash vantricks_manager.sh${N}"
    exit 1
  fi
}

check_os() {
  DISTRO=$(grep -oP '(?<=^ID=).+' /etc/os-release 2>/dev/null | tr -d '"' || echo "unknown")
  if [ "$DISTRO" != "debian" ] && [ "$DISTRO" != "ubuntu" ]; then
    echo -e "${R}[ERROR] Unsupported OS! Only Debian/Ubuntu is supported.${N}"
    exit 1
  fi
}

init_packages_store() {
  mkdir -p /etc
  touch "$PACKAGES_FILE" "$ACCOUNT_PKG_DB"
  sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE" 2>/dev/null || true
}

get_auto_reboot_state() {
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  if [ "${AUTO_REBOOT_ON_SAVE^^}" == "OFF" ]; then
    echo "OFF"
  else
    echo "ON"
  fi
}

set_auto_reboot_state() {
  local NEW_STATE="${1^^}"
  [ "$NEW_STATE" != "ON" ] && NEW_STATE="OFF"
  mkdir -p /etc
  touch "$CONFIG_FILE"
  sed -i '/^AUTO_REBOOT_ON_SAVE=/d' "$CONFIG_FILE" 2>/dev/null || true
  echo "AUTO_REBOOT_ON_SAVE=$NEW_STATE" >> "$CONFIG_FILE"
  AUTO_REBOOT_ON_SAVE="$NEW_STATE"
}

toggle_auto_reboot() {
  local CUR
  CUR=$(get_auto_reboot_state)
  if [ "$CUR" == "ON" ]; then
    set_auto_reboot_state "OFF"
    echo -e "\n ${Y}[✓] Auto Reboot on Save is now: OFF${N}"
  else
    set_auto_reboot_state "ON"
    echo -e "\n ${G}[✓] Auto Reboot on Save is now: ON${N}"
  fi
  sleep 1
}

count_packages() {
  init_packages_store
  grep -c '[^[:space:]]' "$PACKAGES_FILE" 2>/dev/null || echo 0
}

is_package_in_list() {
  local TARGET_PKG="$1"
  init_packages_store
  [ -z "$TARGET_PKG" ] && return 1
  grep -Fxq "$TARGET_PKG" "$PACKAGES_FILE" 2>/dev/null
}

get_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  init_packages_store
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '$1==p && $2==u {print $3; exit}' "$ACCOUNT_PKG_DB"
}

set_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  local PKG_NAME="$3"
  init_packages_store
  local TMP
  TMP=$(mktemp)
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '!($1==p && $2==u)' "$ACCOUNT_PKG_DB" > "$TMP" 2>/dev/null || true
  echo "${PROTO_KEY}|${ACCT_ID}|${PKG_NAME}" >> "$TMP"
  mv "$TMP" "$ACCOUNT_PKG_DB"
}

remove_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  init_packages_store
  local TMP
  TMP=$(mktemp)
  awk -F'|' -v p="$PROTO_KEY" -v u="$ACCT_ID" '!($1==p && $2==u)' "$ACCOUNT_PKG_DB" > "$TMP" 2>/dev/null || true
  mv "$TMP" "$ACCOUNT_PKG_DB"
}

select_package_for_account() {
  init_packages_store
  local CNT
  CNT=$(count_packages)
  if [ "$CNT" -le 0 ]; then
    echo ""
    echo -e " ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return 1
  fi

  mapfile -t PKGS < "$PACKAGES_FILE"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e " ${W}Select Package Name (Required):${N}"
  local idx=1
  for p in "${PKGS[@]}"; do
    echo -e "  ${W}[$idx]${N} ${G}${p}${N}"
    idx=$((idx + 1))
  done
  read -p "  Package # : " P_SEL

  if ! [[ "$P_SEL" =~ ^[0-9]+$ ]] || [ "$P_SEL" -lt 1 ] || [ "$P_SEL" -gt "${#PKGS[@]}" ]; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return 1
  fi

  SELECTED_PACKAGE="${PKGS[$((P_SEL - 1))]}"
  if ! is_package_in_list "$SELECTED_PACKAGE"; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return 1
  fi
  return 0
}

verify_account_package() {
  local PROTO_KEY="$1"
  local ACCT_ID="$2"
  local ASSIGNED_PKG
  ASSIGNED_PKG=$(get_account_package "$PROTO_KEY" "$ACCT_ID")
  if [ -z "$ASSIGNED_PKG" ] || ! is_package_in_list "$ASSIGNED_PKG"; then
    return 1
  fi
  return 0
}

trigger_auto_reboot() {
  local REASON="${1:-Applying package configuration...}"
  echo ""
  echo -e " ${G}[✓] ${REASON}${N}"
  echo -e " ${C}╠══════════════════════════════════════════════╣${N}"
  echo -e " ${G} Rebooting automatically in...${N}"
  for i in 3 2 1; do
    echo -e " ${R}   $i...${N}"
    sleep 1
  done
  echo -e " ${G} Reconnect and type: menu${N}"
  sleep 1
  reboot
}

apply_save_action() {
  local REASON="${1:-Configuration saved.}"
  local STATE
  STATE=$(get_auto_reboot_state)
  if [ "$STATE" == "ON" ]; then
    trigger_auto_reboot "$REASON"
  else
    echo -e "\n ${G}[✓] ${REASON} (Auto Reboot is OFF)${N}"
    sleep 1
  fi
}

sync_host_config() {
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  [ -z "$HOST" ] && HOST="$SERVER_IP"
  [ -z "$NAMESERVER" ] && NAMESERVER="$HOST"

  # Enable TCP keepalive & low-latency tuning at kernel/sysctl level
  sysctl -w net.ipv4.tcp_keepalive_time=60 net.ipv4.tcp_keepalive_intvl=15 net.ipv4.tcp_keepalive_probes=4 > /dev/null 2>&1 || true

  if [ -d /etc/nginx/conf.d ]; then
    cat > "$NGINX_V2RAY_CONF" << NGINXEOF
server {
    listen 8880;
    server_name ${HOST} _;
    tcp_nodelay on;

    set \$target_host \$http_host;
    if (\$target_host = "") {
        set \$target_host "${HOST}";
    }

    location /vmess {
        proxy_pass http://127.0.0.1:10086;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$target_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /vless {
        proxy_pass http://127.0.0.1:10087;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$target_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /trojan {
        proxy_pass http://127.0.0.1:10088;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$target_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$target_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        add_header Upgrade "websocket" always;
        add_header Connection "Upgrade" always;
        add_header Sec-WebSocket-Version "13" always;
        add_header Via "vantricks-SSH" always;
    }
}
NGINXEOF
    nginx -t > /dev/null 2>&1 && systemctl reload nginx > /dev/null 2>&1 || true
  fi
}

update_host_domain() {
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}        ${W}UPDATE HOST DOMAIN & SYNC SERVICES${N}      ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Current Host : ${G}${HOST:-N/A}${N}"
  echo -e "${C}║${N}  Current NS   : ${G}${NAMESERVER:-N/A}${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  read -p "  New Host Domain : " NEW_HOST
  read -p "  New NS (or Enter to keep): " NEW_NS

  if [ -z "$NEW_HOST" ]; then
    echo -e " ${R}[!] Host domain cannot be empty!${N}"
    sleep 2; return
  fi

  NEW_NS="${NEW_NS:-$NAMESERVER}"
  NEW_NS="${NEW_NS:-$NEW_HOST}"

  sed -i '/^HOST=/d; /^NAMESERVER=/d' "$CONFIG_FILE"
  echo "HOST=$NEW_HOST" >> "$CONFIG_FILE"
  echo "NAMESERVER=$NEW_NS" >> "$CONFIG_FILE"

  # Regenerate existing client OVPN profiles with the updated host
  if [ -d "$OVPN_CLIENT_DIR" ]; then
    for ovpn in "${OVPN_CLIENT_DIR}"/*-tcp443.ovpn; do
      [ -f "$ovpn" ] || continue
      u_name=$(basename "$ovpn" "-tcp443.ovpn")
      generate_ovpn_profile "$u_name"
    done
  fi

  sync_host_config
  systemctl restart ws-proxy-8080 xray > /dev/null 2>&1
  echo -e "\n ${G}[✓] Host updated to '$NEW_HOST' and services synced!${N}"
  press_enter
}

load_config() {
  init_packages_store
  if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
    sync_host_config
  else
    first_run_setup
  fi
}

print_qr_link() {
  local LABEL="$1"
  local URI="$2"
  echo -e " ${W}${LABEL} QR:${N}"
  if command -v qrencode >/dev/null 2>&1; then
    qrencode -t UTF8 -m 1 "$URI" 2>/dev/null || true
  else
    echo -e " ${Y}[!] Install qrencode to view terminal QR codes.${N}"
  fi
}

get_info() {
  OS=$(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')
  RAM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
  RAM_USED=$(free -m | awk '/Mem:/ {print $3}')
  RAM_FREE=$(free -m | awk '/Mem:/ {print $4}')
  RAM_PERCENT=$(awk "BEGIN {printf \"%.2f\", ($RAM_USED/$RAM_TOTAL)*100}")
  DATETIME=$(TZ="Asia/Manila" date "+%m-%d-%Y %I:%M:%S %p")

  SSH_ONLINE=$(ss -tnp 2>/dev/null | grep -c "sshd" || echo 0)
  SSH_ONLINE=$(echo "$SSH_ONLINE" | tr -d '[:space:]')
  [ -z "$SSH_ONLINE" ] || ! [[ "$SSH_ONLINE" =~ ^[0-9]+$ ]] && SSH_ONLINE=0

  OVPN_UDP_ON=$(ss -unp 2>/dev/null | grep -c "openvpn" || echo 0)
  OVPN_TCP_ON=$(ss -tnp 2>/dev/null | grep -c "openvpn" || echo 0)
  OVPN_ONLINE=$(( ${OVPN_UDP_ON:-0} + ${OVPN_TCP_ON:-0} ))

  SSH_ACCOUNTS=$(awk -F: '$3>=1000 && $1!="nobody"' /etc/passwd | wc -l | tr -d '[:space:]')
  [ -z "$SSH_ACCOUNTS" ] || ! [[ "$SSH_ACCOUNTS" =~ ^[0-9]+$ ]] && SSH_ACCOUNTS=0

  V2RAY_ACCOUNTS=0
  if [ -f "$XRAY_DB" ]; then
    V2RAY_ACCOUNTS=$(grep -c '[^[:space:]]' "$XRAY_DB" 2>/dev/null || echo 0)
    V2RAY_ACCOUNTS=$(echo "$V2RAY_ACCOUNTS" | tr -d '[:space:]')
    [ -z "$V2RAY_ACCOUNTS" ] || ! [[ "$V2RAY_ACCOUNTS" =~ ^[0-9]+$ ]] && V2RAY_ACCOUNTS=0
  fi

  PKG_COUNT=$(count_packages)
  REBOOT_TOGGLE_STATE=$(get_auto_reboot_state)
  TOTAL_ACCOUNTS=$(( ${SSH_ACCOUNTS} + ${V2RAY_ACCOUNTS} ))
  CPU_CORES=$(nproc 2>/dev/null || echo 1)
  CPU_LOAD=$(top -bn1 2>/dev/null | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1 || echo "0")
  SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  [ -z "$HOST" ] && HOST="$SERVER_IP"
}

# ══════════════════════════════════════════════
#   PACKAGE NAME MANAGER (ADD / LIST / SAVE / EDIT / DELETE / TOGGLE / REBOOT)
# ══════════════════════════════════════════════

add_package_name() {
  init_packages_store
  local RSTATE
  RSTATE=$(get_auto_reboot_state)
  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}            ${W}ADD PACKAGE NAME${N}                    ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Auto Reboot on Save : ${G}${RSTATE}${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  read -p "  Enter Package Name : " PKG_INPUT
  PKG_INPUT=$(echo "$PKG_INPUT" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  if [ -z "$PKG_INPUT" ]; then
    echo -e "\n ${R}[!] Package name cannot be empty!${N}"
    sleep 2
    return
  fi

  echo ""
  echo -e " Package to add : ${G}${PKG_INPUT}${N}"
  echo -e " ${W}[s]${N} Save (Auto Reboot: ${RSTATE})    ${W}[c]${N} Cancel"
  read -p " Action >>> " SAVE_ACT

  case "$SAVE_ACT" in
    s|S|y|Y)
      echo "$PKG_INPUT" >> "$PACKAGES_FILE"
      sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE"
      apply_save_action "Saved package '${PKG_INPUT}'."
      ;;
    *)
      echo -e "\n ${Y}[!] Cancelled. Package not saved.${N}"
      sleep 1
      ;;
  esac
}

edit_package_name() {
  init_packages_store
  mapfile -t PKGS < "$PACKAGES_FILE"
  if [ ${#PKGS[@]} -eq 0 ]; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return
  fi

  read -p "  Enter package number to edit : " EDIT_IDX
  if ! [[ "$EDIT_IDX" =~ ^[0-9]+$ ]] || [ "$EDIT_IDX" -lt 1 ] || [ "$EDIT_IDX" -gt "${#PKGS[@]}" ]; then
    echo -e "\n ${R}[!] Invalid package number!${N}"
    sleep 1
    return
  fi

  local ARR_POS=$((EDIT_IDX - 1))
  local OLD_PKG="${PKGS[$ARR_POS]}"
  read -p "  New package name (current: ${OLD_PKG}) : " NEW_PKG
  NEW_PKG=$(echo "$NEW_PKG" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  if [ -z "$NEW_PKG" ]; then
    echo -e "\n ${R}[!] Package name cannot be empty!${N}"
    sleep 1
    return
  fi

  PKGS[$ARR_POS]="$NEW_PKG"
  printf "%s\n" "${PKGS[@]}" > "$PACKAGES_FILE"
  sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE"
  awk -F'|' -v old="$OLD_PKG" -v new="$NEW_PKG" 'BEGIN{OFS="|"} {if ($3==old) $3=new; print}' "$ACCOUNT_PKG_DB" > "${ACCOUNT_PKG_DB}.tmp" && mv "${ACCOUNT_PKG_DB}.tmp" "$ACCOUNT_PKG_DB"
  echo -e "\n ${G}[✓] Updated #${EDIT_IDX} to '${NEW_PKG}'.${N}"
  sleep 1
}

delete_package_name() {
  init_packages_store
  mapfile -t PKGS < "$PACKAGES_FILE"
  if [ ${#PKGS[@]} -eq 0 ]; then
    echo -e "\n ${R}[!] ${SERVER_ERROR_MSG}${N}"
    sleep 2
    return
  fi

  read -p "  Enter package number to delete : " DEL_IDX
  if ! [[ "$DEL_IDX" =~ ^[0-9]+$ ]] || [ "$DEL_IDX" -lt 1 ] || [ "$DEL_IDX" -gt "${#PKGS[@]}" ]; then
    echo -e "\n ${R}[!] Invalid package number!${N}"
    sleep 1
    return
  fi

  local ARR_POS=$((DEL_IDX - 1))
  local REM_PKG="${PKGS[$ARR_POS]}"
  unset 'PKGS[$ARR_POS]'
  if [ ${#PKGS[@]} -gt 0 ]; then
    printf "%s\n" "${PKGS[@]}" > "$PACKAGES_FILE"
  else
    : > "$PACKAGES_FILE"
  fi
  sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE"
  echo -e "\n ${G}[✓] Deleted package '${REM_PKG}'. Accounts using it will report error until updated.${N}"
  sleep 1
}

list_package_names_view() {
  init_packages_store
  local RSTATE
  RSTATE=$(get_auto_reboot_state)
  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}            ${W}LIST PACKAGE NAMES${N}                  ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Auto Reboot on Save : ${G}${RSTATE}${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"

  mapfile -t PKGS < "$PACKAGES_FILE"
  if [ ${#PKGS[@]} -eq 0 ]; then
    echo -e "${C}║${N}  ${R}${SERVER_ERROR_MSG}${N}"
  else
    local i=1
    for p in "${PKGS[@]}"; do
      echo -e "${C}║${N}  ${W}[$i]${N} ${G}${p}${N}"
      i=$((i + 1))
    done
  fi

  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  ${W}[s]${N} Save & Apply     ${W}[e]${N} Edit Package     ${C}║${N}"
  echo -e "${C}║${N}  ${W}[d]${N} Delete Package   ${W}[t]${N} Toggle Reboot    ${C}║${N}"
  echo -e "${C}║${N}  ${W}[r]${N} Reboot Now       ${W}[0]${N} Back             ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════════╝${N}"
}

package_menu() {
  while true; do
    init_packages_store
    clear
    local CNT RSTATE
    CNT=$(count_packages)
    RSTATE=$(get_auto_reboot_state)

    echo -e "${C}╔══════════════════════════════════════════════╗${N}"
    echo -e "${C}║${N}       ${W}PACKAGE NAME & SET-UP MANAGER${N}            ${C}║${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    if [ "$CNT" -le 0 ]; then
      echo -e "${C}║${N}  Status      : ${R}${SERVER_ERROR_MSG}${N}"
    else
      echo -e "${C}║${N}  Status      : ${G}${CNT} Active Package(s) Ready${N}"
    fi
    echo -e "${C}║${N}  Auto Reboot : ${G}${RSTATE}${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${C}║${N}  ${W}[1]${N} Add Package Name                         ${C}║${N}"
    echo -e "${C}║${N}  ${W}[2]${N} Show List Package Name                   ${C}║${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    echo -e "${C}║${N}  ${W}[s]${N} Save & Apply     ${W}[e]${N} Edit Package     ${C}║${N}"
    echo -e "${C}║${N}  ${W}[d]${N} Delete Package   ${W}[t]${N} Toggle Reboot    ${C}║${N}"
    echo -e "${C}║${N}  ${W}[r]${N} Reboot Now       ${W}[0]${N} Back             ${C}║${N}"
    echo -e "${C}╚══════════════════════════════════════════════╝${N}"
    read -p " Option >>> " POPT

    case "$POPT" in
      1)
        add_package_name
        ;;
      2)
        while true; do
          list_package_names_view
          read -p " Action >>> " LACT
          case "$LACT" in
            s|S)
              sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE"
              apply_save_action "Package list saved."
              ;;
            e|E)
              edit_package_name
              ;;
            d|D)
              delete_package_name
              ;;
            t|T)
              toggle_auto_reboot
              ;;
            r|R)
              trigger_auto_reboot "Rebooting server..."
              ;;
            0)
              break
              ;;
            *)
              echo -e "\n ${R}[!] Invalid option!${N}"
              sleep 1
              ;;
          esac
        done
        ;;
      s|S)
        sed -i '/^[[:space:]]*$/d' "$PACKAGES_FILE"
        apply_save_action "Package configuration saved."
        ;;
      e|E)
        list_package_names_view
        edit_package_name
        ;;
      d|D)
        list_package_names_view
        delete_package_name
        ;;
      t|T)
        toggle_auto_reboot
        ;;
      r|R)
        trigger_auto_reboot "Rebooting server..."
        ;;
      0)
        break
        ;;
      *)
        echo -e "${R} Invalid option!${N}"
        sleep 1
        ;;
    esac
  done
}

# ══════════════════════════════════════════════
#   AUTO REMOVE EXPIRED (SSH + OVPN + XRAY)
# ══════════════════════════════════════════════

auto_remove_expired() {
  local NOW_S=$(date +%s)

  while IFS=: read -r user _ uid _ _ _ _; do
    if [ "$uid" -ge 1000 ] && [ "$user" != "nobody" ]; then
      EXP=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2 | xargs)
      if [ "$EXP" != "never" ] && [ -n "$EXP" ] && [ "$EXP" != "password must be changed" ]; then
        EXP_S=$(date -d "$EXP" +%s 2>/dev/null)
        if [ -n "$EXP_S" ] && [ "$EXP_S" -lt "$NOW_S" ]; then
          sed -i "/Match User $user/,/MaxSessions/d" /etc/ssh/sshd_config 2>/dev/null
          rm -f "${OVPN_CLIENT_DIR}/${user}-tcp443.ovpn" "${OVPN_CLIENT_DIR}/${user}-udp1194.ovpn" "${OVPN_CLIENT_DIR}/${user}.ovpn" 2>/dev/null
          remove_account_package "ssh_ovpn" "$user"
          userdel -r "$user" > /dev/null 2>&1
        fi
      fi
    fi
  done < /etc/passwd

  if [ -f "$XRAY_DB" ]; then
    TMP=$(mktemp)
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      vuser=$(echo "$line" | awk '{print $1}')
      vuuid=$(echo "$line" | awk '{print $2}')
      NCOLS=$(echo "$line" | awk '{print NF}')
      if [ "$NCOLS" -ge 5 ]; then
        vexpiry=$(echo "$line" | awk '{print $3" "$4}')
        vproto=$(echo "$line" | awk '{print $5}')
      else
        vexpiry=$(echo "$line" | awk '{print $3}')
        vproto=$(echo "$line" | awk '{print $4}')
      fi
      EXP_S=$(date -d "$vexpiry" +%s 2>/dev/null || echo 0)
      if [ "$EXP_S" -gt "$NOW_S" ]; then
        echo "$line" >> "$TMP"
      else
        remove_account_package "${vproto:-xray}" "$vuuid"
      fi
    done < "$XRAY_DB"
    mv "$TMP" "$XRAY_DB"
  fi
}

