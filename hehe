# ══════════════════════════════════════════════

install_websocket() {
  echo -e " ${Y}[*] Installing Python WebSocket proxy (port 8080, Keep-Alive + 301)...${N}"

  cat > /usr/local/bin/ws-proxy.py << 'PYEOF'
#!/usr/bin/env python3
import os
import socket
import threading
import select
import sys

LISTEN_PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
SSH_HOST = '127.0.0.1'
SSH_PORT = 22
NGINX_PORT = 8880
BUFFER = 65535
TIMEOUT = 120
CONFIG_FILE = '/etc/vantricks_script.conf'

V2RAY_PATHS = (b'/vmess', b'/vless', b'/trojan', b'/xhttp')

RESPONSE_COLOR = (
    b"HTTP/1.1 101 <font color=#FF0000>vantricks</font>\r\n"
    b"Upgrade: websocket\r\n"
    b"Connection: keep-alive, Upgrade\r\n"
    b"Keep-Alive: timeout=86400, max=100000\r\n"
    b"Sec-WebSocket-Version: 13\r\n"
    b"Via: vantricks-CDN-SSH\r\n"
    b"\r\n"
)

def get_default_domain():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, 'r') as f:
                for line in f:
                    if line.startswith('CDN_DOMAIN='):
                        val = line.split('=', 1)[1].strip()
                        if val:
                            return val
                    if line.startswith('HOST='):
                        val = line.split('=', 1)[1].strip()
                        if val:
                            return val
        except Exception:
            pass
    return 'vantricks.local'

def build_301_response(raw_req):
    target_host = get_default_domain()
    path = '/'
    lines = raw_req.split(b'\r\n')
    if lines and b' ' in lines[0]:
        parts = lines[0].split(b' ')
        if len(parts) >= 2:
            path = parts[1].decode('utf-8', errors='ignore') or '/'
    for ln in lines[1:]:
        if ln.lower().startswith(b'host:'):
            h = ln.split(b':', 1)[1].strip().decode('utf-8', errors='ignore')
            if h:
                target_host = h
            break
    location = f"https://{target_host}{path}"
    resp = (
        f"HTTP/1.1 301 Moved Permanently\r\n"
        f"Location: {location}\r\n"
        f"Connection: keep-alive\r\n"
        f"Keep-Alive: timeout=86400, max=100000\r\n"
        f"Content-Length: 0\r\n"
        f"Via: vantricks-CDN-301\r\n"
        f"\r\n"
    )
    return resp.encode('utf-8')

def enable_keepalive(sock):
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        if hasattr(socket, 'TCP_KEEPIDLE'):
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, 60)
        if hasattr(socket, 'TCP_KEEPINTVL'):
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, 15)
        if hasattr(socket, 'TCP_KEEPCNT'):
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, 4)
    except Exception:
        pass

def forward(src, dst):
    enable_keepalive(src)
    enable_keepalive(dst)
    try:
        while True:
            r, _, _ = select.select([src], [], [], TIMEOUT)
            if r:
                d = src.recv(BUFFER)
                if not d:
                    break
                dst.sendall(d)
    except Exception:
        pass
    finally:
        for sock in (src, dst):
            try:
                sock.close()
            except Exception:
                pass

def handle(client):
    enable_keepalive(client)
    try:
        data = client.recv(BUFFER)
        if not data:
            client.close()
            return

        lower_data = data.lower()
        is_http = data[:4] in (b'GET ', b'POST', b'HEAD', b'CONN', b'PUT ', b'OPTI') or b'host:' in lower_data
        is_websocket = b'upgrade: websocket' in lower_data
        is_v2ray = is_http and any(path in data for path in V2RAY_PATHS)

        # Direct single-backend routing (No Load Balance)
        if is_v2ray:
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            enable_keepalive(target)
            target.connect((SSH_HOST, NGINX_PORT))
            target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
        elif is_http and not is_websocket:
            # 301 Moved Permanently for non-WebSocket HTTP requests
            client.sendall(build_301_response(data))
            client.close()
            return
        else:
            target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            enable_keepalive(target)
            target.connect((SSH_HOST, SSH_PORT))
            if is_http:
                client.sendall(RESPONSE_COLOR)
            else:
                target.sendall(data)
            threading.Thread(target=forward, args=(client, target), daemon=True).start()
            threading.Thread(target=forward, args=(target, client), daemon=True).start()
    except Exception:
        try:
            client.close()
        except Exception:
            pass

def start(port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    enable_keepalive(srv)
    srv.bind(('0.0.0.0', port))
    srv.listen(512)
    while True:
        try:
            c, _ = srv.accept()
            enable_keepalive(c)
            threading.Thread(target=handle, args=(c,), daemon=True).start()
        except Exception:
            pass

if __name__ == '__main__':
    start(LISTEN_PORT)
PYEOF

