install_xhttp() {
  echo -e " ${Y}[*] Installing XHTTP Proxy (port 8000)...${N}"

  cat > /usr/local/bin/xhttp-proxy.py << 'PYEOF'
#!/usr/bin/env python3
import socket, threading, select

LISTEN_PORT = 8000
SSH_HOST = '127.0.0.1'
SSH_PORT = 22
BUFFER = 65535
TIMEOUT = 60

RESPONSE = b"HTTP/1.1 200 OK\r\nContent-Length: 999999999\r\n\r\n"

def forward(src, dst):
    try:
        while True:
            r, _, _ = select.select([src], [], [], TIMEOUT)
            if r:
                d = src.recv(BUFFER)
                if not d: break
                dst.sendall(d)
    except: pass
    finally:
        try: src.close()
        except: pass
        try: dst.close()
        except: pass

def handle(client):
    try:
        data = client.recv(BUFFER)
        if not data:
            client.close()
            return

        target = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        target.connect((SSH_HOST, SSH_PORT))
        
        # If standard HTTP injection request, fake a successful response before proxying data
        if data.startswith(b'GET') or data.startswith(b'POST') or data.startswith(b'HTTP'):
            client.send(RESPONSE)
        else:
            target.sendall(data)
            
        threading.Thread(target=forward, args=(client, target), daemon=True).start()
        threading.Thread(target=forward, args=(target, client), daemon=True).start()
    except:
        try: client.close()
        except: pass

def start(port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(('0.0.0.0', port))
    srv.listen(200)
    while True:
        try:
            c, _ = srv.accept()
            threading.Thread(target=handle, args=(c,), daemon=True).start()
        except: pass

if __name__ == '__main__':
    start(LISTEN_PORT)
PYEOF

  chmod +x /usr/local/bin/xhttp-proxy.py

  cat > /etc/systemd/system/xhttp-proxy.service << EOF
[Unit]
Description=XHTTP Proxy Port 8000
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/xhttp-proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
  systemctl enable xhttp-proxy > /dev/null 2>&1
  systemctl start xhttp-proxy > /dev/null 2>&1

  echo -e " ${G}[✓] XHTTP Proxy running on port 8000${N}"
}

