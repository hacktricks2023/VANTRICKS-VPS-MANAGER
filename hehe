  mkdir -p /usr/local/etc/xray /etc/xray
  touch /etc/xray/accounts.db

  cat > /usr/local/etc/xray/config.json << CFGEOF
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "port": 10086, "listen": "127.0.0.1", "protocol": "vmess",
