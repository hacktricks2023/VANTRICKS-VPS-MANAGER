replace_single_uuid_files() {
  local TARGET_USER="$1"
  local TARGET_OLD_UUID="$2"
  local NEW_UUID="$3"
  local TARGET_PROTO="$4"
  local ASSIGNED_PKG="$5"

  python3 - << PYRESET
import json

conf_path = "$XRAY_CONF"
old_id = "$TARGET_OLD_UUID"
new_id = "$NEW_UUID"
proto = "$TARGET_PROTO"
user_name = "$TARGET_USER"

try:
    with open(conf_path, "r") as f:
        cfg = json.load(f)
except Exception:
    cfg = {}

for inb in cfg.get("inbounds", []):
    net = inb.get("streamSettings", {}).get("network", "")
    iprot = inb.get("protocol", "")
    match_inbound = (
        (proto == "xhttp" and net == "xhttp") or
        (proto != "xhttp" and iprot == proto and net == "ws")
    )
    if match_inbound:
        clients = inb.get("settings", {}).get("clients", [])
        updated_clients = []
        replaced = False
        for c in clients:
            cid = c.get("id") or c.get("password")
            if cid == old_id:
                new_entry = dict(c)
                if "password" in new_entry and iprot == "trojan":
                    new_entry["password"] = new_id
                else:
                    new_entry["id"] = new_id
                if user_name:
                    new_entry["email"] = user_name
                updated_clients.append(new_entry)
                replaced = True
            elif cid != new_id:
                updated_clients.append(c)
        if not replaced:
            if iprot == "trojan":
                updated_clients.append({"password": new_id, "email": user_name})
            else:
                updated_clients.append({"id": new_id, "alterId": 0, "email": user_name})
        inb.setdefault("settings", {})["clients"] = updated_clients

with open(conf_path, "w") as f:
    json.dump(cfg, f, indent=2)
PYRESET

  local TMP_DB
  TMP_DB=$(mktemp)
  while IFS= read -r dbline; do
    [ -z "$dbline" ] && continue
    local duser duuid dexp dprot dcols
    duser=$(echo "$dbline" | awk '{print $1}')
    duuid=$(echo "$dbline" | awk '{print $2}')
    dcols=$(echo "$dbline" | awk '{print NF}')
    if [ "$dcols" -ge 5 ]; then
      dexp=$(echo "$dbline" | awk '{print $3" "$4}')
      dprot=$(echo "$dbline" | awk '{print $5}')
    else
      dexp=$(echo "$dbline" | awk '{print $3}')
      dprot=$(echo "$dbline" | awk '{print $4}')
    fi
    if [ "$duser" == "$TARGET_USER" ] && [ "$duuid" == "$TARGET_OLD_UUID" ] && [ "$dprot" == "$TARGET_PROTO" ]; then
      echo "${duser} ${NEW_UUID} ${dexp} ${dprot}" >> "$TMP_DB"
    else
      echo "$dbline" >> "$TMP_DB"
    fi
  done < "$XRAY_DB"
  mv "$TMP_DB" "$XRAY_DB"

  remove_account_package "$TARGET_PROTO" "$TARGET_OLD_UUID"
  if [ -n "$ASSIGNED_PKG" ]; then
    set_account_package "$TARGET_PROTO" "$NEW_UUID" "$ASSIGNED_PKG"
  fi
}

v2ray_batch_uuid_reset() {
  touch "$XRAY_DB"
  init_packages_store

  local BATCH_ROWS=()
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local buser buuid bexp bprot bcols bpkg bnew
    buser=$(echo "$line" | awk '{print $1}')
    buuid=$(echo "$line" | awk '{print $2}')
    bcols=$(echo "$line" | awk '{print NF}')
    if [ "$bcols" -ge 5 ]; then
      bexp=$(echo "$line" | awk '{print $3" "$4}')
      bprot=$(echo "$line" | awk '{print $5}')
    else
      bexp=$(echo "$line" | awk '{print $3}')
      bprot=$(echo "$line" | awk '{print $4}')
    fi
    bpkg=$(get_account_package "$bprot" "$buuid")
    [ -z "$bpkg" ] && bpkg=$(head -n 1 "$PACKAGES_FILE" 2>/dev/null | tr -d '[:space:]')
    bnew=$(python3 -c 'import uuid; print(str(uuid.uuid4()))')
    BATCH_ROWS+=("${buser}|${buuid}|${bnew}|${bexp}|${bprot}|${bpkg}")
  done < "$XRAY_DB"

  if [ ${#BATCH_ROWS[@]} -eq 0 ]; then
    echo -e "\n ${Y}[!] No Xray accounts found for batch UUID reset.${N}"
    sleep 2
    return
  fi

  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}     ${W}ONE-CLICK BATCH UUID RESET (ALL ACCOUNTS)${N}  ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  Accounts to rotate : ${G}${#BATCH_ROWS[@]}${N}"
  echo -e "${C}║${N}  Old UUIDs          : ${R}PURGED & DISABLED ON SAVE${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  for row in "${BATCH_ROWS[@]}"; do
    local r_u r_o r_n r_p
    r_u=$(echo "$row" | cut -d'|' -f1)
    r_o=$(echo "$row" | cut -d'|' -f2)
    r_n=$(echo "$row" | cut -d'|' -f3)
    r_p=$(echo "$row" | cut -d'|' -f5)
    echo -e "${C}║${N}  ${G}${r_u}${N} (${Y}${r_p^^}${N})"
    echo -e "${C}║${N}    Old: ${R}${r_o}${N}"
    echo -e "${C}║${N}    New: ${G}${r_n}${N}"
  done
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  ${W}[s]${N} Save All & Auto Reboot Server              ${C}║${N}"
  echo -e "${C}║${N}  ${W}[c]${N} Cancel                                   ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════════╝${N}"
  read -p " Action >>> " B_SAVE

  case "$B_SAVE" in
    s|S)
      for row in "${BATCH_ROWS[@]}"; do
        local r_u r_o r_n r_p r_pkg
        r_u=$(echo "$row" | cut -d'|' -f1)
        r_o=$(echo "$row" | cut -d'|' -f2)
        r_n=$(echo "$row" | cut -d'|' -f3)
        r_p=$(echo "$row" | cut -d'|' -f5)
        r_pkg=$(echo "$row" | cut -d'|' -f6)
        replace_single_uuid_files "$r_u" "$r_o" "$r_n" "$r_p" "$r_pkg"
      done
      sync_host_config
      apply_enhancement_booster
      apply_banner_config
      systemctl restart xray > /dev/null 2>&1 || true
      trigger_auto_reboot "Batch UUID reset completed for ${#BATCH_ROWS[@]} account(s). Old UUIDs removed; rebooting..."
      ;;
    *)
      echo -e "\n ${Y}[!] Batch UUID reset cancelled.${N}"
      sleep 1
      ;;
  esac
}

