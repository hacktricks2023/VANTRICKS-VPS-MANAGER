# ▰▰▱▱▱▱▱▱  (always 8 columns wide; green = free, yellow = full, red = over)
mux_slotbar() {
  local u="$1" l="$2" cells f i col="$G" s=""
  if [ "$l" -le 0 ]; then cells=$((u < 1 ? 1 : u)); else cells="$l"; fi
  [ "$cells" -gt 8 ] && cells=8
  f="$u"; [ "$f" -gt "$cells" ] && f="$cells"
  if [ "$l" -gt 0 ] && [ "$u" -gt "$l" ]; then col="$R"; elif [ "$l" -gt 0 ] && [ "$u" -eq "$l" ]; then col="$Y"; fi
  for ((i = 0; i < cells; i++)); do
    if [ "$i" -lt "$f" ]; then s+="${col}▰${N}"; else s+="${DIM}▱${N}"; fi
  done
  printf '%b%*s' "$s" "$((8 - cells))" ''
}

