#!/bin/bash
# ==============================================================================
# VANTRICKS VPS MANAGER - FULL AUTOMATED SUITE (NO KEY / ALL IN ONE)
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL VARIABLES & PATHS
# ------------------------------------------------------------------------------
IP_ADDRESS=$(hostname -I | awk '{print $1}')
DOMAIN_FILE="/etc/.domain"
NS_FILE="/etc/.nsdomain"
BANNER_FILE="/etc/issue.net"

# ------------------------------------------------------------------------------
# UI HELPER FUNCTIONS
# ------------------------------------------------------------------------------
fun_bar() {
    local cmd1="$1"
    local cmd2="$2"
    
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        eval "$cmd1" > /dev/null 2>&1
        eval "$cmd2" > /dev/null 2>&1
        touch $HOME/fim
    ) > /dev/null 2>&1 &
    
    tput civis
    echo -ne "  \033[1;33m◇ INSTALLING IN PROGRESS... \033[1;37m- \033[1;33m["
    while true; do
        for ((i=0; i<18; i++)); do
            echo -ne "\033[1;31m#"
            sleep 0.05s
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
        echo -e "\033[1;33m]"
        sleep 0.5s
        tput cuu1
        tput dl1
        echo -ne "  \033[1;33m◇ INSTALLING IN PROGRESS... \033[1;37m- \033[1;33m["
    done
    echo -e "\033[1;33m]\033[1;37m -\033[1;32m◇ DONE!\033[0m"
    tput cnorm
}

show_header() {
    clear
    tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "◇─────────ㅤ🌍 VANTRICKS VPS MANAGER (UNLOCKED) 🌍ㅤ─────────◇" ; tput sgr0
    echo ""
}

# ------------------------------------------------------------------------------
# CORE INSTALLATION MODULES
# ------------------------------------------------------------------------------

# 1. Base Package Installation
install_packages() {
    local pacotes=(
        "bc" "cron" "screen" "nano" "unzip" "lsof" "net-tools" 
        "dos2unix" "nload" "jq" "curl" "figlet" "python3" "python3-pip"
        "socat" "iptables" "tar" "git"
    )
    apt-get update -y > /dev/null 2>&1
    for prog in "${pacotes[@]}"; do
        apt-get install -y "$prog" > /dev/null 2>&1
    done

    # Setup default fallback user
    if ! id "lxd1" &>/dev/null; then
        useradd -m -s /bin/false lxd1
        echo "lxd1:0001" | chpasswd
    fi
}

# 2. Custom OpenSSH Configurations
install_custom_openssh() {
    sed -i 's/#Port 22/Port 22/' /etc/ssh/sshd_config
    sed -i 's/Port 22222/Port 22/' /etc/ssh/sshd_config
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
    sed -i 's/#Banner none/Banner \/etc\/issue.net/' /etc/ssh/sshd_config
    systemctl restart ssh > /dev/null 2>&1 || service ssh restart > /dev/null 2>&1
}

# 3. Nginx Installation & Setup
install_nginx() {
    apt-get install -y nginx > /dev/null 2>&1
    systemctl enable nginx > /dev/null 2>&1
    systemctl restart nginx > /dev/null 2>&1
}

# 4. Certbot / SSL Installation
install_ssl() {
    apt-get install -y certbot python3-certbot-nginx > /dev/null 2>&1
    if [[ -f "$DOMAIN_FILE" ]]; then
        local domain=$(cat "$DOMAIN_FILE")
        certbot --nginx -d "$domain" --non-interactive --agree-tos --register-unsafely-without-email > /dev/null 2>&1
    fi
}

# 5. WebSocket Proxy Setup
install_websocket() {
    wget -O /usr/local/bin/ws-server https://raw.githubusercontent.com/hacktricks2023/VANTRICKS-VPS-MANAGER/main/Install/ws-server > /dev/null 2>&1 || true
    chmod +x /usr/local/bin/ws-server > /dev/null 2>&1
}

# 6. XHTTP Core Framework
install_xhttp() {
    mkdir -p /etc/xhttp
    echo "XHTTP Core framework initialized." > /etc/xhttp/config.json
}

# 7. SlowDNS / DNSTT Setup
install_dnstt() {
    rm -rf /tmp/install_sdns
    wget -O /tmp/install_sdns https://raw.githubusercontent.com/leitura/slowdns/main/install > /dev/null 2>&1
    if [[ -f /tmp/install_sdns ]]; then
        chmod +x /tmp/install_sdns
        # Auto-configure default non-interactive installation
        /tmp/install_sdns auto > /dev/null 2>&1 || true
    fi
}

# 8. UDP Request / SocksIP Setup
install_udp_request() {
    wget -O /tmp/UDPserver.sh https://raw.githubusercontent.com/AVEGAH/SocksIP-udpServer/main/UDPserver.sh > /dev/null 2>&1
    if [[ -f /tmp/UDPserver.sh ]]; then
        chmod +x /tmp/UDPserver.sh
        /tmp/UDPserver.sh auto > /dev/null 2>&1 || true
    fi
}

# 9. OpenVPN Module
install_ovpn() {
    apt-get install -y openvpn ca-certificates > /dev/null 2>&1
}

# 10. V2Ray / Xray Automated Installer
install_v2ray_auto() {
    bash <(curl -L https://raw.githubusercontent.com/v2fly/fhs-install-v2ray/master/install-release.sh) > /dev/null 2>&1 || true
}

# ------------------------------------------------------------------------------
# HOST, NAMESERVER & BANNER MANAGEMENT
# ------------------------------------------------------------------------------
configure_domain_ns() {
    echo -e "\033[1;36m◇ DOMAIN & NAMESERVER CONFIGURATION\033[0m"
    
    # Domain configuration
    echo -ne "\033[1;33m◇ Enter Host/Domain Name (e.g., vps.example.com) [Press Enter to skip]: \033[0m"
    read input_domain
    if [[ -n "$input_domain" ]]; then
        echo "$input_domain" > "$DOMAIN_FILE"
        echo -e "\033[1;32m✔ Host updated: $input_domain\033[0m"
    fi

    # NameServer configuration
    echo -ne "\033[1;33m◇ Enter NS (Nameserver) Domain (e.g., ns.example.com) [Press Enter to skip]: \033[0m"
    read input_ns
    if [[ -n "$input_ns" ]]; then
        echo "$input_ns" > "$NS_FILE"
        echo -e "\033[1;32m✔ Nameserver updated: $input_ns\033[0m"
    fi
    echo ""
}

manage_banner() {
    echo -e "\033[1;36m◇ CUSTOM SSH BANNER SETUP\033[0m"
    echo -e "Enter your custom SSH banner text below (Type \033[1;31mEND\033[0m on a new line to save):"
    
    > "$BANNER_FILE"
    while true; do
        read -r line
        [[ "$line" == "END" ]] && break
        echo "$line" >> "$BANNER_FILE"
    done
    
    echo -e "\033[1;32m✔ SSH Banner saved successfully to $BANNER_FILE\033[0m\n"
}

# ------------------------------------------------------------------------------
# MAIN EXECUTION FLOW
# ------------------------------------------------------------------------------

show_header

# 1. Privilege Check
if [[ "$(id -u)" -ne 0 ]]; then
    echo -e "\033[1;31m[ERROR] This script must be executed as root!\033[0m"
    exit 1
fi

# 2. Host and NameServer Configuration Prompt
configure_domain_ns

# 3. Custom Banner Prompt
echo -ne "\033[1;36m◇ Do you want to configure a custom SSH banner right now? [y/N]: \033[0m"
read set_banner
if [[ "$set_banner" =~ ^[Yy]$ ]]; then
    manage_banner
fi

# 4. Begin Automated Merge Installation
echo -e "\033[1;33m◇ STARTING FULL AUTOMATED SUITE INSTALLATION...\033[0m"
echo ""

echo -e "\033[1;32m[1/8] Updating System & Installing Core Dependencies...\033[0m"
fun_bar 'install_packages'

echo -e "\033[1;32m[2/8] Configuring Custom OpenSSH...\033[0m"
fun_bar 'install_custom_openssh'

echo -e "\033[1;32m[3/8] Deploying Nginx & Requesting SSL Certificates...\033[0m"
fun_bar 'install_nginx' 'install_ssl'

echo -e "\033[1;32m[4/8] Installing WebSocket & XHTTP Protocol Handlers...\033[0m"
fun_bar 'install_websocket' 'install_xhttp'

echo -e "\033[1;32m[5/8] Configuring SlowDNS & DNSTT Services...\033[0m"
fun_bar 'install_dnstt'

echo -e "\033[1;32m[6/8] Deploying UDP Request Server...\033[0m"
fun_bar 'install_udp_request'

echo -e "\033[1;32m[7/8] Installing OpenVPN Infrastructure...\033[0m"
fun_bar 'install_ovpn'

echo -e "\033[1;32m[8/8] Installing V2Ray Core Engine...\033[0m"
fun_bar 'install_v2ray_auto'

# Configure Global Shortcut Alias
echo "/bin/menu" > /bin/h && chmod +x /bin/h > /dev/null 2>&1

# Firewall Unlocks
if [[ -f "/usr/sbin/ufw" ]]; then
    ufw allow 22/tcp > /dev/null 2>&1
    ufw allow 80/tcp > /dev/null 2>&1
    ufw allow 443/tcp > /dev/null 2>&1
    ufw allow 3128/tcp > /dev/null 2>&1
    ufw allow 8080/tcp > /dev/null 2>&1
    ufw allow 53/udp > /dev/null 2>&1
fi

# Clean execution history
cat /dev/null > ~/.bash_history && history -c

# ------------------------------------------------------------------------------
# COMPLETION
# ------------------------------------------------------------------------------
show_header
echo -e "        \033[1;32m◇ ALL INSTALLATIONS COMPLETED SUCCESSFULLY! ◇\033[0m"
echo ""
echo -e "\033[1;33m◇ MAIN MENU COMMAND : \033[1;32mmenu\033[0m or \033[1;32mh\033[0m"
if [[ -f "$DOMAIN_FILE" ]]; then
    echo -e "\033[1;33m◇ DOMAIN            : \033[1;37m$(cat $DOMAIN_FILE)\033[0m"
fi
if [[ -f "$NS_FILE" ]]; then
    echo -e "\033[1;33m◇ NAMESERVER        : \033[1;37m$(cat $NS_FILE)\033[0m"
fi
echo -e "\033[1;33m◇ SERVER IP         : \033[1;37m$IP_ADDRESS\033[0m"
echo ""
echo -e "\033[1;36m=============================================================\033[0m"
