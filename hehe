    echo -e " ${W}[0]${N} Return"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    read -p " Option: " PROTO_CHK
    case $PROTO_CHK in
      1) v2ray_check_by_proto "vless"  ;;
      2) v2ray_check_by_proto "vmess"  ;;
