build_xray_links() {
  local PROTO="$1"
  local USER="$2"
  local UUID="$3"
  local P_HOST="${HOST:-$SERVER_IP}"

  if [ "$PROTO" == "vmess" ]; then
    VMESS_JSON_TLS=$(cat << EOF
{
  "v": "2",
  "ps": "${USER}-VMess-TLS",
  "add": "${P_HOST}",
  "port": "443",
  "id": "${UUID}",
  "aid": "0",
  "scy": "auto",
  "net": "ws",
  "type": "none",
  "host": "${P_HOST}",
  "path": "/vmess",
  "tls": "tls",
  "sni": "${P_HOST}"
}
EOF
)
    VMESS_JSON_NTLS=$(cat << EOF
{
  "v": "2",
  "ps": "${USER}-VMess-80",
  "add": "${P_HOST}",
  "port": "80",
  "id": "${UUID}",
  "aid": "0",
  "scy": "auto",
  "net": "ws",
  "type": "none",
  "host": "${P_HOST}",
  "path": "/vmess",
  "tls": "none"
}
EOF
)
    LINK_TLS="vmess://$(echo -n "$VMESS_JSON_TLS" | base64 -w 0)"
    LINK_NTLS="vmess://$(echo -n "$VMESS_JSON_NTLS" | base64 -w 0)"
    LINK_XHTTP=""
  elif [ "$PROTO" == "vless" ]; then
    LINK_TLS="vless://${UUID}@${P_HOST}:443?encryption=none&security=tls&sni=${P_HOST}&type=ws&host=${P_HOST}&path=%2Fvless#${USER}-VLESS-TLS"
    LINK_NTLS="vless://${UUID}@${P_HOST}:80?encryption=none&security=none&type=ws&host=${P_HOST}&path=%2Fvless#${USER}-VLESS-80"
    LINK_XHTTP="vless://${UUID}@${P_HOST}:443?encryption=none&security=tls&sni=${P_HOST}&type=xhttp&host=${P_HOST}&path=%2Fxhttp&mode=auto#${USER}-VLESS-XHTTP"
  else
    LINK_TLS="trojan://${UUID}@${P_HOST}:443?security=tls&sni=${P_HOST}&type=ws&host=${P_HOST}&path=%2Ftrojan#${USER}-Trojan-TLS"
    LINK_NTLS="trojan://${UUID}@${P_HOST}:80?security=none&type=ws&host=${P_HOST}&path=%2Ftrojan#${USER}-Trojan-80"
    LINK_XHTTP=""
  fi
}

