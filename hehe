# ── PASSWORD CHECK ────────────────────────────────
check_password() {
  if [ ! -f "$CONFIG_FILE" ]; then
    clear
    echo -e "${C}╔══════════════════════════════════════════════╗${N}"
    echo -e "${C}║${N}          ${W}Vantricks VPS Manager${N}                ${C}║${N}"
    echo -e "${C}╠══════════════════════════════════════════════╣${N}"
    read -p "  Password (Vantricks2026) : " INPUT_PASS

    CORRECT_PASS="Vantricks2026"

    if [ "$INPUT_PASS" == "$CORRECT_PASS" ]; then
      echo -e " ${G}[✓] Password correct! Proceeding...${N}"
      sleep 1
    else
      echo -e " ${R}[!] Wrong password! Access denied.${N}"
      echo ""
      exit 1
    fi
  fi
}
