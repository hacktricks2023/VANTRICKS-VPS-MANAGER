# Colors
R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
C='\033[0;36m'
W='\033[1;37m'
N='\033[0m'

DIV="════════════════════════════════════════════════"
CONFIG_FILE="/etc/vantricks_script.conf"
PACKAGES_FILE="/etc/vantricks_packages.list"
ACCOUNT_PKG_DB="/etc/vantricks_account_packages.db"
SNI_PROXY_HOST_FILE="/etc/vantricks_sni_proxy_hosts.list"
BOOSTER_SYSCTL_CONF="/etc/sysctl.d/99-vantricks-booster.conf"
BOOSTER_SCRIPT="/usr/local/bin/vantricks-booster.py"
SLIPSTREAM_BIN="/usr/local/bin/slipstream-server"
SLIPSTREAM_DIR="/etc/slipstream-rust"
OVPN_DIR="/etc/openvpn/server"
OVPN_CLIENT_DIR="/etc/openvpn/client"
XRAY_CONF="/usr/local/etc/xray/config.json"
XRAY_DB="/etc/xray/accounts.db"
NGINX_V2RAY_CONF="/etc/nginx/conf.d/v2ray.conf"
