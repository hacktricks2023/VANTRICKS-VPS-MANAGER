  generate_ovpn_profile "$NEW_USER"

  PAYLOAD_1="GET / HTTP/1.1[crlf]Host: ${CDN_DOMAIN}[crlf]Connection: keep-alive[crlf][crlf][instant_split][crlf][crlf]GET / HTTP/1.1[crlf]Host: ${HOST}[crlf]Upgrade: websocket[crlf]Connection: keep-alive, Upgrade[crlf][crlf]"
