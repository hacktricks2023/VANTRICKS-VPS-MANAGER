replace_single_uuid_files() {
  local TARGET_USER="$1"
  local OLD_UUID="$2"
  local NEW_UUID="$3"
  local PROTO="$4"

  python3 - "$XRAY_CONF" "$PROTO" "$TARGET_USER" "$OLD_UUID" "$NEW_UUID" << 'PYEOF'
import json, sys, os
conf_path, proto, user, old_u, new_u = sys.argv[1:6]
if not os.path.exists(conf_path):
    sys.exit(1)
with open(conf_path, 'r') as f:
    cfg = json.load(f)
for ib in cfg.get('inbounds', []):
    if ib.get('protocol') == proto:
        for c in ib.get('settings', {}).get('clients', []):
            if c.get('id') == old_u or c.get('password') == old_u or c.get('email') == user:
                if 'id' in c:
                    c['id'] = new_u
                if 'password' in c:
                    c['password'] = new_u
with open(conf_path, 'w') as f:
    json.dump(cfg, f, indent=2)
PYEOF

  if [ -f "$XRAY_DB" ]; then
    local TMP
    TMP=$(mktemp)
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      local lu luid
      lu=$(echo "$line" | awk '{print $1}')
      luid=$(echo "$line" | awk '{print $2}')
      if [ "$lu" == "$TARGET_USER" ] && [ "$luid" == "$OLD_UUID" ]; then
        echo "${line/$OLD_UUID/$NEW_UUID}" >> "$TMP"
      else
        echo "$line" >> "$TMP"
      fi
    done < "$XRAY_DB"
    mv "$TMP" "$XRAY_DB"
  fi

  local OLD_PKG
  OLD_PKG=$(get_account_package "$PROTO" "$OLD_UUID")
  [ -z "$OLD_PKG" ] && OLD_PKG="DEFAULT"
  remove_account_package "$PROTO" "$OLD_UUID"
  set_account_package "$PROTO" "$NEW_UUID" "$OLD_PKG"
}

