repair_openvpn() {
  # usage: repair_openvpn [quiet]   - rebuilds missing/empty certs, fixes tun + systemd limits, restarts, shows real errors
  local QUIET="$1"
  local EAR=/etc/openvpn/easy-rsa
  [ "$QUIET" = "quiet" ] || echo -e " ${Y}[*] Repairing OpenVPN (UDP 1194 + TCP/443 via sslh)...${N}"

  DEBIAN_FRONTEND=noninteractive apt-get install -y openvpn easy-rsa libpam0g > /dev/null 2>&1

  # TUN device must exist
  mkdir -p /dev/net
  [ -c /dev/net/tun ] || { mknod /dev/net/tun c 10 200 2>/dev/null; chmod 600 /dev/net/tun 2>/dev/null; }
  modprobe tun > /dev/null 2>&1 || true

  # Debian's openvpn-server@ unit has LimitNPROC=10 which breaks the PAM login plugin (fork)
  mkdir -p /etc/systemd/system/openvpn-server@.service.d
  printf '[Service]\nLimitNPROC=infinity\n' > /etc/systemd/system/openvpn-server@.service.d/acero.conf

  # rewrite configs + certs + iptables + enable/restart (in a subshell, it does cd)
  ( install_openvpn ) > /dev/null 2>&1

  chmod 600 "$OVPN_DIR/server.key" "$OVPN_DIR/ta.key" 2>/dev/null
  mkdir -p /var/log/openvpn
  # new CA => old client profiles no longer match, rebuild them for every existing account
  if [ -f /tmp/ovpn_newca ]; then
    rm -f /tmp/ovpn_newca
    local pf u
    for pf in "$OVPN_CLIENT_DIR"/*-tcp443.ovpn; do
      [ -f "$pf" ] || continue
      u=$(basename "$pf" -tcp443.ovpn)
      generate_ovpn_profile "$u" > /dev/null 2>&1
    done
    [ "$QUIET" = "quiet" ] || echo -e " ${Y}[!] New certificate created - old .ovpn files were rebuilt, re-send them to your users${N}"
  fi
  systemctl reset-failed openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  systemctl restart openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  sleep 2

  local U T
  U=$(systemctl is-active openvpn-server@server 2>/dev/null)
  T=$(systemctl is-active openvpn-server@server-tcp 2>/dev/null)
  if [ "$U" = "active" ] && [ "$T" = "active" ]; then
    # sslh forwards 443 -> 11940, make sure it is up too
    systemctl is-active --quiet sslh || systemctl restart sslh > /dev/null 2>&1 || systemctl restart sslh-select > /dev/null 2>&1
    [ "$QUIET" = "quiet" ] || echo -e " ${G}[✓] OpenVPN UDP + TCP are running${N}"
    return 0
  fi

  {
    echo "== OpenVPN repair $(date) =="
    echo "UDP: $U   TCP: $T"
    journalctl -u openvpn-server@server -n 15 --no-pager 2>/dev/null
    journalctl -u openvpn-server@server-tcp -n 15 --no-pager 2>/dev/null
    ss -ulnp 2>/dev/null | grep ':1194 '
    ss -tlnp 2>/dev/null | grep ':11940 '
  } > /root/ovpn-error.log 2>&1
  if [ "$QUIET" != "quiet" ]; then
    echo -e " ${R}[x] OpenVPN still not running. Real error:${N}"
    tail -n 25 /root/ovpn-error.log
    echo -e " ${Y}Saved in /root/ovpn-error.log - send it to Claude${N}"
  fi
  return 1
}

