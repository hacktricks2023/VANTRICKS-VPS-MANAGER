create_ssh() {
  clear
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e "${W} Create SSH Account ${N}"
  echo -e "${C}════════════════════════════════════════════════${N}"
  read -p " Username : " user
  if id "$user" &>/dev/null; then
    echo -e "${R} Error: Username already exists!${N}"
    press_enter
    ssh_menu
  fi
  read -p " Password : " pass
  read -p " Expire (Days) : " days
  read -p " Multi-login limit : " limit

  exp=$(date -d "+$days days" +"%Y-%m-%d")
  useradd -m -s /bin/false -e "$exp" "$user"
  echo "$user:$pass" | chpasswd

  # Add limit to sshd_config
  echo "Match User $user" >> /etc/ssh/sshd_config
  echo "  MaxSessions $limit" >> /etc/ssh/sshd_config
  systemctl restart ssh > /dev/null 2>&1

  clear
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e "${G} SSH Account Created! ${N}"
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e " Username : $user"
  echo -e " Password : $pass"
  echo -e " Expire   : $exp ($days days)"
  echo -e " Multi    : $limit device(s)"
  echo -e "${C}════════════════════════════════════════════════${N}"
  press_enter
  ssh_menu
}

delete_ssh() {
  clear
  read -p " Username to delete : " user
  if id "$user" &>/dev/null; then
    userdel -r "$user"
    sed -i "/Match User $user/,/MaxSessions/d" /etc/ssh/sshd_config
    systemctl restart ssh > /dev/null 2>&1
    echo -e "${G} [✓] Deleted successfully!${N}"
  else
    echo -e "${R} [!] User not found!${N}"
  fi
  press_enter
  ssh_menu
}

list_ssh() {
  clear
  echo -e "${C}════════════════════════════════════════════════${N}"
  echo -e "${W} List SSH Accounts ${N}"
  echo -e "${C}════════════════════════════════════════════════${N}"
  awk -F: '$3>=1000 && $1!="nobody"' /etc/passwd | while read line; do
    user=$(echo $line | cut -d: -f1)
    exp=$(chage -l $user | grep "Account expires" | cut -d: -f2 | xargs)
    if [ "$exp" == "never" ] || [ -z "$exp" ]; then exp="Lifetime"; fi
    printf " %-15s %s\n" "$user" "$exp"
  done
  echo -e "${C}════════════════════════════════════════════════${N}"
  press_enter
  ssh_menu
}

renew_ssh() {
  clear
  read -p " Username : " user
  if id "$user" &>/dev/null; then
    read -p " Extend (Days) : " days
    exp=$(date -d "+$days days" +"%Y-%m-%d")
    chage -E "$exp" "$user"
    echo -e "${G} [✓] Renewed until $exp!${N}"
  else
    echo -e "${R} [!] User not found!${N}"
  fi
  press_enter
  ssh_menu
}

