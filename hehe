create_ssh() {
  clear
  source "$CONFIG_FILE"
  SERVER_IP=$(hostname -I | awk '{print $1}')
  
  read -p " Username : " user
  id "$user" &>/dev/null && { echo -e "${R}User exists!${NC}"; press_enter; ssh_menu; }
  read -p " Password : " pass
  read -p " Expire (Days) : " days
  read -p " Multi-login limit : " limit

  exp=$(date -d "+$days days" +"%Y-%m-%d")
  useradd -m -s /bin/false -e "$exp" "$user"
  echo "$user:$pass" | chpasswd
  echo "Match User $user" >> /etc/ssh/sshd_config
  echo " MaxSessions $limit" >> /etc/ssh/sshd_config
  systemctl restart ssh > /dev/null 2>&1

  clear
  echo -e "${G}=======================================${NC}"
  echo -e "${G} SSH Account Created Successfully! ${NC}"
  echo -e "${G}=======================================${NC}"
  echo -e " Username : $user"
  echo -e " Password : $pass"
  echo -e " Expired On : $exp"
  echo -e " Limit Login : $limit IP"
  echo -e " Host/IP : ${HOST} / ${SERVER_IP}"
  echo -e " SSH Port : 22"
  echo -e " WS Port : 80, 8080"
  echo -e " WS SSL Port : 443"
  echo -e " Stunnel Port : 7443"
  echo -e " XHTTP Port : 8000"
  echo -e " OVPN Port : 1194 (UDP)"
  echo -e " DNSTT Port : 53 (UDP)"
  echo -e " DNSTT PubKey : ${DNSTT_PUBKEY}"
  echo -e "======================================="
  echo -e " Payload WS : GET / HTTP/1.1[crlf]Host: ${HOST}[crlf]Upgrade: websocket[crlf][crlf]"
  echo -e " Payload XHTTP : GET / HTTP/1.1[crlf]Host: ${HOST}[crlf]X-Online-Host: ${HOST}[crlf]Connection: Keep-Alive[crlf][crlf]"
  echo -e "======================================="
  
  post_creation_menu
}

delete_ssh() {
  clear
  read -p " Username to delete : " user
  if id "$user" &>/dev/null; then
    userdel -r "$user"
    sed -i "/Match User $user/,/MaxSessions/d" /etc/ssh/sshd_config
    systemctl restart ssh > /dev/null 2>&1
    echo -e "${G}User deleted.${NC}"
  else
    echo -e "${R}User not found.${NC}"
  fi
  press_enter
  ssh_menu
}

list_ssh() {
  clear
  echo -e "${C}========================================================================${NC}"
  echo -e "${W} SSH Account List ${NC}"
  echo -e "${C}========================================================================${NC}"
  NOW_S=$(date +%s)
  awk -F: '$3>=1000 && $1!="nobody"' /etc/passwd | while read line; do
    u=$(echo $line | cut -d: -f1)
    e=$(chage -l $u | grep "Account expires" | cut -d: -f2 | xargs)
    if [ "$e" != "never" ] && [ -n "$e" ] && [ "$e" != "password must be changed" ]; then
      EXP_S=$(date -d "$e" +%s 2>/dev/null)
      if [ -n "$EXP_S" ] && [ "$EXP_S" -lt "$NOW_S" ]; then
        printf " %-15s %-12s ${R}[EXPIRED] - Contact vantricks to renew your account${NC}\n" "$u" "$e"
      else
        printf " %-15s %-12s ${G}[ACTIVE]${NC}\n" "$u" "$e"
      fi
    else
      printf " %-15s %-12s ${G}[ACTIVE]${NC}\n" "$u" "$e"
    fi
  done
  echo -e "${C}========================================================================${NC}"
  press_enter
  ssh_menu
}

renew_ssh() {
  clear
  read -p " Username : " user
  if id "$user" &>/dev/null; then
    read -p " Extend (Days) : " days
    exp=$(date -d "+$days days" +"%Y-%m-%d")
    chage -E "$exp" "$user"
    usermod -U "$user" 2>/dev/null # Unlocks the account if it was locked by auto-expire
    echo -e "${G}Account renewed until $exp and unlocked.${NC}"
  else
    echo -e "${R}User not found.${NC}"
  fi
  press_enter
  ssh_menu
}

