# OpenVPN: edit only (no restart). duplicate-cn = many devices per account, each with its own tunnel IP.
# management = private unix socket (no TCP port) so the guard can see / remove single devices.
mux_ovpn_conf() {
  local mode="$1" t f
  for t in udp tcp; do
    if [ "$t" = udp ]; then f="$OVPN_DIR/server.conf"; else f="$OVPN_DIR/server-tcp.conf"; fi
    [ -f "$f" ] || continue
    sed -i '/^# >>> acero-mux/,/^# <<< acero-mux/d' "$f"
    if [ "$mode" = "on" ]; then
      printf '# >>> acero-mux (1 account = many devices, own IP each)\nduplicate-cn\nmanagement /run/openvpn-server/acero-mux-%s.sock unix\n# <<< acero-mux\n' "$t" >> "$f"
    fi
  done
}
mux_ovpn_has() { grep -q '^# >>> acero-mux' "$OVPN_DIR/server.conf" 2>/dev/null; }

mux_ovpn_apply() {
  local mode="$1" i
  [ -f "$OVPN_DIR/server.conf" ] || return 0
  mux_ovpn_conf "$mode"
  [ "${PROTO_OVPN:-ON}" = "OFF" ] && return 0
  systemctl restart openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  [ "$mode" = "on" ] || return 0
  for i in 1 2 3 4 5 6 7 8; do
    if [ -S /run/openvpn-server/acero-mux-udp.sock ] && [ -S /run/openvpn-server/acero-mux-tcp.sock ]; then return 0; fi
    sleep 1
  done
  # could not open the control sockets: undo, so OpenVPN keeps working exactly like before
  mux_ovpn_conf off
  systemctl restart openvpn-server@server openvpn-server@server-tcp > /dev/null 2>&1
  return 1
}

# SSH keep-alive: dead (ghost) sessions are cleared in ~3 min, so a user who switched network is never blocked by his own old session
mux_sshd_apply() {
  local F="$MUX_SSHD_DROPIN"
  if [ "$1" = "on" ]; then
    grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/' /etc/ssh/sshd_config 2>/dev/null || return 0
    mkdir -p /etc/ssh/sshd_config.d
    printf '# ACERO Account Multiplexer\nClientAliveInterval 60\nClientAliveCountMax 3\nTCPKeepAlive yes\n' > "$F"
  else
    rm -f "$F"
  fi
  if ! sshd -t > /dev/null 2>&1; then rm -f "$F"; return 1; fi
  systemctl reload ssh > /dev/null 2>&1 || systemctl reload sshd > /dev/null 2>&1 || true   # reload keeps every live session
  return 0
}

mux_guard_apply() {
  if [ "$1" = "on" ]; then
    mux_write_service
    systemctl enable "$MUX_SVC" > /dev/null 2>&1
    systemctl restart "$MUX_SVC" > /dev/null 2>&1
    sleep 1
    systemctl is-active --quiet "$MUX_SVC"
  else
    systemctl disable --now "$MUX_SVC" > /dev/null 2>&1
    rm -f "/etc/systemd/system/${MUX_SVC}.service" /run/vantricks-mux.state
    systemctl daemon-reload > /dev/null 2>&1
    return 0
  fi
}

# silent self-repair (every start + every update): keeps it ON after an OpenVPN repair / reinstall / reboot
mux_heal() {
  [ "${MUX_AUTO:-OFF}" = "ON" ] || return 0
  [ -x "$MUX_PY" ] || install_mux_python
  [ -f "/etc/systemd/system/${MUX_SVC}.service" ] || mux_write_service
  systemctl is-active --quiet "$MUX_SVC" 2>/dev/null || { systemctl enable "$MUX_SVC" > /dev/null 2>&1; systemctl restart "$MUX_SVC" > /dev/null 2>&1; }
  if [ -f "$OVPN_DIR/server.conf" ] && ! mux_ovpn_has; then mux_ovpn_apply on > /dev/null 2>&1; fi
  [ -f "$MUX_SSHD_DROPIN" ] || mux_sshd_apply on > /dev/null 2>&1
  return 0
}

