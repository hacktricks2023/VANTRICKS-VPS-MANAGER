ssh_menu() {
  clear
  echo -e "${C}╔══════════════════════════════════════════════╗${N}"
  echo -e "${C}║${N}       ${W}SSH Management${N}                        ${C}║${N}"
  echo -e "${C}╠══════════════════════════════════════════════╣${N}"
  echo -e "${C}║${N}  ${W}[1]${N} Create Account                         ${C}║${N}"
  echo -e "${C}║${N}  ${W}[2]${N} Delete Account                         ${C}║${N}"
  echo -e "${C}║${N}  ${W}[3]${N} List Accounts                          ${C}║${N}"
  echo -e "${C}║${N}  ${W}[4]${N} Renew Account                          ${C}║${N}"
  echo -e "${C}║${N}  ${W}[5]${N} Change Banner                          ${C}║${N}"
  echo -e "${C}║${N}  ${W}[0]${N} Back to Main Menu                      ${C}║${N}"
  echo -e "${C}╚══════════════════════════════════════════════╝${N}"
  read -p " Choose : " ch
  case $ch in
    1) create_ssh ;;
    2) delete_ssh ;;
    3) list_ssh ;;
    4) renew_ssh ;;
    5)
       read -p " Type new banner text: " txt
       echo "$txt" > /etc/ssh/banner.txt
       systemctl restart ssh > /dev/null 2>&1
       echo -e " ${G}[✓] Banner updated!${N}"
       press_enter
       ssh_menu
       ;;
    0) main_menu ;;
    *) ssh_menu ;;
  esac
