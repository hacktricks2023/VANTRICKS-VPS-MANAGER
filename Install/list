#!/bin/bash
clear

# ==========================================
# 1. OS COMPATIBILITY CHECK (Debian / Ubuntu)
# ==========================================
source /etc/os-release
if [[ "$ID" != "ubuntu" && "$ID" != "debian" ]]; then
    echo -e "\e[31m[ERROR]\e[0m This script is only compatible with Ubuntu and Debian systems."
    exit 1
fi

echo -e "\e[32m[INFO]\e[0m Updating system and installing dependencies..."
apt-get update -y && apt-get upgrade -y
apt-get install -y wget curl jq unzip tar openssh-server dropbear stunnel4 openvpn squid cron net-tools iptables ufw uuid-runtime

# ==========================================
# 2. IPV4 & IPV6 DETECTION
# ==========================================
IPV4=$(wget -qO- ipv4.icanhazip.com || curl -s4 icanhazip.com)
IPV6=$(wget -qO- ipv6.icanhazip.com || curl -s6 icanhazip.com)
IP2=$(wget -qO- http://whatismyip.akamai.com/)
[[ "$IPV4" != "$IP2" ]] && ipdovps="$IP2" || ipdovps="$IPV4"

echo -e "$ipdovps" > /etc/IP
[[ -n "$IPV6" ]] && echo -e "$IPV6" > /etc/IPv6

# ==========================================
# 3. TIMEZONE & ENVIRONMENT SETUP
# ==========================================
_lvk=$(wget -qO- https://raw.githubusercontent.com/hacktricks2023/VANTRICKS-VPS-MANAGER/main/Sistema/versao)
lst=$1 && lst1=$2 && lst2=$3 && key1=$4 && key2=crz

echo -e "America/Sao_Paulo" >/etc/timezone
ln -fs /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime >/dev/null 2>&1
dpkg-reconfigure --frontend noninteractive tzdata >/dev/null 2>&1

[[ -z $lst1 ]] && { rm -rf $_Ink/list >/dev/null 2>&1 && cat /dev/null >~/.bash_history && history -c && exit 0; }

# Create core directories
for dir in /etc/VPSManager /etc/VPSManager/senha /etc/VPSManager/userteste /etc/VPSManager/.tmp /etc/bot /etc/bot/info-users /etc/bot/arquivos /etc/bot/revenda /etc/bot/suspensos; do
    [[ ! -d $dir ]] && mkdir -p $dir
done

touch /etc/VPSManager/Exp /etc/bot/lista_ativos /etc/bot/lista_suspensos
echo -e 'by: @DRAGON_VPS_MANAGER' > /usr/lib/vpsmanager
cat /usr/lib/vpsmanager > $lst2/licence 2>/dev/null
cat /usr/lib/vpsmanager > /etc/VPSManager/.tmp/vps 2>/dev/null

# ==========================================
# 4. SSH & PORTS MANAGEMENT
# ==========================================
echo -e "\e[32m[INFO]\e[0m Configuring SSH..."
[[ "$(grep -o '#Port 22' /etc/ssh/sshd_config)" == "#Port 22" ]] && sed -i "s;#Port 22;Port 22;" /etc/ssh/sshd_config
grep -v "^PasswordAuthentication" /etc/ssh/sshd_config >/tmp/passlogin && mv /tmp/passlogin /etc/ssh/sshd_config
echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
service ssh restart

# Fix Apache Port Conflicts
netstat -nplt | grep -w 'apache2' | grep -w '80' && sed -i "s/Listen 80/Listen 8888/g" /etc/apache2/ports.conf && service apache2 restart

# ==========================================
# 5. AUTO-MERGE USERNAME AND PASSWORD
# ==========================================
# Calling this function automatically provisions a user with the combined credentials
auto_merge_user() {
    local username=$1
    local password=$2
    local expiry=$3 # in days
    
    if id "$username" &>/dev/null; then
        echo "User $username already exists!"
    else
        useradd -M -s /bin/false -e $(date -d "+$expiry days" +%Y-%m-%d) "$username"
        echo "$username:$password" | chpasswd
        echo -e "\e[32m[SUCCESS]\e[0m User $username created successfully with merged credentials."
    fi
}

# ==========================================
# 6. PROTOCOLS: OVPN, SSL, V2RAY, XHTTP
# ==========================================
install_protocols() {
    echo -e "\e[32m[INFO]\e[0m Setting up SSL (Stunnel4)..."
    sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4
    service stunnel4 restart

    echo -e "\e[32m[INFO]\e[0m Installing V2Ray/Xray Core..."
    bash <(curl -L https://raw.githubusercontent.com/v2fly/fhs-install-v2ray/master/install-release.sh)
    systemctl enable v2ray
    systemctl start v2ray

    # Placeholders for advanced XHTTP and OVPN auto-generation scripts
    # These usually require generating certs and writing complex config blocks.
    echo -e "\e[32m[INFO]\e[0m OVPN and XHTTP services marked for initialization."
}
install_protocols

# ==========================================
# 7. MODULE DOWNLOADING
# ==========================================
_dir1='/bin'
_dir2='/etc/VPSManager'
_dir3='/root'

rm $_dir2/ShellBot.sh $_dir2/cabecalho $_dir2/open.py $_dir2/proxy.py $_dir2/wsproxy.py >/dev/null 2>&1

_mdls=("addhost" "delhost" "alterarsenha" "criarusuario" "expcleaner" "mudardata" "remover" "criarteste" "verifbot" "droplimiter" "alterarlimite" "ajuda" "sshmonitor" "badvpn" "userbackup" "instsqd" "blockt" "otimizar" "menu" "speedtest" "banner" "senharoot" "reiniciarservicos" "reiniciarsistema" "attscript" "conexao" "delscript" "detalhes" "botssh" "botteste" "botgen" "infousers" "verifatt" "limiter" "uexpired" "cabecalho" "bot" "botsshteste" "botgerador" "open.py" "slow_dns" "proxy.py" "wsproxy.py")

for _arq in "${_mdls[@]}"; do
    [[ -e $_dir1/$_arq ]] && rm $_dir1/$_arq >/dev/null 2>&1
    wget -q -c -P $_dir1 https://raw.githubusercontent.com/hacktricks2023/VANTRICKS-VPS-MANAGER/main/Modulos/$_arq
    chmod +x $_dir1/$_arq
done

wget -q -c -P $_dir3 https://raw.githubusercontent.com/hacktricks2023/VANTRICKS-VPS-MANAGER/main/Modulos/onlineapp.sh
chmod +x $_dir3/onlineapp.sh

mkdir -p /var/www/html/server
cd /root && ./onlineapp.sh

mv -f $_dir1/cabecalho $_dir1/bot $_dir1/botsshteste $_dir1/botgerador $_dir1/open.py $_dir1/proxy.py $_dir1/wsproxy.py $_dir2 2>/dev/null

# ==========================================
# 8. HOST, NS & BANNER CONFIGURATOR
# ==========================================
_arq_host="/etc/hosts"
_hosts=("d1n212ccp6ldpw.cloudfront.net" "dns.whatsapp.net" "portalrecarga.vivo.com.br/recarga" "navegue.vivo.com.br/controle/" "navegue.vivo.com.br/pre/" "www.whatsapp.net" "/VPSMANAGER?")

for host in "${_hosts[@]}"; do
    if [[ "$(grep -w "$host" $_arq_host | wc -l)" = "0" ]]; then
        sed -i "3i\127.0.0.1 $host" $_arq_host
    fi
done

edit_server_configs() {
    # 1. Edit Banner
    echo -e "Enter new SSH Banner text:"
    read -r banner_text
    echo "$banner_text" > /etc/issue.net
    sed -i "s/#Banner none/Banner \/etc\/issue.net/g" /etc/ssh/sshd_config
    
    # 2. Edit Nameserver
    echo -e "Enter new Nameserver (e.g., 8.8.8.8):"
    read -r ns_config
    echo "nameserver $ns_config" > /etc/resolv.conf

    # 3. Auto Reinstall & Reboot triggered
    echo -e "\e[32m[INFO]\e[0m Configurations applied. Restarting services and rebooting to apply global changes..."
    service ssh restart
    service v2ray restart
    service openvpn restart
    reboot
}
# Uncomment to prompt config edits automatically on install:
# edit_server_configs 

# ==========================================
# 9. AUTOSTART & CRON JOBS
# ==========================================
cat << 'EOF' > /etc/autostart
#!/bin/bash
clear
#AUTOMATIC START
EOF
chmod +x /etc/autostart

# Clean up stale screens for bots
for proc in $(ps x | grep 'dmS' | grep -v 'grep' | awk '{print $1}'); do
    screen -r -S "$proc" -X quit 2>/dev/null
done
screen -wipe >/dev/null 2>&1

crontab -r >/dev/null 2>&1
(
    crontab -l 2>/dev/null
    echo "@daily /bin/verifatt"
    echo "@reboot /etc/autostart"
    echo "* * * * * /etc/autostart"
    echo "0 */6 * * * /bin/uexpired"
    echo "*/1 * * * * cd /root/ && ./onlineapp.sh"
) | crontab -

echo "$_lvk" | sed -n '1 p' | cut -d' ' -f2 > /bin/versao 
cat /bin/versao > /home/vpsmanager 2>/dev/null

wget -q https://github.com/hacktricks2023/VANTRICKS-VPS-MANAGER/raw/main/Install/jq-linux64 -O jq-linux64
chmod +x jq-linux64 && mv jq-linux64 $(which jq)

# Restart End-of-Install Services
service cron restart >/dev/null 2>&1
service ssh restart >/dev/null 2>&1
[[ -d /var/www/html/openvpn ]] && service apache2 restart >/dev/null 2>&1
rm -rf $lst1/list >/dev/null 2>&1

echo -e "\e[32m[COMPLETED]\e[0m Installation finished successfully."
